#!/usr/bin/env bash
# The hard block on sensitive paths. Registered on PreToolUse, matcher Bash. Plan task 4.3,
# decision 3.
#
# Decision 3 asks for one gate that a sentence in chat cannot move: a commit touching auth, money
# movement or personal data should need a human, not a promise. Every other keel gate is enforced
# with an escape hatch the model can take by saying so. This one is not.
#
# WHY `ask` AND NOT `deny`. `security-audit` is a skill, executed by the model, not a command a hook
# can run. So nothing here can verify that an audit "ran clean", and any receipt the model could
# write is a receipt a sentence in chat could obtain. `ask` is the only decision in the protocol the
# model cannot satisfy for itself: the harness puts it to the human. It also survives
# bypassPermissions, which `lib/harness/claude.sh#Verified against a live session rather than taken from the documentation` records as verified against a live session, and which is
# what makes it worth anything at all.
#
# SILENT UNLESS THE REPOSITORY ASKS FOR IT. A command that is not a commit costs builtin matches,
# and a commit where neither profile at HEAD nor in the tree declares a path produces no output.
#
# IT ASKS WHENEVER IT CANNOT ANSWER. An unreadable profile, an unparseable one, an absent python3, a
# git that will not run: each of those used to exit 0 in silence, which is the one outcome a gate
# must never have, because the repository declared sensitive paths and would believe it had cover.
# The cheap filters run first, in bash, so this never becomes a prompt on every Read.
#
# It guards the commit rather than the edit. Blocking every edit to auth code would make this the
# gate people delete, and the commit is where the change stops being private to the session. It
# reads the staged set, plus tracked modifications when the command carries -a, --all or a pathspec,
# because all three commit working tree content that `--cached` does not show.
#
# ITS LIMIT, STATED RATHER THAN DISCOVERED. It reads a command string, so `sh -c`, an alias or a
# here-doc reaches a commit without passing through here, exactly as the
# permission deny rules in `lib/harness/claude.sh#harness_permission_rules() {` already warn. This raises the cost of a careless commit; it
# is not a boundary against a determined one. The boundary is review. And it judges the repository
# the session is in, by its profile and its staged set, not the one that `-C`, `--git-dir` or
# `--work-tree` names, so a commit in another repository (`git -C ../other commit`, or
# `cd ../other && git commit`) passes in silence, unless this repository's own staged set asks.

set -uo pipefail

ask() {
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"keel: %s"}}' "$1"
    exit 0
}

# A crash is not an answer. Claude Code lets the tool call proceed on any exit but 0 and 2, so a
# `set -u` slip or a Python exception below would wave the commit through. 2 is the deliberate block
# further down; any other unexpected exit asks.
trap 'case $? in 0|2) ;; *) ask "the guard failed unexpectedly, so it cannot tell whether this commit touches a sensitive path. Approving is a human decision." ;; esac' EXIT

event="$(</dev/stdin)"

# This filter runs before anything can fail closed, and before any external command. Without it, a
# machine with no python3 would get a permission prompt on every Bash command, which is how a gate
# gets deleted. There is no tool_name check here: the "Bash" matcher on this hook in hooks.json
# already guarantees that. It matches the event's "command" value: `git`, then `commit`, either next
# or after a global option and whatever follows it, because `git -c core.hooksPath=/dev/null commit`
# and `git -C . commit` are commits too and a value can hold anything, quotes included. Matched
# against the whole event, a global option in the command and the word commit in its description
# read as a commit. The value is read only when it holds no escape and the key appears once; any
# other event, a malformed one included, is matched whole, so it fails toward the walk below.
# Whitespace includes a tab or a newline, which the whole event carries escaped as \t or \n. The
# key is matched with its quotes and colon, as the cwd is below, so a description naming it does not
# match. What the pattern still lets past is a command with a git global option and, later in the
# same command text, the word `commit`, such as `git -c x=y log --grep commit`. The token walk below
# reads that as no commit, but the staged-profile ask, the unreadable-profile ask and the Codex
# refusal do not wait for the walk, so they fire on it.
cmd_re='"command"[[:space:]]*:[[:space:]]*"([^"\]*)"'
twice_re='"command"[[:space:]]*:.*"command"[[:space:]]*:'
text="$event"
if ! [[ $event =~ $twice_re ]] && [[ $event =~ $cmd_re ]]; then text="${BASH_REMATCH[1]}"; fi
commit_re='git([[:space:]]|\\[nt])+(-.*([[:space:]]|\\[nt])+)?commit([^[:alnum:]_.-]|$)'
[[ $text =~ $commit_re ]] || exit 0

# Walk up for the profile, the way git looks for .git. A session started in a subdirectory is
# ordinary, and looking only in the current directory meant the guard silently did not exist there.
# The walk starts from the session's directory, the first of these that names a directory that
# exists: the event's cwd, then CLAUDE_PROJECT_DIR, then $PWD. The hook process's own directory is
# not promised to be the one the command runs in, and judged from outside the repository the guard
# found no profile and no staged set. The cwd is read here and not in Python because the walk and
# the cheap gate run before the python3 check. The key is matched with its quotes and colon, so a
# command naming it, which arrives escaped as \"cwd\", does not match; a cwd holding a quote or a
# backslash arrives escaped too, matches nothing, and the next in the order is used.
dir="$PWD"
cwd_re='"cwd"[[:space:]]*:[[:space:]]*"([^"\]*)"'
if [[ $event =~ $cwd_re ]] && [ -d "${BASH_REMATCH[1]}" ]; then dir="${BASH_REMATCH[1]}"
elif [ -d "${CLAUDE_PROJECT_DIR:-}" ]; then dir="$CLAUDE_PROJECT_DIR"
fi

# It steps up by parameter expansion, not `dirname`: a PATH without dirname emptied the directory at
# the first step up, so the walk found no profile and the commit went through in silence.
PROFILE=""
d="$dir"
while :; do
    if [ -f "$d/.keel/profile.json" ]; then PROFILE="$d/.keel/profile.json"; break; fi
    [ "$d" = / ] && break
    p="${d%/*}"; [ "$p" = "$d" ] && break     # a relative path has no parent left to try
    d="${p:-/}"
done

# The committed profile judges the commit beside the working-tree one. Judged by the working tree
# alone, a commit that emptied or removed the list was judged by the list it removed, so it went
# through in silence and the next commit to a sensitive path was unguarded. That holds with no
# working-tree profile at all: a deleted one, staged or not, is still judged by the list at HEAD.
# `HEAD:path` is root-relative from any subdirectory, so no root lookup is needed. A first commit
# has no HEAD, and a failed `git show` reads the same way: nothing committed to add. It runs in the
# walk's directory, as `git diff` below does, or the profile and the staged set could come from
# different repositories.
#
# A working-tree profile that exists and cannot be read is not an absent one: it may declare paths.
# Read as empty, with no profile at HEAD to stand in for it, it let the commit through in silence.
profile_text=""
unreadable=""
if [ -n "$PROFILE" ] && ! { profile_text="$(<"$PROFILE")"; } 2>/dev/null; then unreadable=1; fi
head_text="$(git -C "$dir" show HEAD:.keel/profile.json 2>/dev/null)"

# The cheap gate, a builtin match. `grep ... || exit 0` cannot tell "no match" from "grep is not on
# PATH", so it fails open in exactly the situation where a guard must not. Builtins cannot go
# missing. A profile that could not be read cannot be matched, so it passes the gate.
case "$profile_text$head_text" in
    *'"hard_block_paths"'*) ;;
    *) [ -n "$unreadable" ] || exit 0 ;;
esac

# CODEX DISCARDS `ask`, AND THIS GATE IS `ask` OR IT IS NOTHING. Codex still runs this hook: it
# reads hooks/hooks.json, the file Claude Code reads, as the probe recorded at
# `docs/architecture/claude-code-only.md#Codex loads keel's hooks without .codex-plugin: yes`.
# Exiting 0 there would leave a repository that declared sensitive paths believing it had a gate, so
# the hook refuses the commit and names the last keel release that supports Codex.
#
# PLACEMENT. It sits after the commit filter and the cheap gate, and refuses only when the top-level
# hard_block_paths of the committed or the working-tree profile is anything but absent, null or an
# empty list, either will not parse, the working-tree one cannot be read, or python3 is absent to
# parse them, so a repository declaring nothing is never blocked on a machine with python3. Any
# earlier and it would block Bash calls in repositories that asked for nothing, which breaks the
# header's rule: silent unless the repository asks for it. The judgement is a parse and not a regex
# over the text, because a regex matched an empty list nested under `_notes` and read it as the
# repository declaring nothing (audit M-01). It reads the list as the Python below does, so a list
# that Python would ask about is refused here rather than given an ask. The detection sits before
# the python3 check, because the parse needs python3 and without it the check below must refuse on
# Codex rather than give the ask Codex discards.
#
# WHY EXIT 2 AND NOT 1. On Codex a PreToolUse hook that exits with any non-zero code other than 2
# has its stderr DISCARDED: codex-rs/hooks/src/events/pre_tool_use.rs replaces it with the string
# "hook exited with code N" and the tool call proceeds. Exit 2 takes a different arm entirely, which
# sets should_block and surfaces stderr as the block reason. So exit 1 here would be quieter than
# doing nothing, and exit 2 both stops the command and says why.
#
# EITHER SIGNAL MEANS CODEX, AND ONLY OUTSIDE CLAUDE CODE. Codex's PreToolUse input requires a
# `turn_id` key (codex-rs/hooks/src/schema.rs:275-295) and its SessionStart input has none, and
# Codex sets CODEX_VERSION for the commands its shell tool runs, though its SessionStart hook ran
# without it: `docs/architecture/claude-code-only.md#Codex hook environment has CODEX_VERSION: no`.
# Claude Code 2.1.314's PreToolUse input had no turn_id, but its MessageDisplay input does, so a
# later release could add it to PreToolUse. Claude Code exports CLAUDE_PROJECT_DIR to hook processes
# and Codex has no such variable, so with it set neither signal can turn the ask into a block. That
# is the one way the refusal is switched off: a Codex process that inherited CLAUDE_PROJECT_DIR, as
# one started from inside a Claude Code session does, gets the ask, which Codex discards, so its
# commit goes through. The key is matched with its quotes and colon: a commit message naming turn_id
# arrives JSON-escaped, as \"turn_id\", and a field whose value is turn_id reads "turn_id" with no
# colon after it, so neither matches.
codex=""
if [ -z "${CLAUDE_PROJECT_DIR:-}" ]; then
    [ -n "${CODEX_VERSION:-}" ] && codex=1
    case "$event" in
        *'"turn_id":'*) codex=1 ;;
    esac
fi
refuse() {
    printf 'keel sensitive-guard: Codex discards the ask decision this gate depends on, so it cannot put this commit to a human. keel v0.26.0 is the last keel release that supports Codex; install it with: codex plugin marketplace add gbi-solutions-ltd/keel --ref v0.26.0 && codex plugin add keel@gbi. Blocking rather than pretending.\n' >&2
    exit 2
}

# Without python3 the list cannot be parsed, and an unparsed declaration counts as declared. On
# Codex that means refusing, because the ask below is one Codex discards. This fails closed even for
# a repository whose only declaration is an empty list, on a machine without python3. Claude Code
# gets the ask.
if ! command -v python3 >/dev/null 2>&1; then
    [ -n "$codex" ] && refuse
    ask "this repository declares hard_block_paths and python3 is absent, so the guard cannot tell whether this commit touches one. Approving is a human decision."
fi

[ -n "$codex" ] && [ -n "$unreadable" ] && refuse
if [ -n "$codex" ] && ! KEEL_PROFILE_TEXT="$profile_text" KEEL_HEAD_PROFILE_TEXT="$head_text" python3 -c '
import json, os, sys
def declares_nothing(text):
    data = json.loads(text)
    return isinstance(data, dict) and data.get("hard_block_paths") in (None, [])
texts = [os.environ[k] for k in ("KEEL_PROFILE_TEXT", "KEEL_HEAD_PROFILE_TEXT") if os.environ[k]]
sys.exit(0 if all(declares_nothing(t) for t in texts) else 1)' 2>/dev/null; then
    refuse
fi

KEEL_EVENT="$event" KEEL_PROFILE_TEXT="$profile_text" KEEL_HEAD_PROFILE_TEXT="$head_text" \
KEEL_PROFILE_UNREADABLE="$unreadable" KEEL_DIR="$dir" python3 - <<'PY'
import json, os, shlex, subprocess, sys
from fnmatch import fnmatch

def emit(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "ask",
        "permissionDecisionReason": "keel: " + reason,
    }}))
    sys.exit(0)

# The list is the union of the working-tree and the committed profile, which bash already read for
# the cheap gate and passes in so neither is read twice. A profile said hard_block_paths, so one
# that will not parse is a declared gate with no enforcement behind it, which is the case this hook
# exists to prevent: it asks, below, once a staged profile has had the chance to be named. So does
# a working-tree profile bash could not read, a profile that is not a JSON object, and a
# hard_block_paths that is present and not a list of strings: a string was iterated character by
# character, so "src/auth" declared s, r, c and so on, and guarded nothing. `unreadable` holds the
# reason the ask gives. An empty union is a repository declaring nothing anywhere, never asked.
#
# A null hard_block_paths reads as no list, as an absent key does, because null is how JSON says a
# value is unset; asking on every commit of a repository that wrote it would be the prompt that gets
# a gate deleted. `keel plan risk` is stricter there: it reads null as a list that cannot be read
# and exits 3 (`bin/keel#Only a missing key or [] is no list`).
patterns = []
unreadable = ("this repository's profile could not be read"
              if os.environ.get("KEEL_PROFILE_UNREADABLE") else "")
for text in (os.environ.get("KEEL_PROFILE_TEXT"), os.environ.get("KEEL_HEAD_PROFILE_TEXT")):
    if not text:
        continue
    try:
        data = json.loads(text)
    except ValueError:
        unreadable = "this repository declares hard_block_paths but its profile could not be read"
        continue
    if not isinstance(data, dict):
        unreadable = "this repository's profile is not a JSON object"
        continue
    listed = data.get("hard_block_paths")
    if listed is not None and not (isinstance(listed, list)
                                   and all(isinstance(p, str) for p in listed)):
        unreadable = "this repository's hard_block_paths is not a list of strings"
        continue
    patterns += data.get("hard_block_paths") or []
if not patterns and not unreadable:
    sys.exit(0)

# An event that is not JSON leaves no command to read flags from, but the bash filter said it looks
# like a commit, so the profile check below still runs.
try:
    ev = json.loads(os.environ.get("KEEL_EVENT") or "{}")
except ValueError:
    ev = {}
cmd = ((ev.get("tool_input") or {}).get("command") or "")

# shlex, not a regex, so a message cannot look like a flag. `git commit -m "fix the -a flag"` must
# not widen the check, and `git commit -am"msg"` must.
try:
    tokens = shlex.split(cmd)
except ValueError:
    tokens = cmd.split()

# Global options can sit between `git` and `commit`. These take the next token as their value, which
# is skipped with them, so `git -C . commit` is read as a commit and not stopped at the `.`. The
# `--opt=value` forms are one token starting with `-`, and are skipped as any other flag is.
GLOBAL_VALUE_OPTS = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env"}

start = None
for i, t in enumerate(tokens):
    if t != "git":
        continue
    j = i + 1
    while j < len(tokens):
        if tokens[j] == "commit":
            start = j + 1
            break
        if not tokens[j].startswith("-"):
            break
        j += 2 if tokens[j] in GLOBAL_VALUE_OPTS else 1
    if start is not None:
        break

# Options that swallow the next token, so their value is never mistaken for a pathspec.
VALUE_OPTS = {"-m", "--message", "-F", "--file", "-C", "--reuse-message", "-c", "--reedit-message",
              "--author", "--date", "-S", "--gpg-sign", "--cleanup", "-t", "--template",
              "--fixup", "--squash", "--trailer"}

# No `git commit` among the tokens leaves no flags and no pathspec, and no path check below.
rest, pathspecs, widen, i = (tokens[start:] if start is not None else []), [], False, 0
while i < len(rest):
    t = rest[i]
    if t == "--":
        pathspecs += rest[i + 1:]
        break
    if t in VALUE_OPTS:
        i += 2
        continue
    if t.startswith("--"):
        widen = widen or t == "--all"
        i += 1
        continue
    if t.startswith("-"):
        widen = widen or "a" in t[1:]
        i += 1
        continue
    pathspecs.append(t)
    i += 1

def files(*args):
    # -z, because splitting git's output on whitespace tears `src/auth/two words/k.go` into two
    # paths, and it stops git quoting anything unusual. A non-zero exit is not "nothing changed":
    # git missing, a locked index or a timeout would otherwise read as a clean commit.
    try:
        r = subprocess.run(["git", "diff", "--name-only", "-z"] + list(args),
                           cwd=os.environ["KEEL_DIR"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        emit("this repository declares hard_block_paths and git could not be run, so the guard "
             "cannot tell whether this commit touches a sensitive path. Approving is a human "
             "decision.")
    if r.returncode != 0:
        emit("this repository declares hard_block_paths and `git diff` failed, so the guard cannot "
             "tell whether this commit touches a sensitive path. Approving is a human decision.")
    return [f for f in r.stdout.split("\0") if f]

changed = set(files("--cached"))
# -a, --all and a pathspec all commit working tree content that --cached does not show.
if widen or pathspecs:
    changed |= set(files("HEAD"))

def matches(f, p):
    # A bare directory has to match what is under it. Decision 3 proposes patterns like "anything
    # under a path matching auth", and `fnmatch("src/auth/token.go", "src/auth")` is false, so a
    # repository writing the obvious thing would declare a gate that never fired.
    p = p.rstrip("/")
    return fnmatch(f, p) or fnmatch(f, p + "/*")

hit = sorted({f for f in changed for p in patterns if matches(f, p)}) if start is not None else []
if hit:
    shown = ", ".join(hit[:5]) + (" and %d more" % (len(hit) - 5) if len(hit) > 5 else "")
    emit("this commit includes %d file(s) under hard_block_paths: %s. Decision 3 makes this the one "
         "gate the model cannot clear by saying so, because it covers auth, money movement and "
         "personal data. Run security-audit --diff and read its findings before approving."
         % (len(hit), shown))

# The profile holds the list that judges this commit, so a commit changing it could change what
# the gate covers without touching a declared path. Root-relative, as the patterns are. It runs
# before the unreadable ask, so a staged profile that will not parse is named as the profile.
if ".keel/profile.json" in changed:
    emit("this commit changes .keel/profile.json, which holds the hard_block_paths list this gate "
         "judges commits by. Approving is a human decision.")
if unreadable:
    emit(unreadable + ". The guard cannot tell whether this commit touches a sensitive path. "
         "Approving is a human decision.")
PY
