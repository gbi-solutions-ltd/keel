#!/usr/bin/env bash
# The done guard. Registered on Stop and SubagentStop. Idea record
# docs/ideas/verification-backed-done.md, stage 2.
#
# WHAT IT CHECKS, AND WHAT IT DELIBERATELY DOES NOT. It fires on a structural condition: this turn
# edited code and never ran the project's test command. It does not read the assistant's final
# message for the word "done". That was the first design and it is a string matcher over English:
# it misses "that's the retry path covered" and fires on "done reading the config". A guard that
# cries wolf gets switched off, and this one shares hooks.json with sensitive-guard, which must
# never be switched off.
#
# IT FAILS OPEN. This is the opposite of sensitive-guard and the difference is not an oversight.
# That hook asks a human whenever it cannot answer, because `ask` is the one decision the model
# cannot grant itself. A Stop hook has no equivalent: denying a stop it cannot justify produces a
# turn that will not end, with no human in the loop to clear it. So an unparseable profile, an
# absent python3 or a malformed event emits systemMessage and allows the stop.
#
# A profile that cannot be READ is the one case that passes in silence rather than warning, and the
# distinction is deliberate. It is caught by the `-r` test below, before anything has established
# that this repository asked for the gate at all, and warning about a file we cannot open would put
# a message on the end of every turn in every repository that happens to have an unreadable one.
# Unparseable is different: the text was read, it contains done_verified, so the repository did ask
# and is owed the warning.
#
# SILENT UNLESS THE REPOSITORY ASKS FOR IT, matching hard_block_paths. No gates.done_verified means
# one builtin string match and no output.
#
# DOCUMENTATION TURNS PASS. A turn whose only edits are .md files or files under docs_root does not
# need the test suite, and firing on every documentation commit is how this becomes the hook people
# delete.
#
# ITS LIMIT, STATED RATHER THAN DISCOVERED. It matches the profile's test command as a substring of
# a Bash command, so a wrapper script, a changed directory or an alias runs the suite without being
# seen, and a command that merely mentions the string counts as having run it. This raises the cost
# of claiming done without checking; it is not a proof that the suite passed. It cannot see the
# exit code, and does not pretend to: `ship` is the gate that reads results.

set -uo pipefail

warn_and_exit() {
    printf '{"systemMessage":"keel done-guard: %s"}' "$1"
    exit 0
}

# Walk up for the profile, the way git looks for .git. A session started in a subdirectory is
# ordinary, and looking only in the current directory means the guard silently does not exist there.
PROFILE=""
d="$PWD"
while [ -n "$d" ]; do
    if [ -f "$d/.keel/profile.json" ]; then PROFILE="$d/.keel/profile.json"; break; fi
    [ "$d" = "/" ] && break
    d="$(dirname "$d")"
done
# `-r` as well as `-f`. Without it an unreadable profile let bash print "Permission denied" to
# stderr on the end of every single turn, which a Stop hook surfaces as an error notice in the
# transcript. Exiting here keeps the failure silent, per the header.
[ -n "$PROFILE" ] && [ -r "$PROFILE" ] || exit 0

# The cheap gate, deliberately with no external command. `grep ... || exit 0` cannot tell "no match"
# from "grep is not on PATH", so it fails open in exactly the situation where a guard must not.
# Builtins cannot go missing.
profile_text="$(<"$PROFILE")"
case "$profile_text" in
    *'"done_verified"'*) ;;
    *) exit 0 ;;
esac

# Read the event before anything can fail, so the harness never sees a hook that ignored its stdin.
event="$(</dev/stdin)"

if ! command -v python3 >/dev/null 2>&1; then
    warn_and_exit "this repository declares gates.done_verified and python3 is absent, so this turn was not checked."
fi

KEEL_EVENT="$event" KEEL_PROFILE_TEXT="$profile_text" python3 - <<'PY'
import json, os, sys

def emit(obj):
    print(json.dumps(obj))
    sys.exit(0)

def warn(reason):
    emit({"systemMessage": "keel done-guard: " + reason})

def block(reason):
    # "block" is the only value that stops the turn. Claude Code's Stop protocol defines exactly one
    # blocking value and says of everything else "Omit to allow Claude to stop", so the "deny" this
    # emitted until 2026-09-05 was read as an omission and the gate never once held a turn open.
    # It shipped that way from the day it was written. Nothing caught it because every test grepped
    # this function's own output for the word it wrote, which is a test of keel agreeing with itself.
    # Verified against code.claude.com/docs/en/hooks, Stop decision control, on 2026-09-05.
    #
    # `reason` is required by the protocol whenever decision is "block", so it is not optional here.
    emit({"decision": "block", "reason": "keel: " + reason})

try:
    ev = json.loads(os.environ.get("KEEL_EVENT") or "{}")
except ValueError:
    warn("the stop event could not be parsed, so this turn was not checked.")

# Already looping. Never deny twice: the second denial has no more information than the first and
# nothing outside this hook can break the cycle.
if ev.get("stop_hook_active"):
    sys.exit(0)

try:
    # The text was already read once in bash to run the cheap gate above; KEEL_PROFILE_TEXT carries
    # it here so this does not open the file a second time for the same read.
    prof = json.loads(os.environ.get("KEEL_PROFILE_TEXT") or "")
except ValueError:
    warn("this repository declares gates.done_verified but its profile could not be read, so this "
         "turn was not checked.")

mode = (prof.get("gates") or {}).get("done_verified") or "off"
if mode == "off":
    sys.exit(0)

test_cmd = (prof.get("verify") or {}).get("test")
if not test_cmd:
    sys.exit(0)          # nothing to check against, and inventing a command would be worse

docs_root = (prof.get("docs_root") or "docs").rstrip("/")

def is_code(p):
    return not (p.endswith(".md") or p == docs_root or p.startswith(docs_root + "/"))

# WHERE THE TURN'S TOOL CALLS COME FROM, AND WHY NOT FROM THE EVENT.
#
# This read `ev["tool_calls"]` until 2026-09-05. Stop does not carry that field. It receives
# stop_hook_active, last_assistant_message, background_tasks and session_crons plus the common
# fields; tool_calls exists on PostToolBatch alone. So `edited` was always empty, this hook returned
# before reaching any decision, and the gate never fired once from the day it was written.
# docs/ideas/verification-backed-done.md:66 had already recorded the assumption as "Documented, not
# run". It was run on 2026-09-05, against a live turn, and it was false.
#
# The transcript is the only place a Stop hook can see what the turn did. Verified against a real
# Claude Code transcript: assistant rows carry message.content[] blocks of type "tool_use" with
# `name` and `input`.
#
# IT LAGS, AND THAT IS WHY THIS GATE FAILS OPEN. The vendor documents the transcript as "written
# asynchronously and may lag the in-memory conversation". A missing final row means an edit this
# hook does not see, so it stays quiet when it should have spoken. That direction is the safe one: a
# missed block costs a reminder, a false block costs a turn nobody can end.
def turn_tool_calls(path, own_transcript):
    """The tool_use blocks since the last real user turn, or None if the transcript is unreadable.

    `own_transcript` is true when the path is the agent's own file rather than the main session's.
    Every row in a subagent transcript carries isSidechain, so skipping those rows there discards
    the whole file: measured at 13,708 of 13,708 assistant rows across 253 real subagent
    transcripts. Skipping is only correct on the main transcript, where a sidechain row is some
    other agent's work rather than this turn's.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            rows = []
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except ValueError:
                    continue          # a partially written final row is expected, not an error
                if isinstance(row, dict):
                    rows.append(row)
                # A valid-JSON row that is not an object would make every .get() below raise, and an
                # uncaught traceback from a Stop hook surfaces as an error notice on the end of
                # every turn. The header records that exact scar for a different cause.
    except (OSError, TypeError):
        return None

    def is_real_user(r):
        # A user row carrying tool_result is the harness returning output, not a person speaking.
        # Nor is a row the harness injected on the model's behalf: a Skill invocation, a slash
        # command's caveat and stdout, an interruption notice and a cross-session message all arrive
        # as user rows with list-of-text content and no tool_result, and each one would reset the
        # turn boundary mid-turn. Measured: 5 of 69 real transcripts land the boundary on one of
        # these, the worst seeing 32 of the turn's 63 tool calls. That direction fails CLOSED, since
        # a test run before the injected row becomes invisible and the turn is blocked for not
        # running it.
        #
        # MEASURED AFTER THE FIX, over all 69 real transcripts on hand: 4 boundaries still land on a
        # harness-written row, and none of them is a defect. Three are `/clear`, which is a person's
        # action and genuinely does start a new turn, so the boundary belongs there. The fourth is
        # `[Request interrupted by user for tool use]`, which carries no structural marker and is
        # indistinguishable from a person speaking; it lands the boundary late, so the guard sees
        # fewer calls and stays quiet. That is the fail-open direction. Sniffing the text for those
        # markers was rejected: docs/standards.md refuses prose matching for judgements, and the
        # residual here costs a missed reminder rather than a wrong block.
        if r.get("type") != "user" or r.get("isMeta") or r.get("turnCompanion"):
            return False
        m = r.get("message")
        c = m.get("content") if isinstance(m, dict) else None
        if isinstance(c, str):
            return True
        return isinstance(c, list) and not any(
            isinstance(b, dict) and b.get("type") == "tool_result" for b in c)

    if not rows:
        return None           # empty or wholly unparseable is not the same as a clean turn

    start = 0
    for i, r in enumerate(rows):
        if is_real_user(r):
            start = i
    calls = []
    for r in rows[start + 1:]:
        if r.get("type") != "assistant":
            continue
        if r.get("isSidechain") and not own_transcript:
            continue          # on the main transcript that is another agent's work, not this turn's
        m = r.get("message")
        for b in ((m.get("content") if isinstance(m, dict) else None) or []):
            if isinstance(b, dict) and b.get("type") == "tool_use":
                calls.append(b)
    return calls

# SubagentStop gets the subagent's own transcript; transcript_path there is the main session's.
own = ev.get("agent_transcript_path") if ev.get("hook_event_name") == "SubagentStop" else None
path = own or ev.get("transcript_path")
calls = turn_tool_calls(path, own_transcript=bool(own))
if calls is None:
    warn("this repository declares gates.done_verified but the turn's transcript could not be read, "
         "so this turn was not checked.")

edited, ran = [], False
for c in calls:
    name = c.get("name")
    ti = c.get("input") or {}
    if name in ("Edit", "Write", "NotebookEdit"):
        p = ti.get("file_path") or ti.get("notebook_path") or ""
        if p and is_code(p):
            edited.append(p)
    elif name == "Bash" and test_cmd in (ti.get("command") or ""):
        ran = True

if not edited or ran:
    sys.exit(0)

who = "This subagent" if ev.get("hook_event_name") == "SubagentStop" else "This turn"
uniq = sorted(set(edited))
shown = ", ".join(uniq[:5]) + (" and %d more" % (len(uniq) - 5) if len(uniq) > 5 else "")
# The two modes reach different readers, so they cannot share one sentence. `decision: "block"`
# puts `reason` in front of Claude, so it is written as an instruction. `systemMessage` is defined
# by the protocol as "shown to the user", and warn mode lets the turn end, so its text is a
# statement of what happened. Until 2026-09-05 both carried the instruction, which meant warn mode
# told the user to go and run a command, in the voice of an order aimed at somebody else. warn is
# what `keel init` writes by default, so that was the text most repositories actually saw.
where = "%s edited %d file(s) including %s and never ran `%s`" % (who, len(uniq), shown, test_cmd)

if mode == "required":
    block("%s. Run it and report what it printed before ending the turn. If the work is genuinely "
          "incomplete, say what remains instead of ending on it." % where)
warn("%s. The turn was allowed to end because gates.done_verified is `warn`; set it to `required` "
     "to stop on this instead." % where)
PY
