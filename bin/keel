#!/usr/bin/env bash
# keel: per-project setup and health checks for the keel plugin.
#
# Plain bash. python3 is used where it is present, for JSON only, and its absence degrades
# honestly rather than silently: doctor reports what it could not check.
#
#   keel init [-y] [--team] [--force]   configure this project
#   keel doctor [--fast] [--json]       check this project, non-zero on any problem
#                                       --fast: check the verify commands are set, do not run them
#   keel version

# The `condition && good || fail` idiom in doctor is safe because every reporting helper returns 0
# explicitly; see cmd_doctor. Single quotes in printf strings are deliberate where they appear.
# shellcheck disable=SC2015,SC2016
# shellcheck source-path=SCRIPTDIR/..

set -uo pipefail

# Resolve through symlinks: the documented install is a symlink into a directory on PATH, and
# plain dirname would resolve HERE to that directory, losing lib/, templates/ and VERSION.
# Done by hand rather than with `readlink -f`, which is absent on older macOS.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    _link="$(readlink "$SELF")"
    case "$_link" in
        /*) SELF="$_link" ;;
        *)  SELF="$(dirname "$SELF")/$_link" ;;
    esac
done
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"

# The profile schema's own version, deliberately separate from VERSION. `keel_version` answers
# "which keel wrote this file". This answers "does this file have the fields the installed keel
# expects", which is the only version of that question worth warning about. Bump it only when a
# field is added, removed, renamed or moved. 0.7.0 and 0.7.1 changed none, and a warning that fires
# on releases like those is one nobody reads by the time it matters.
SCHEMA_VERSION=6

# The keys a schema version removed, the version that removed each, and what to do instead. Read by
# cmd_doctor, which is the only thing that can tell a person their profile still carries one.
#
# A register rather than a walk of the schema, because every object in
# templates/profile.schema.json is additionalProperties: true on purpose: a project may carry keys
# of its own, and a rule reporting anything the schema does not declare would warn at people for
# using a documented affordance, and could name no remedy for the keys that do matter.
#
# Append a line here in the same commit that removes a key from the schema. Nothing detects a
# removal you did not record. The fingerprint in tests/validate-skills.sh is a hash of the field
# set, so it proves the set changed and cannot say which way; that validator checks only the other
# direction, that no key named here is still declared in the schema.
retired_keys() {
    cat <<'RETIRED'
gates.tdd|4|skills/tdd/SKILL.md asks for the cycle unconditionally and always did, so removing the key changes nothing.
gates.review|4|skills/ship/SKILL.md runs its review step every time, so a project that set required already had it and one that set off never had the effect it expected.
gates.docs_updated|4|skills/ship/SKILL.md runs its docs step every time, on the same terms as gates.review.
gates.observability|4|nothing was asking, so removing the key changes nothing.
conventions.working_branch|4|record the branch in CONTRIBUTING.md or in notes, where a person will read it.
observability.log_shipping|4|set observability.backend to none for stdout only, which is the distinction the table in skills/coding-standards/references/observability.md keys on.
RETIRED
}

# Set by `keel init --harness <list>`. Empty means "work it out", which is what harness_set_for_repo
# does from the existing profile and then from the tracked tree.
HARNESS_FLAG=""

# Fail loudly on a broken install. Without this the sources below print to stderr and execution
# continues into undefined functions, which reads as a bug in the project being configured.
for _need in lib/detect-stack.sh lib/merge-claude-md.sh lib/apex-export.sh \
             lib/harness/resolve.sh lib/harness/claude.sh lib/deny-list.sh VERSION; do
    [ -e "$HERE/$_need" ] || {
        printf 'keel: incomplete install: %s not found under %s\n' "$_need" "$HERE" >&2
        exit 1
    }
done

# shellcheck source=lib/detect-stack.sh
. "$HERE/lib/detect-stack.sh"
# shellcheck source=lib/merge-claude-md.sh
. "$HERE/lib/merge-claude-md.sh"
# shellcheck source=lib/apex-export.sh
. "$HERE/lib/apex-export.sh"

# The harness layer. resolve.sh answers which gates are active where, from lib/harness/capabilities;
# each lib/harness/<id>.sh implements the same seven-function contract for one harness.
#
# Claude Code's is sourced here so the contract is always defined, and because it is the harness
# this CLI itself runs under. It is NOT the selection mechanism: every harness file defines the same
# function names, so sourcing two leaves only the second reachable. harness_each below is what
# actually runs a contract function once per harness, sourcing each one immediately before calling
# it. A repository serving both harnesses is the case that a "source them all and call once" design
# passes for one and silently skips for the other.
# shellcheck source=lib/harness/resolve.sh
. "$HERE/lib/harness/resolve.sh"
# shellcheck source=lib/harness/claude.sh
. "$HERE/lib/harness/claude.sh"

# Run one contract function once per harness this repository serves.
#
# The source has to happen INSIDE the loop, immediately before the call, for the reason above. That
# makes the loaded harness whichever ran last, so nothing outside a harness_each call may assume
# which one is loaded; go through harness_each instead, even for a single value.
# Validate before recording. Unchecked, `--harness bogus` wrote a harness nothing implements into
# the profile, and `--harness --team` ate the next flag: the profile recorded a harness called
# "--team", --team never ran, nothing was staged, and init said "configured" as though it had. Both
# found in review. harness_known is the authority and already existed, unused here.
harness_flag_set() {
    local want="${1:-}" h known
    known="$(harness_ids | tr '\n' ' ')"
    case "$want" in
        ""|-*) die "--harness needs a comma separated list of harness ids, not '$want'. Known: $known" ;;
    esac
    for h in ${want//,/ }; do
        harness_known "$h" || die "unknown harness '$h'. Known: $known"
        [ -f "$HERE/lib/harness/$h.sh" ] || die "harness '$h' is in the capability manifest and lib/harness/$h.sh does not exist, so keel cannot configure a repository for it."
    done
    HARNESS_FLAG="$want"
}

# Every harness the capability manifest knows, one per line. Read from the manifest rather than
# listed here, so a harness added there cannot be missing from an error message that names them.
harness_ids() {
    awk -F'|' '$1=="provides" {print $2}' "$(harness_capabilities_path)" | awk '!seen[$0]++'
}

# Every gate the capability manifest knows, one per line. Read from the manifest for the same
# reason harness_ids is: a fifth gate added under hooks/ with a requires row would otherwise be
# missing from what doctor reports, and a report that quietly omits a gate is the failure this
# whole design exists to prevent. tests/test-harness-claims.sh already fails the build when the
# requires rows and the files under hooks/ disagree, so either is the same list.
harness_gates() {
    awk -F'|' '$1=="requires" {print $2}' "$(harness_capabilities_path)" | awk '!seen[$0]++'
}

# Which harness is running this process.
#
# CLAUDE_PLUGIN_ROOT is NOT a discriminator: Codex sets it deliberately for compatibility, at
# codex-rs/hooks/src/engine/discovery.rs:266-269, and only for plugin hooks at that. Checked rather
# than assumed, because hooks/hooks.json interpolates that variable.
#
# CODEX_VERSION is injected into every shell command Codex's exec tool runs
# (codex-rs/core/src/exec_env.rs:40-49). A hook reads turn_id from its stdin payload instead; that
# path lives in the hooks, not here.
harness_running() {
    [ -n "${CODEX_VERSION:-}" ] && { printf 'codex\n'; return 0; }
    [ -n "${CLAUDECODE:-}" ] && { printf 'claude\n'; return 0; }
    printf 'unknown\n'
}

# Whether the hooks keel ships will actually RUN for this harness on this machine. Prints
# `trusted`, `untrusted` or `unknown`.
#
# THIS IS NOT THE QUESTION THE CAPABILITY MANIFEST ANSWERS, and open question 6 of the architecture
# is the gap between the two. The manifest says what a harness CAN do. Doctor has to say what THIS
# installation does. Codex runs no hook until its source is trusted and says nothing when it skips
# one, measured 2026-09-06 on codex-cli 0.153.4, so `harness_active_gates codex` is a true statement
# about Codex and a false one about a user whose hooks are untrusted. Reporting the manifest's
# answer there would be keel agreeing with itself.
#
# The same probe found the 25 skills load without trust and the hooks do not, so an untrusted
# install does not look broken, it looks like most of keel working. That is why the doctor line this
# feeds says which half a person is looking at.
#
# WHAT IS READ. The key is `hooks.state."<id>"`, carried as a literal `hooks.state."` prefix in the
# 0.153.4 binary beside the `enabled` and `trusted_hash` fields, in the user's config. Installing
# the real keel plugin wrote `[plugins."keel@gbi"] enabled = true` and no trust entry of any kind,
# and running a session added none, so the absence of `trusted_hash` beside an installed keel is
# itself the signal.
#
# ONLY KEEL'S OWN TABLES COUNT, and this is the correction that matters. The first version of this
# function tracked the three flags across every `[hooks.state.*]` and `[plugins.*]` table in the
# file, which on any config holding a second plugin answered about the wrong one. Both directions
# were wrong and one of them fails OPEN: an unrelated plugin the user had trusted made keel read as
# trusted, and doctor printed three gates active on an installation where none of them would ever
# run. The id is `<plugin name>@<marketplace>`, so the tables are matched on a quoted id of `keel`
# or `keel@anything` and nothing else contributes.
#
# UNKNOWN IS NOT A FAILURE STATE AND MUST NOT READ AS ONE. The manifest fails closed on missing
# evidence because a wrong `provides` row is unsafe. A doctor line that cries wolf on every machine
# gets ignored, which costs more than it saves, so an absent or unreadable config says so rather
# than reporting a gate dark.
#
# It lives in this file rather than in lib/harness/codex.sh because cmd_doctor asks it for a named
# harness id, including one the repository does not serve, and harness_each only walks the set the
# repository does serve.
harness_hooks_trusted() {   # harness_hooks_trusted <harness>
    case "${1:-}" in
        # Claude Code has no trust step. A hook in settings.json runs, so there is nothing to read
        # and nothing to withhold.
        claude) printf 'trusted\n'; return 0 ;;
        codex)  ;;
        *) printf 'unknown\n'; return 0 ;;
    esac
    # `${HOME:-}` and not `$HOME`: this file runs under `set -u`, and an unset HOME (a container, a
    # cron shell) would abort doctor on an unbound variable instead of reporting. Both unset leaves
    # an unreadable path, which is the `unknown` this function already has an answer for.
    local cfg="${CODEX_HOME:-${HOME:-}/.codex}/config.toml"
    [ -r "$cfg" ] || { printf 'unknown\n'; return 0; }
    # The section is tracked rather than grepped, because `enabled` and `trusted_hash` are ordinary
    # field names and the answer depends on which table they sit in. A hash that is blank or empty
    # is absent evidence and grants nothing, the same rule ADR-0003 puts on a provides row.
    awk -F= '
        /^[[:space:]]*\[/ {
            state  = ($0 ~ /^[[:space:]]*\[hooks\.state\."keel(@[^"]*)?"\][[:space:]]*$/)
            plugin = ($0 ~ /^[[:space:]]*\[plugins\."keel(@[^"]*)?"\][[:space:]]*$/)
            next
        }
        state {
            if ($1 ~ /^[[:space:]]*trusted_hash[[:space:]]*$/ && $2 ~ /[^[:space:]"]/) hash = 1
            if ($1 ~ /^[[:space:]]*enabled[[:space:]]*$/ && $2 ~ /false/) off = 1
        }
        plugin {
            if ($1 ~ /^[[:space:]]*enabled[[:space:]]*$/ && $2 ~ /false/) off = 1
            installed = 1
        }
        END {
            if (hash && !off) print "trusted"
            else if (hash || installed) print "untrusted"
            else print "unknown"
        }
    ' "$cfg"
}

# Asked once per process. harness_set_for_repo starts an interpreter to parse the profile's
# `harnesses` array, and harness_each is called a dozen times in one init: for the context file, the
# config paths, the permission rules, the writers and each doctor phase. Unprimed that is a dozen
# python starts for a constant, and tests/test-keel.sh counts interpreter starts precisely because
# this file has been bitten by that before. Primed in the parent shell, so the $( ) subshells below
# inherit it full. Same shape and same reason as json_load and settings_report_load.
HARNESS_SET=""
harness_set_load() {
    HARNESS_SET="$(harness_set_for_repo "$HARNESS_FLAG")"
}

harness_each() {   # harness_each <contract function> [args...]
    local h
    [ -n "$HARNESS_SET" ] || harness_set_load
    for h in $HARNESS_SET; do
        [ -f "$HERE/lib/harness/$h.sh" ] || continue
        # shellcheck source=/dev/null
        . "$HERE/lib/harness/$h.sh"
        "$@"
    done
    # Leave Claude Code's contract loaded, so a caller that forgets the rule above gets the
    # behaviour keel has always had rather than whichever harness happened to sort last.
    # shellcheck source=lib/harness/claude.sh
    . "$HERE/lib/harness/claude.sh"
}

DEFAULT_DOCS_ROOT="docs/keel"

# Asked once, at startup. The answer cannot change while this process runs, and the lookup was
# forked about twenty times a run for a constant. The function stays so no call site changes.
#
# Actually runs the interpreter rather than checking PATH: Windows' App Execution Alias puts a
# python3.exe on PATH even when Python is not installed, which prints a not-found message and
# exits 49. `command -v` would call that present.
HAVE_PYTHON=0
python3 -c 'pass' >/dev/null 2>&1 && HAVE_PYTHON=1
have_python() { [ "$HAVE_PYTHON" -eq 1 ]; }

# What bounds a verify command in doctor, when the machine has anything to bound it with. macOS
# ships neither `timeout` nor `gtimeout`, so this is a preference and never a dependency: with
# neither present the command runs unbounded, exactly as it did before.
TIMEOUT_BIN=""
for _t in timeout gtimeout; do
    command -v "$_t" >/dev/null 2>&1 && { TIMEOUT_BIN="$_t"; break; }
done
# Generous on purpose. It is a ceiling for a suite that has hung, not a target: a real test run
# that takes twelve minutes must still finish rather than be reported as broken.
VERIFY_TIMEOUT=900

say()  { printf '%s\n' "$1"; }
err()  { printf 'keel: %s\n' "$1" >&2; }
die()  { err "$1"; exit 1; }

# The whole file, flattened to one dotted.path=value line per scalar, read once per process.
#
# One interpreter start per field meant doctor paid thirteen of them to read one small file. The
# cache is keyed on the path because more than one file is never read in a single command today,
# and a second one would otherwise silently serve the first one's values.
JSON_CACHE=""
JSON_CACHE_FILE=""

json_cache_clear() { JSON_CACHE=""; JSON_CACHE_FILE=""; }

json_load() {  # json_load <file>
    [ "$JSON_CACHE_FILE" = "$1" ] && return 0
    have_python || return 1
    # No apostrophe anywhere below. bash 3.2 does not treat a quoted heredoc body as literal when
    # the heredoc is inside a $( ), so one ' opens a quote that swallows the rest of this file and
    # the parse error is reported hundreds of lines away. shellcheck does not see it.
    # tr -d '\r' because Windows' text-mode stdout adds \r before \n on every printed line, which
    # `read -r` below does not strip, and a cached value carrying a trailing CR breaks exact-string
    # comparisons everywhere the cache is read.
    JSON_CACHE="$(python3 - "$1" <<'PY' 2>/dev/null | tr -d '\r'
import json, sys

def render(v):
    # JSON spelling, not the Python spelling. The profile holds `true`, and printing `True` meant
    # the value could not be fed back to `profile set` and no shell comparison against `true` worked.
    if v is None:  return ""
    if v is True:  return "true"
    if v is False: return "false"
    return str(v)

def walk(d, prefix):
    for k, v in d.items():
        k = str(k)
        # A key holding a dot is indistinguishable from a nested path once the segments are joined,
        # so it is left out along with anything under it. json_get then falls back to the
        # interpreter, which walks the real structure and refuses it, which is what profile set does.
        if "." in k:
            continue
        p = prefix + k
        if isinstance(v, dict):
            walk(v, p + ".")
        else:
            s = render(v)
            # A value spanning lines cannot be held in a line-per-field cache. It is left out, and
            # json_get falls back to reading that one field with an interpreter, which is correct
            # and merely slow. Emitting it would corrupt every field after it.
            if "\n" not in p and "\n" not in s:
                print(p + "=" + s)

try:
    walk(json.load(open(sys.argv[1])), "")
except Exception:
    sys.exit(1)
PY
)" || { json_cache_clear; return 1; }
    JSON_CACHE_FILE="$1"
    return 0
}

json_get() {  # json_get <file> <dotted.path>
    have_python || return 1
    if json_load "$1"; then
        local line
        while IFS= read -r line; do
            case "$line" in
              "$2="*) printf '%s\n' "${line#*=}"; return 0 ;;
            esac
        done <<< "$JSON_CACHE"
    fi
    # Not in the cache: either the key is absent, or its value spans lines and the flattener left
    # it out. One interpreter start tells the two apart, and both are rare.
    python3 - "$1" "$2" <<'PY' 2>/dev/null
import json,sys
d=json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    if not isinstance(d,dict) or k not in d: sys.exit(1)
    d=d[k]
if   d is None:  print("")
elif d is True:  print("true")
elif d is False: print("false")
else:            print(d)
PY
}

docs_root() {
    local r=""
    [ -f .keel/profile.json ] && r="$(json_get .keel/profile.json docs_root || true)"
    printf '%s' "${r:-$DEFAULT_DOCS_ROOT}"
}

# ---------------------------------------------------------------- init

# The trap that makes the artifact chain vanish: a docs root git ignores. The snapshot writes,
# reports success, and is invisible to every teammate. Nothing errors.
check_docs_ignored() {
    local root="$1"
    git rev-parse --git-dir >/dev/null 2>&1 || return 0
    local hit
    hit="$(git check-ignore -v "$root/" 2>/dev/null || git check-ignore -v "$root/snapshot.md" 2>/dev/null || true)"
    [ -z "$hit" ] && return 0
    err "the docs root '$root' is ignored by git: $hit"
    err "every skill downstream of repo-snapshot writes there and assumes it is committed."
    err "fix one of these, then re-run:"
    err "  1. append these to .gitignore, in this order. Git never looks inside an excluded"
    err "     directory, so each parent is re-included before the negation can reach the root:"
    local acc='' rest="$root"
    while [ "${rest#*/}" != "$rest" ]; do
      acc="$acc${rest%%/*}"
      err "        !$acc/"
      err "        $acc/*"
      acc="$acc/"; rest="${rest#*/}"
    done
    err "        !$root/"
    err "  2. set docs_root in .keel/profile.json to a path that is tracked"
    return 1
}

# The repository's default branch, which is frequently not the checked-out one. Getting this
# wrong matters: skills refuse to implement on the default branch, and repo-snapshot compares
# HEAD against it.
default_branch() {
    local b
    b="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
    [ -n "$b" ] && { printf '%s' "$b"; return; }
    for c in main master; do
        git show-ref --verify --quiet "refs/heads/$c" && { printf '%s' "$c"; return; }
    done
    printf '%s' "$(git symbolic-ref --short HEAD 2>/dev/null || echo main)"
}

# Merge the freshly detected profile under any existing one: existing values win.
#
# Detection is a starting point, never an authority. Found by running init a second time on a
# real project, where it replaced a hand-corrected test command with a detected one that could
# not run without a database. A tool that discards a human's correction gets run once.
merge_profile() {
    local fresh="$1" existing="$2"
    have_python || { mv "$fresh" "$existing"; return 0; }
    KEEL_HARNESS_EXPLICIT="$HARNESS_FLAG" python3 - "$fresh" "$existing" <<'PY'
import json, os, sys
fresh = json.load(open(sys.argv[1]))
old = json.load(open(sys.argv[2]))
def merge(new, cur):
    out = dict(new)
    for k, v in cur.items():
        if k not in out:                      out[k] = v            # human-added key
        elif isinstance(v, dict) and isinstance(out[k], dict):
            out[k] = merge(out[k], v)
        elif v not in (None, "", [], {}):     out[k] = v            # human value wins
    return out
merged = merge(fresh, old)
# The one field the tool owns rather than the human. It records which keel wrote this
# profile, so letting the old value win would freeze it at the version of the first init and
# make "has this project been re-initialised since the upgrade?" unanswerable.
merged["keel_version"] = fresh["keel_version"]
# Same reasoning, and more load-bearing: doctor decides whether this profile is missing fields by
# reading schema_version, so an old value surviving a re-init would make the refresh invisible to
# the one check that exists to notice it.
merged["schema_version"] = fresh["schema_version"]
# `harnesses` is a human value and the merge above is right to keep it: re-running init must not
# re-infer the set from the tree and quietly drop a harness somebody added by hand. But an explicit
# --harness IS the human speaking, and it lost to the value it was trying to replace, silently, on
# every repository that already had a profile. The only ways to change the set were --force, which
# discards every human value in the file, and hand-editing. Found in review.
if os.environ.get("KEEL_HARNESS_EXPLICIT") and "harnesses" in fresh:
    merged["harnesses"] = fresh["harnesses"]
json.dump(merged, open(sys.argv[2], "w"), indent=2)
open(sys.argv[2], "a").write("\n")
PY
    rm -f "$fresh"
}

# A repo with documents and no code is a legitimate state, not a misconfiguration. Found on a real
# project carrying 30k words of requirements before a line of code existed: doctor demanded a test
# command it could never have, and a check that always fails on a legitimate state teaches people to
# ignore the checker.
project_kind() {
    [ "$(detect_stack | cut -d' ' -f1)" != "unknown" ] && { printf 'service'; return; }
    local src
    src=$(git ls-files 2>/dev/null | grep -cE '\.(ts|js|py|go|java|kt|php|rs|rb|cs|swift|lua|dart|c|cc|cpp|h|hpp)$' || true)
    [ "${src:-0}" -gt 0 ] && printf 'service' || printf 'docs'
}

# One JSON array from newline-separated input. Empty input gives an empty array rather than a
# missing key, so a reader never has to tell absent from none.
json_str_array() {
    printf '%s\n' "$1" | awk 'NF { if (n++) printf ", "; printf "\"%s\"", $0 }'
}

# A JSON string, or null when a detector had nothing to declare. null and "none" are different
# answers: "none" is a project that has no such thing, this is one whose answer could not be read,
# and the skills that ask have to tell them apart.
json_or_null() {
    if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi
}

# Which harnesses this repository serves. A set, not a switch: a team with some developers on Claude
# Code and some on Codex works on one repository, and a switch makes that repository's config a
# running argument between the two of them. ADR-0004.
#
# Tracked files only. An untracked .codex/ is one developer's local state and must not change what
# the repository claims for everybody.
#
# AGENTS.md is deliberately NOT a signal. keel has dual written it since long before Codex was
# supported and Cursor, Copilot CLI and Gemini CLI read it too, so treating it as evidence would
# mark the whole installed base as Codex-serving in one upgrade.
harness_set_for_repo() {
    local explicit="${1:-}"
    if [ -n "$explicit" ]; then printf '%s\n' "${explicit//,/$'\n'}"; return 0; fi
    if [ -f .keel/profile.json ]; then
        # Read through json_get, which answers from the flattened cache json_load already filled,
        # so this costs no interpreter start of its own. tests/test-keel.sh counts them, and a
        # second python3 for a value the process has already parsed is the thing it counts.
        #
        # The cache flattens with Python str(), so a list comes back as ['claude', 'codex'],
        # single-quoted and on one line. Unpicking that repr is only safe because every id in it is
        # validated on the way in by harness_flag_set, so the alphabet is [A-Za-z0-9_-]; anything
        # else is dropped here rather than half-parsed into a harness name nothing implements.
        local existing="" raw h
        raw="$(json_get .keel/profile.json harnesses 2>/dev/null || true)"
        case "$raw" in
            \[*\])
                for h in $(printf '%s' "$raw" | tr -d "[]'\"" | tr ',' ' '); do
                    case "$h" in
                        *[!A-Za-z0-9_-]*|"") continue ;;
                    esac
                    existing="$existing$h
"
                done ;;
        esac
        [ -n "$existing" ] && { printf '%s' "$existing"; return 0; }
    fi
    local out="claude"
    git ls-files --error-unmatch .codex/config.toml >/dev/null 2>&1 && out="$out
codex"
    printf '%s\n' "$out"
}

# The verify keys write_profile always writes, in the order it writes them. write_ci reads this
# same list, deriving its subset by exclusion, rather than hand-typing a second copy: two lists is
# how a key added, renamed, or removed here gets missed there (docs/standards.md: "One definition
# per verify command").
VERIFY_KEYS="test test_one test_affected test_integration lint format format_fix typecheck build e2e security"

write_profile() {
    local root="$1" lang rt fw pm kind ui
    # Detect the languages here, in this shell, before anything asks. Every line below reads them
    # through a $( ), which is a subshell: it inherits the cache already full, but anything it
    # detects itself dies with it. Without this line the tree is walked eight times over. Same
    # shape and same reason as the pkg_scripts_load call further down; it is not redundant.
    detect_languages >/dev/null
    read -r lang rt fw pm <<<"$(detect_stack)"
    kind="$(project_kind)"
    ui="$(detect_has_ui)"
    mkdir -p .keel
    local name; name="$(basename "$PWD")"
    local pm_json; pm_json="$(json_or_null "$pm")"
    # `$( < )` rather than `$(cat )`: bash reads the file itself and forks nothing. The guard keeps
    # the old fallback, since a missing VERSION is a broken install and 0.0.0 is what it recorded.
    local kver=0.0.0; [ -f "$HERE/VERSION" ] && kver="$(<"$HERE/VERSION")"
    {
      printf '{\n'
      printf '  "keel_version": "%s",\n' "$kver"
      printf '  "schema_version": %s,\n' "$SCHEMA_VERSION"
      printf '  "harnesses": [%s],\n' "$(json_str_array "$(harness_set_for_repo "$HARNESS_FLAG")")"
      printf '  "project": { "name": "%s", "kind": "%s", "description": "" },\n' "$name" "$kind"
      printf '  "stack": { "language": "%s", "runtime": "%s", "framework": "%s", "package_manager": %s, "also": [%s], "datastores": [%s], "has_ui": %s },\n' \
        "$lang" "$rt" "$fw" "$pm_json" "$(json_str_array "$(detect_also)")" \
        "$(json_str_array "$(detect_datastores "$lang")")" "$ui"
      # Fill the script cache here, in this shell. The loop below reads each verify key through
      # `v="$(detect_verify ...)"`, and a $( ) is a subshell: it inherits this variable already
      # full, but anything it loads itself dies with it. Without this line every key would load
      # package.json again and the cache would save nothing. It is not redundant.
      pkg_scripts_load
      printf '  "verify": {\n'
      local first=1 v
      for k in $VERIFY_KEYS; do
          v="$(detect_verify "$k" "$lang")"
          [ $first -eq 0 ] && printf ',\n'; first=0
          if [ -z "$v" ]; then printf '    "%s": null' "$k"
          else printf '    "%s": "%s"' "$k" "$(printf '%s' "$v" | sed 's/"/\\"/g')"; fi
      done
      printf '\n  },\n'
      # done_verified starts at "warn", not "required". The Stop hook it drives refuses to let a
      # turn end, which is not something to switch on for a repository without being asked. A
      # project raises it to "required" once it has seen the warning fire and agreed with it.
      # coding_standards starts at "required", unlike done_verified and commit_guard, because
      # doctor's own FR-10 check turns an unmet "required" into a named failure rather than silence
      # (bin/keel#gates.coding_standards is a promise about a document): a fresh project sees the
      # gap immediately and writes docs/standards.md (coding-standards' seed mode covers a project
      # with no code yet) rather than drifting for months on a gate nobody switched on.
      # context_window is written even though it is sometimes wrong. The window cannot be read from
      # a session, so an unset key means the watchdog assumes 200000 and only discovers otherwise
      # once a session exceeds it. Writing the conservative value is safe because a configured
      # window is a floor: observation raises it in flight. It was a ceiling until 2026-08-18, and
      # writing this key before that change would have hard-stopped every 1M session at 170,000
      # tokens permanently.
      printf '  "gates": { "coding_standards": "required", "security_audit": "required", "commit_guard": "off", "done_verified": "warn", "context_window": 200000, "suite_warn_seconds": 60 },\n'
      printf '  "observability": { "backend": "signoz", "otlp_endpoint_var": "OTEL_EXPORTER_OTLP_ENDPOINT" },\n'
      # response_style and explain_level are written explicitly rather than left absent and
      # defaulted. Terse and technical are what a project gets without asking, so the keys that
      # change them have to be visible in the file the reader already opens, not things they must
      # first learn exist. "verbose" and "plain" are the opt-ins.
      printf '  "conventions": { "commit_style": "conventional", "default_branch": "%s", "protect_default_branch": true, "response_style": "terse", "explain_level": "technical" },\n' "$(default_branch)"
      printf '  "deploy": { "target": %s, "ci": %s, "envs": [] },\n' \
        "$(json_or_null "$(detect_deploy_target)")" "$(json_or_null "$(detect_ci)")"
      printf '  "docs_root": "%s",\n' "$root"
      # Written so doctor has the right list to check. plugin_report has always read this key and
      # fallen back to a fixed three when it was absent, which is why a language server was never
      # named on a repository that already had a .claude/settings.json: nothing enabled it and
      # nothing reported it missing.
      printf '  "plugins": { "recommended": [%s] },\n' "$(json_str_array "$(harness_each harness_recommend_plugins)")"
      printf '  "artifacts": {\n'
      printf '    "_note": "Set any of these to a path when the artifact already exists elsewhere. Skills read the mapped path instead of the default under docs_root, so a repo with its own naming convention is not duplicated.",\n'
      printf '    "snapshot": null, "prd": null, "stories": null, "architecture": null, "decisions": null, "plans": null\n'
      printf '  }\n' 
      printf '}\n'
    } > .keel/profile.json.new

    have_python && ! python3 -c "import json;json.load(open('.keel/profile.json.new'))" 2>/dev/null \
        && die "generated an invalid profile; this is a bug in keel"

    if [ -f .keel/profile.json ] && [ "${FORCE:-0}" -eq 0 ]; then
        merge_profile .keel/profile.json.new .keel/profile.json
    else
        mv .keel/profile.json.new .keel/profile.json
    fi
    json_cache_clear
    return 0
}

render_block() {
    local out="$1" root="$2" src="$HERE/templates/project-claude-md-block.md" t v
    t="$(mktemp)"
    # Only the managed block, never the template's own header comment.
    awk "/$(printf '%s' "$MARK_START" | sed 's/[][\\/.*^$]/\\\\&/g')/,/$(printf '%s' "$MARK_END" | sed 's/[][\\/.*^$]/\\\\&/g')/" "$src" > "$t"
    sed -i.bak "s|{{DOCS_ROOT}}|$root|g" "$t"
    for k in TEST LINT TYPECHECK; do
        local key; key="$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]')"
        v="$(json_get .keel/profile.json "verify.$key" || true)"
        # A null command is omitted rather than rendered as the word "null".
        [ -z "$v" ] && v="# no $key command in this project"
        sed -i.bak "s|{{VERIFY_$k}}|$(printf '%s' "$v" | sed 's/|/\\|/g')|g" "$t"
    done
    rm -f "$t.bak"; mv "$t" "$out"
}

scaffold_docs() {
    local root="$1"
    mkdir -p "$root"/{ideas,prd,stories,architecture,decisions,plans,runbooks,audits,incidents,port}
    [ -f "$root/README.md" ] || cat > "$root/README.md" <<D
# Project documentation

Written and read by keel skills. Committed on purpose: this is the project's memory.

| Path | Written by |
|---|---|
| \`snapshot.md\` | \`repo-snapshot\` |
| \`standards.md\` | \`coding-standards\` |
| \`ideas/\` | \`shape-idea\` |
| \`port/\` | \`port-assess\` |
| \`prd/\` | \`write-prd\` |
| \`stories/\` | \`write-user-stories\` |
| \`architecture/\`, \`decisions/\` | \`design-architecture\` |
| \`plans/\` | \`write-plan\` |
| \`runbooks/\` | \`setup-deployment\`, \`write-docs\` |
| \`audits/\` | \`security-audit\`, \`coding-standards\` |
| \`incidents/\` | \`incident-response\` |

A dated report in \`audits/\` is named \`YYYY-MM-DD-<kind>.md\`, where \`<kind>\` is the noun of the
skill that wrote it: \`security\`, \`standards\`. Where a second mode of the same skill writes there
too, its kind is that noun plus its own mode name, so \`coding-standards\` writes \`standards\` from
assess and \`standards-audit\` from audit. An incident record is named for its slug.

See \`prompting.md\` for how to phrase a request so the right skill fires.
D
    sed "s|{{DOCS_ROOT}}|$root|g" "$HERE/templates/prompting-cheatsheet.md" > "$root/prompting.md"
    [ -f "$root/decisions/ADR-0000-template.md" ] || \
      printf '# ADR-0000: Template\n\nCopy this file. See the `design-architecture` skill.\n' \
      > "$root/decisions/ADR-0000-template.md"
}

# Emit a JSON array of the rules from one of the two lists above, indented to sit inside
# "permissions". Kept in one place so the writer, the merge, and doctor cannot disagree.
json_rule_array() {
    local first=1 r
    printf '['
    while IFS= read -r r; do
        [ -n "$r" ] || continue
        [ $first -eq 1 ] && first=0 || printf ','
        printf '\n      "%s"' "$r"
    done
    printf '\n    ]'
}

# Whether the repository's own rules ignore a path, with the developer's global excludes taken out
# of the answer.
#
# The question doctor has to settle is whether whoever clones this will commit the file, and a
# global rule protects only the machine it sits on. Found on the existing-service pilot, where a
# corrupted .gitignore had destroyed the repository's rule for settings.local.json and doctor
# reported it ignored anyway, because the author's own ~/.gitignore happened to cover it. A check
# that passes for a reason no teammate shares is worse than no check.
#
# `.git/info/exclude` is per-clone and equally private, and is deliberately not neutralised here:
# there is no config key for it, and this claims only what it checks.
repo_ignores() {
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.excludesFile GIT_CONFIG_VALUE_0=/dev/null \
        git check-ignore -q "$1" 2>/dev/null
}

# A repository can reference a document a fresh clone cannot open, and until this nothing checked
# it. check_docs_ignored covers the one directory keel owns; this covers every document the
# repository points at.
#
# The author never sees it, because the file is on their disk and reads correctly. `git status` is
# structurally blind to ignored files, so the obvious check comes back clean, and `git log` answers
# for a path HEAD does not carry. Baselined against a real repository before this existed: two
# agents reviewing its documentation, one asked outright what a fresh clone gets, both read three
# unreachable files and called them "~6 months stale", the date being when they were last committed
# before removal. The second then recommended linking a fourth document that is also ignored.
#
# Emits `severity<TAB>message`, so doctor keeps ownership of its counters. Only documents that
# exist here are considered: a link to a path that is absent everywhere is a broken link, which is
# a different defect and not this one.
referenced_docs_findings() {
    local root="$1" f dir target p pdir pbase sev top seen='' tree
    git rev-parse --git-dir >/dev/null 2>&1 || return 0
    # Every path HEAD carries, read once. It was one `git cat-file -e` per link, which on a
    # repository whose documents cross-reference each other is dozens of processes for a membership
    # test the shell can do itself. Wrapped in newlines so a whole-line match is a substring match.
    #
    # quotePath=false keeps a non-ASCII name readable. A name holding a quote, a backslash or a
    # newline is still C-quoted by git and so will not match here, which reads as not in HEAD: a
    # warning about a file that is committed, rather than silence about one that is not.
    tree="
$(git -c core.quotePath=false ls-tree -r --name-only HEAD 2>/dev/null)
"
    # The logical `pwd` and not `git rev-parse --show-toplevel`: on macOS the latter answers with
    # the physical path, so under /var every prefix test failed and the check silently found
    # nothing. doctor already runs from the project root everywhere else.
    top="$(pwd)"
    # harness_each, not a bare call: the rule at the top of this file is that nothing outside one
    # may assume which harness is loaded, and a bare call here scanned whichever was sourced last.
    for f in README.md $(harness_each harness_context_file) AGENTS.md "$root"/*.md; do
        [ -f "$f" ] || continue
        dir="${f%/*}"; [ "$dir" = "$f" ] && dir='.'
        while IFS= read -r target; do
            # Anything git cannot carry either way: absolute URLs, protocol-relative, mail, page
            # anchors, and site-absolute paths, which are served rather than cloned.
            case "$target" in ''|'#'*|/*|*'://'*|mailto:*) continue ;; esac
            target="${target%%#*}"
            target="${target#./}"
            [ -n "$target" ] || continue
            p="$target"; [ "$dir" = '.' ] || p="$dir/$target"
            p="${p%/}"
            [ -e "$p" ] || continue

            # `HEAD:<path>` does not resolve `..`, and git never normalises a tree path, so a
            # document linking a sibling directory reads as missing. Found by running this against
            # keel itself, where it called five committed files unreadable. The logical `pwd` is
            # what collapses it, and anything landing outside the repository is not ours to judge.
            case "$p" in */*) pdir="${p%/*}" ;; *) pdir='.' ;; esac
            pbase="${p##*/}"
            p="$( cd "$pdir" 2>/dev/null && printf '%s/%s' "$(pwd)" "$pbase" )" || continue
            case "$p" in "$top"/*) p="${p#"$top"/}" ;; *) continue ;; esac

            case "$seen" in *"|$f>$p|"*) continue ;; esac
            seen="$seen|$f>$p|"

            # A directory counts as carried when HEAD holds anything under it, which is the same
            # question the pathspec answered; a file, when HEAD holds that exact path.
            if [ -d "$p" ]; then
                case "$tree" in *"
$p/"*) continue ;; esac
            else
                case "$tree" in *"
$p
"*) continue ;; esac
            fi

            # Ignored is the failure: committing does not fix it, the ignore rule has to change
            # first. Merely uncommitted clears with the next `git add`, and failing on that would
            # fire on every document between being written and being committed.
            if repo_ignores "$p"; then
                sev=fail
                printf '%s\t%s\n' "$sev" "$f links '$p', which git ignores and HEAD does not carry. A fresh clone cannot open it. Un-ignore and commit it, or drop the reference."
            else
                sev=warn
                printf '%s\t%s\n' "$sev" "$f links '$p', which exists here but is not committed. A fresh clone cannot open it until it is."
            fi
        done < <(grep -oE '\]\([^)[:space:]]+' "$f" 2>/dev/null | sed 's/^](//')
    done
}

# Two files keel writes into a working tree that must never reach a commit. The local settings file
# holds a permission mode and a developer's own allow rules, and committing it imposes both on
# everyone who clones. The handoff is session state written by the context watchdog, stale the moment
# work resumes; without a rule it is swept in by the next `git add -A`.
ignore_local_state() {
    local line
    # A hand-written .gitignore often has no newline on its final line, which an append then welds
    # keel's rule onto: one line matching nothing, destroying the project's own last rule and adding
    # neither of keel's. Found on the existing-service pilot, where it silently un-ignored the
    # settings.local.json rule the repository already had.
    [ -s .gitignore ] && [ -n "$(tail -c 1 .gitignore)" ] && printf '\n' >> .gitignore
    # The harness's own uncommitted config, plus the handoff. Read from the contract rather than
    # named here, so a repository serving a second harness ignores that harness's local file too
    # without this function learning what it is called.
    for line in $(harness_each harness_config_paths | sed -n 's/^local|//p') ".keel/handoff.md"; do
        if [ -f .gitignore ] && grep -qxF "$line" .gitignore; then continue; fi
        printf '%s\n' "$line" >> .gitignore
    done
}

# Stage what init wrote, so a teammate's clone carries the SOP rather than a normal session.
# `.gitignore` is on the list because ignore_local_state appends to it: left unstaged, the
# teammate who clones has no rule keeping settings.local.json out, and commits the
# bypassPermissions file that rule exists to exclude. Reports what actually happened, since
# "Staged for commit" printed after a failed `git add` is worse than no message at all.
stage_for_team() {
    local root="$1"
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        say "  note: --team stages files for commit, and this is not a git repository. Nothing staged."
        return 0
    fi
    # One `git add`, not one per path. The positional parameters carry the list because `$root` can
    # hold a space and this file uses no arrays; `$1` is already read into `root` above.
    local p
    set --
    for p in .keel $(harness_each harness_context_file) AGENTS.md $(harness_each harness_config_dirs) "$root" .gitignore; do
        [ -e "$p" ] && set -- "$@" "$p"
    done
    if [ "$#" -gt 0 ] && git add -- "$@" >/dev/null 2>&1; then
        say "Staged for commit (--team)."
    else
        say "  note: --team staged nothing: 'git add' failed. Add them by hand."
    fi
    return 0
}

cmd_init() {
    # init is non-interactive today, so -y is accepted and has no effect. It is kept so scripts
    # written against it keep working when prompts are added.
    local team=0
    FORCE=0
    HARNESS_FLAG=""
    # --harness takes its value in the NEXT argument, so the loop cannot be a plain `for a in "$@"`
    # any more: that form has no way to consume two. `shift`-based parsing keeps every existing flag
    # behaving exactly as it did and is the smallest change that can read a value at all.
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) ;;
            --team) team=1 ;;
            --force) FORCE=1 ;;
            --harness) shift; harness_flag_set "${1:-}" ;;
            --harness=*) harness_flag_set "${1#--harness=}" ;;
        esac
        shift
    done

    local root; root="$(docs_root)"
    check_docs_ignored "$root" || exit 1

    for f in $(harness_each harness_context_file) AGENTS.md; do
        check_markers "$f"; local rc=$?
        [ $rc -eq 2 ] && die "$f has duplicate keel markers. Remove the extra block by hand; keel will not guess which to keep."
        [ $rc -eq 3 ] && die "$f has an unbalanced keel marker. Fix it by hand."
    done

    write_profile "$root"
    # write_profile has just replaced the file and cleared the cache. Fill it here, in this shell,
    # so the reads below and the ones inside render_block inherit it full. Each of those is a $( ),
    # which cannot fill it for anybody else. Not redundant.
    json_load .keel/profile.json || true
    harness_set_load
    local block; block="$(mktemp)"
    render_block "$block" "$root"
    for _ctx in $(harness_each harness_context_file); do merge_block "$_ctx" "$block"; done
    merge_block AGENTS.md "$block"
    rm -f "$block"
    scaffold_docs "$root"
    harness_each harness_write_config "$root"
    harness_each harness_write_local_config "$root"
    ignore_local_state
    merge_ts_strict
    # Only where nothing declares a CI platform yet. deploy.ci is already filled by write_profile,
    # from .gitlab-ci.yml, a Jenkinsfile, a non-empty .github/workflows/ and the rest, so a project
    # that made that choice, on any platform, is left alone: the posture merge_profile already takes
    # toward a human-set value. deploy.ci is also empty when detect_ci found more than one marker and
    # left the choice ambiguous on purpose, so ci_marker_present is checked too: a project with two
    # conflicting CI files is a project that made a choice, just not one detect_ci can name.
    { [ -n "$(json_get .keel/profile.json deploy.ci || true)" ] || ci_marker_present; } || write_ci
    # Only where the mapping could have applied: a go or rust project is not missing an audit step
    # this table was ever going to write, and a note on every init is one people stop reading.
    case "$(json_get .keel/profile.json stack.language || true)" in
      javascript|typescript|python)
        [ -n "${CI_AUDIT_SKIPPED:-}" ] && say "  note: no dependency audit step in the CI workflow: no audit command is known for package manager '$CI_AUDIT_SKIPPED'. Add one by hand." ;;
    esac

    say "keel: configured $(basename "$PWD")"
    [ "$FORCE" -eq 1 ] && say "  (--force: detected values overwrote the existing profile)"
    say "  profile   .keel/profile.json"
    # Each line is skipped when the harness set has nothing to put in it, rather than printed with
    # an empty value. A codex-only repository has no context file of its own and no local config, so
    # unguarded these read "block      AGENTS.md" with a doubled space and "mode      :
    # bypassPermissions, not committed" with no path in front of the colon.
    say "  block     $(harness_each harness_context_file | sed 's/$/,/' | tr '\n' ' ')AGENTS.md"
    say "  docs      $root/"
    say "  plugins   $(harness_each harness_config_paths | sed -n 's/^committed|//p' | paste -sd' ' -)"
    say "  guards    $(harness_each harness_config_paths | sed -n 's/^committed|//p' | head -1) permissions: $(harness_each harness_permission_rules | grep -c "^deny|") deny, $(harness_each harness_permission_rules | grep -c "^ask|") ask"
    local _local_cfg; _local_cfg="$(harness_each harness_config_paths | sed -n 's/^local|//p')"
    [ -n "$_local_cfg" ] && say "  mode      $_local_cfg: bypassPermissions, not committed"
    # Anything a harness needs the person to do that keel cannot do for it. Open question 6 of
    # docs/architecture/tiered-multi-harness-support.md is the case this exists for: Codex runs no
    # hook until its source is trusted and says nothing when it skips one, so an install that says
    # nothing leaves every gate silently dark and looking installed. Printed here rather than left
    # to doctor because this is the moment the person is configuring the repository.
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
          fail\|*|warn\|*) say "  action    ${line#*|}" ;;
          *)               say "  note      ${line#*|}" ;;
        esac
    done < <(harness_each harness_doctor_findings install)

    local kind; kind="$(json_get .keel/profile.json project.kind || true)"
    local t; t="$(json_get .keel/profile.json verify.test || true)"
    # Not before there is code. doctor treats kind 'docs' as pre-implementation and says verify
    # commands are not expected there; init demanding one by hand answers the same state the
    # opposite way, and init is the message read first.
    [ -z "$t" ] && [ "$kind" != docs ] && say "  note: no test command was detected. Set verify.test and verify.test_one by hand; skills will ask otherwise, and the commit guard needs test_one."
    # gates.coding_standards defaults to required (FR-10, bin/keel#gates.coding_standards is a
    # promise about a document), so a fresh project fails doctor immediately unless something
    # already exists at $root/standards.md. Named here, at the moment the project is configured,
    # rather than only discovered later when doctor refuses to pass.
    if [ "$(json_get .keel/profile.json gates.coding_standards || true)" = required ] && [ ! -f "$root/standards.md" ]; then
        say "  action    gates.coding_standards is required and $root/standards.md does not exist yet. Run coding-standards to write it (seed mode, with no code yet to derive one from), or set the gate to warn or off."
    fi
    local pmn; pmn="$(json_get .keel/profile.json stack.package_manager || true)"
    # Deliberately not "then re-run with --force": --force re-detects, so it would discard the very
    # value this note asks for. The profile is the place to correct it, and init leaves it alone.
    [ -z "$pmn" ] && say "  note: more than one lockfile, so no package manager was assumed and the commands needing one are null. Set stack.package_manager and those commands in .keel/profile.json; init will not overwrite them."
    say ""
    # Where there is no code, repo-snapshot reads nothing and reports nothing. Found by running init
    # on an empty directory for a real greenfield project, which was then told to snapshot a
    # codebase that did not exist. The greenfield case is the one the pilot cares most about.
    if [ "$kind" = docs ]; then
        say "Next: run 'keel doctor', then try \"use shape-idea\" for a rough idea, or \"use write-prd\" where the requirements are already clear."
    else
        say "Next: run 'keel doctor', then try \"use repo-snapshot on this codebase\"."
    fi
    [ $team -eq 1 ] && stage_for_team "$root"
    return 0
}

# ---------------------------------------------------------------- profile

# Reading and correcting a profile fact after init.
#
# init writes the profile once and merge_profile then defends every human value in it, which is
# right for a re-init and wrong for a fact that has changed since. A project that turns out to
# have a user interface during design had no way to record it short of hand-editing JSON, and a
# tool that makes people hand-edit its own state file gets state that disagrees with itself.
#
# The path must already exist. A typo would otherwise write a key nothing reads, and the caller
# walks away believing the fact was recorded, which is worse than the refusal by exactly the
# amount of time it takes to notice.
profile_set() {
    python3 - "$1" "$2" "$HERE/templates/profile.schema.json" <<'PY'
import json, sys
path, raw = sys.argv[1], sys.argv[2]
p = ".keel/profile.json"
d = json.load(open(p))

if path.split(".")[0] in ("keel_version", "schema_version"):
    sys.stderr.write(
        "keel: %s is written by init, not by hand. keel_version records which keel configured "
        "this project; schema_version records which set of fields this file has, and doctor reads "
        "both.\n" % path.split(".")[0])
    sys.exit(1)

keys = path.split(".")
node = d
for k in keys[:-1]:
    if not isinstance(node, dict) or k not in node:
        sys.stderr.write("keel: no such field '%s' in .keel/profile.json.\n" % path)
        sys.exit(1)
    node = node[k]
if not isinstance(node, dict) or keys[-1] not in node:
    sys.stderr.write(
        "keel: no such field '%s' in .keel/profile.json. Add it there first if it is really "
        "new; a path that does not exist is far more often a typo.\n" % path)
    sys.exit(1)

# true, false and null are the JSON literals, never the strings that spell them. A profile
# holding "false" for stack.has_ui is truthy everywhere that reads it.
if   raw == "true":  val = True
elif raw == "false": val = False
elif raw == "null":  val = None
else:
    try:              val = int(raw)
    except ValueError: val = raw

# The schema's enums are the only record of which values a key accepts, and until this check a
# typo in a gate was written, accepted by doctor, and read as a weaker gate by every hook. A
# missing or unreadable schema skips the check rather than refusing every write: an install with
# no templates/ fails louder elsewhere. null is let through because `profile set <key> null` is the
# documented way to clear a value. Keys under gates.additionalProperties are not walked: a path
# the profile does not already hold is refused above, so such a key only arrives by hand edit.
try:
    s = json.load(open(sys.argv[3]))
except Exception:
    s = None
for k in keys:
    s = (s.get("properties") or {}).get(k) if isinstance(s, dict) else None
if isinstance(s, dict) and "enum" in s and val is not None and val not in s["enum"]:
    sys.stderr.write("keel: '%s' is not a value %s accepts. Use one of: %s.\n"
                     % (raw, path, ", ".join(str(e) for e in s["enum"])))
    sys.exit(1)

node[keys[-1]] = val
json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
PY
    # The refusals above are exit 1, and cmd_profile's caller reads that. Clearing the cache must
    # not swallow it, so the status is carried over the clear by hand.
    local rc=$?
    json_cache_clear
    return $rc
}

# A directory with nothing in it means the project has no documents of that kind, so the key stays
# null. Hidden entries do not count: a lone `.gitkeep` is how an empty directory is kept in git, and
# treating it as a document would record a set that does not exist.
#
# Neither does keel's own scaffolding. `init` writes <docs_root>/decisions/ADR-0000-template.md, so
# that directory is never empty on a freshly initialised project, and counting the template would
# set the key and make doctor warn on every new project before anyone had written anything. It is
# named rather than listed because it is the only file init puts inside a directory any key looks
# at, checked 2026-08-30. FR-06.
dir_has_file() {   # dir_has_file <dir>
    local d="$1" e
    [ -d "$d" ] || return 1
    for e in "$d"/*; do
        [ -e "$e" ] || continue
        case "${e##*/}" in ADR-0000-template.md) continue ;; esac
        return 0
    done
    return 1
}

# Fill the artifact keys whose default location is one unambiguous place and is really there.
#
# Three keys, not six. `prd`, `stories` and `architecture` default to `<docs_root>/<key>/<slug>.md`,
# one file per slug, and a repository with five PRDs has no single path to record. FR-03, FR-04.
#
# `json_get` rather than a fresh interpreter: json_load flattens the profile once and renders a null
# as an empty string, so a null key is a cache hit and costs no interpreter start.
profile_sync() {
    local root; root="$(docs_root)"
    local key path val filled=0
    for key in snapshot decisions plans; do
        # json_get separates the two cases this loop must not confuse: it returns zero with empty
        # output for a key that is present and null, and non-zero for a key the profile does not
        # have at all. The second is a profile older than the artifacts map, or a hand-written one,
        # and it is skipped rather than attempted: profile_set would refuse it with a message about
        # a typo the caller did not make, and abandon the keys after it. Found in review 2026-08-30.
        val="$(json_get .keel/profile.json "artifacts.$key" 2>/dev/null)" || continue
        [ -n "$val" ] && continue
        case "$key" in
          snapshot) path="$root/snapshot.md"; [ -f "$path" ] || continue ;;
          *)        path="$root/$key"; dir_has_file "$path" || continue ;;
        esac
        profile_set "artifacts.$key" "$path" || return 1
        say "  artifacts.$key -> $path"
        filled=$((filled+1))
    done
    [ "$filled" -eq 0 ] && say "  no artifact key changed"
    # Said every run, filled or not. These three default to <docs_root>/<key>/<slug>.md, one file
    # per slug, so there is no single path a string key could hold. Silence here reads as an
    # oversight and gets reported as a bug against a decision. FR-04.
    say "  prd, stories and architecture are skipped: each defaults to one file per slug under $root, so there is no single path to record"
    return 0
}

cmd_profile() {
    [ -f .keel/profile.json ] || die "no .keel/profile.json here. Run 'keel init'."
    have_python || die "python3 is absent, so the profile cannot be read or written safely."
    case "${1:-}" in
      get) [ -n "${2:-}" ] || die "usage: keel profile get <dotted.path>"
           json_get .keel/profile.json "$2" || die "no such field '$2' in .keel/profile.json" ;;
      set) { [ -n "${2:-}" ] && [ "$#" -ge 3 ]; } || die "usage: keel profile set <dotted.path> <value>"
           profile_set "$2" "$3" ;;
      sync) profile_sync ;;
      *)   die "unknown profile subcommand '${1:-}'. Try get, set or sync." ;;
    esac
}

# ---------------------------------------------------------------- new

# Set one profile field after init. `new` knows what it generated, so it states the verify command
# rather than leaving detection to infer one whose tool is not installed.
set_verify() {
    have_python || return 0
    python3 - "$1" "$2" <<'PY'
import json, sys
p = ".keel/profile.json"
d = json.load(open(p))
d["verify"][sys.argv[1]] = sys.argv[2] if sys.argv[2] else None
json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
PY
    local rc=$?
    json_cache_clear
    return $rc
}

# A skeleton whose test command runs with nothing installed. That is the whole constraint here: a
# generated project must pass its own doctor, or the greenfield path hands someone a broken project
# on their first minute.
scaffold_stack() {
    case "$1" in
      node)
        cat > package.json <<'P'
{
  "name": "PROJECT_NAME",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test"
  }
}
P
        sed -i.bak "s/PROJECT_NAME/$(basename "$PWD")/" package.json && rm -f package.json.bak
        mkdir -p src test
        cat > src/index.js <<'P'
// Replace this. The point of the sample is that `npm test` passes from the first minute, so
// `keel doctor` is green and the first real test has somewhere to go.
export function add(a, b) {
    return a + b;
}
P
        cat > test/index.test.js <<'P'
import { test } from "node:test";
import assert from "node:assert/strict";
import { add } from "../src/index.js";

// Uses node:test, so the suite runs with nothing installed. Swap in your own runner when you add
// one, and update verify.test in .keel/profile.json to match.
test("adds two numbers", () => {
    assert.equal(add(2, 3), 5);
});
P
        printf 'node_modules/\ndist/\n' > .gitignore
        ;;
      python)
        cat > pyproject.toml <<'P'
[project]
name = "PROJECT_NAME"
version = "0.1.0"
requires-python = ">=3.11"
P
        sed -i.bak "s/PROJECT_NAME/$(basename "$PWD" | tr '-' '_')/" pyproject.toml && rm -f pyproject.toml.bak
        mkdir -p src tests
        cat > src/__init__.py <<'P'
def add(a, b):
    return a + b
P
        cat > tests/test_add.py <<'P'
import unittest
import sys, pathlib
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from src import add


# Uses unittest from the standard library, so the suite runs with nothing installed. Switch to
# pytest when you add it, and update verify.test in .keel/profile.json to match.
class TestAdd(unittest.TestCase):
    def test_adds(self):
        self.assertEqual(add(2, 3), 5)
P
        printf '__pycache__/\n.venv/\n*.egg-info/\n' > .gitignore
        ;;
      go)
        printf 'module %s\n\ngo 1.22\n' "$(basename "$PWD")" > go.mod
        cat > main.go <<'P'
package main

import "fmt"

func Add(a, b int) int { return a + b }

func main() { fmt.Println(Add(2, 3)) }
P
        cat > main_test.go <<'P'
package main

import "testing"

func TestAdd(t *testing.T) {
	if got := Add(2, 3); got != 5 {
		t.Fatalf("Add(2, 3) = %d, want 5", got)
	}
}
P
        printf 'bin/\n' > .gitignore
        ;;
      *)
        mkdir -p tests
        cat > tests/test.sh <<'P'
#!/usr/bin/env bash
# Replace this. It exists so `keel doctor` is green from the first minute.
set -euo pipefail
printf 'ok  placeholder test\n'
P
        chmod +x tests/test.sh
        ;;
    esac
    # apex-targets.json holds database passwords, and apex-capture/ holds application source before
    # the credential scrubber has run over it. Both are ignored before either can exist, because a
    # secret is only ever ignored in time once.
    printf '.env\n.env.*\n!.env.example\n*.pem\n*.key\n*.pfx\n*.p12\n*.jks\n' >> .gitignore
    printf '.keel/apex-targets.json\napex-capture/\n' >> .gitignore
}

# Strict type checking on (skills/coding-standards/references/house-defaults.md, "Types and
# tooling") is the one house rule the compiler holds for a TypeScript project, so init sets it
# where tsconfig.json has not decided. A strict the project set, to either value, is its decision
# and stays. A file this cannot parse (a comment, a trailing comma) is left byte identical and said
# so: the posture merge_permissions_into_settings takes toward .claude/settings.json. One
# interpreter start, only on a typescript project with a tsconfig.json.
merge_ts_strict() {
    [ "$(json_get .keel/profile.json stack.language || true)" = typescript ] || return 0
    [ -f tsconfig.json ] || return 0
    have_python || { err "python3 absent: could not set compilerOptions.strict in tsconfig.json. Set it by hand."; return 0; }
    python3 - <<'PY' || true
import json
p = "tsconfig.json"
try:
    d = json.load(open(p))
    if not isinstance(d, dict):
        raise ValueError("top level is not an object")
except Exception as e:
    raise SystemExit("keel: %s could not be parsed (%s), so compilerOptions.strict was not set. Set it by hand." % (p, e))
opts = d.setdefault("compilerOptions", {})
if not isinstance(opts, dict):
    raise SystemExit("keel: %s could not be parsed (compilerOptions is not an object), so compilerOptions.strict was not set. Set it by hand." % p)
if "strict" in opts:
    raise SystemExit(0)
if "extends" in d:
    raise SystemExit(0)
opts["strict"] = True
json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
print("  set compilerOptions.strict to true in tsconfig.json (house rule: strict type checking on)")
PY
}

write_ci() {
    mkdir -p .github/workflows
    # Fill the cache here, in this shell, so every json_get below, run inside a $( ), inherits it
    # full instead of each re-parsing the profile on its own. Same shape and same reason as the
    # json_load call in write_profile's caller. Not redundant.
    json_load .keel/profile.json || true
    local lang; lang="$(json_get .keel/profile.json stack.language || true)"
    local test_cmd; test_cmd="$(json_get .keel/profile.json verify.test || true)"
    # The trigger branch is the profile's, not an assumption. Hardcoding main meant a master
    # repository's CI never ran on a push to its default branch. The fallback is default_branch,
    # not main, because without python3 json_get comes back empty while write_profile recorded the
    # branch from default_branch with printf.
    local branch; branch="$(json_get .keel/profile.json conventions.default_branch || true)"
    local sec; sec="$(json_get .keel/profile.json verify.security || true)"
    # house-defaults.md, "Dependencies": an advisory scan runs in CI and fails the build on a high
    # severity finding. Keyed on the package manager, because `npm audit` in a pnpm project fails for
    # the wrong reason. Computed here rather than inside the block below, because a `say` in there
    # would land in the workflow file. FR-06, docs/prd/coding-standards-enforcement.md.
    local pm audit; pm="$(json_get .keel/profile.json stack.package_manager || true)"
    case "$pm" in
      npm)  audit='npm audit --audit-level=high' ;;
      pnpm) audit='pnpm audit --audit-level high' ;;
      yarn) audit='yarn npm audit --severity high' ;;
      pip)  if [ -f requirements.txt ]; then audit='pip install pip-audit && pip-audit -r requirements.txt'
            else audit='pip install pip-audit && pip-audit'; fi ;;
      *)    audit="" ;;
    esac
    CI_AUDIT_SKIPPED=""
    [ -n "$audit" ] || CI_AUDIT_SKIPPED="${pm:-none declared}"
    {
      printf 'name: CI\n\non:\n  push:\n    branches: [%s]\n  pull_request:\n\njobs:\n' "${branch:-$(default_branch)}"
      printf '  verify:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n'
      case "$lang" in
        javascript|typescript) printf '      - uses: actions/setup-node@v4\n        with:\n          node-version: "20"\n' ;;
        python)                printf '      - uses: actions/setup-python@v5\n        with:\n          python-version: "3.11"\n' ;;
        go)                    printf '      - uses: actions/setup-go@v5\n        with:\n          go-version: "1.22"\n' ;;
      esac
      # No continue-on-error. A test step that cannot fail the build is documentation.
      printf '\n      - name: Test\n        run: %s\n' "${test_cmd:-echo 'no test command in .keel/profile.json'}"
      # Every other verify command that is a real, runnable string: every key in VERIFY_KEYS except
      # test (already its own step above), test_one and test_affected (templates: {path} or {name},
      # and {base}, which only a tdd unit has; leaving test_affected out leaves CI running the whole
      # suite, wider and not narrower) and format_fix (rewrites files rather than checking them).
      local k c
      for k in $VERIFY_KEYS; do
          case "$k" in test|test_one|test_affected|format_fix) continue ;; esac
          c="$(json_get .keel/profile.json "verify.$k" || true)"
          [ -n "$c" ] || continue
          printf '\n      - name: %s\n        run: %s\n' "$k" "$c"
      done
      # Skipped only when verify.security is this same audit, which the loop above already wrote as
      # a step and which would otherwise run twice and fail twice. A different security command,
      # such as a code scanner, does not replace the dependency audit.
      [ -n "$audit" ] && [ "$sec" != "$audit" ] && printf '\n      - name: Audit dependencies\n        run: %s\n' "$audit"
      printf '\n      - name: Refuse committed key material\n        run: |\n'
      printf '          if git ls-files | grep -qE "\\.(pem|key|pfx|p12|jks)$|^\\.env$"; then\n'
      printf '            echo "::error::key material is tracked in git"; git ls-files | grep -E "\\.(pem|key|pfx|p12|jks)$|^\\.env$"; exit 1\n'
      printf '          fi\n'
    } > .github/workflows/ci.yml
}

cmd_new() {
    local name="${1:-}" stack=minimal
    shift || true
    for a in "$@"; do case "$a" in --stack=*) stack="${a#--stack=}" ;; --stack) shift; stack="${1:-minimal}" ;; esac; done
    # Handle `--stack node` given as two words.
    local prev=""; for a in "$@"; do [ "$prev" = "--stack" ] && stack="$a"; prev="$a"; done

    [ -n "$name" ] || die "usage: keel new <name> [--stack node|python|go|minimal]"
    case "$stack" in node|python|go|minimal) : ;; *) die "unknown stack '$stack'. Use node, python, go, or minimal." ;; esac

    if [ -e "$name" ] && [ -n "$(ls -A "$name" 2>/dev/null)" ]; then
        err "'$name' exists and is not empty, so keel new will not write into it."
        err "For an existing directory, including one that holds only planning documents:"
        err "  cd $name && keel init"
        exit 1
    fi

    mkdir -p "$name" && cd "$name" || die "could not create '$name'"
    git init -q -b main . 2>/dev/null || die "git init failed"

    scaffold_stack "$stack"

    FORCE=0
    local root="$DEFAULT_DOCS_ROOT"
    write_profile "$root"

    # `new` states the test command rather than letting detection infer one whose tool is absent.
    case "$stack" in
      python)  set_verify test "python3 -m unittest discover -s tests -q"
               set_verify test_one "python3 -m unittest tests.{name} -q" ;;
      minimal) set_verify test "tests/test.sh"; set_verify test_one "tests/test.sh" ;;
    esac

    local block; block="$(mktemp)"
    render_block "$block" "$root"
    for _ctx in $(harness_each harness_context_file); do merge_block "$_ctx" "$block"; done
    merge_block AGENTS.md "$block"
    rm -f "$block"
    scaffold_docs "$root"
    harness_each harness_write_config "$root"
    harness_each harness_write_local_config "$root"
    ignore_local_state
    write_ci

    cat > "$root/NEXT-STEPS.md" <<'N'
# Next steps

This project was created by `keel new`. It has the keel layer, a passing sample test, and CI
that fails on a broken build. It has no product yet, and that is deliberate.

**Start here, not with code:**

1. `use coding-standards` in seed mode to write a starting `docs/standards.md` from the house
   defaults. There is no code yet to derive one from, and `gates.coding_standards` is required by
   default, so `keel doctor` will not pass without it.
2. `use write-prd` and answer its questions. It will not let you skip to implementation, which is
   the point: the decisions that are expensive to reverse are made now, cheaply.
3. `use write-user-stories` once the PRD is approved.
4. `use design-architecture` for the stack and the structure. The sample skeleton is a placeholder,
   not a recommendation.
5. `use write-plan`, then `use execute-plan`.

**Before the first real commit:** replace the sample test and update `verify.test` in
`.keel/profile.json` if you change the runner. Run `keel doctor` to confirm it still passes.
N

    git add -A >/dev/null 2>&1
    git -c user.name="keel" -c user.email="keel@local" commit -q -m "chore: initialise $name with keel" >/dev/null 2>&1       || git commit -q -m "chore: initialise $name with keel" >/dev/null 2>&1 || true

    say "keel: created $name ($stack)"
    say "  profile   .keel/profile.json"
    say "  docs      $root/  (start with NEXT-STEPS.md)"
    say "  ci        .github/workflows/ci.yml"
    say "  action    gates.coding_standards is required and $root/standards.md does not exist yet. Run coding-standards to write it (seed mode, with no code yet to derive one from), or set the gate to warn or off."
    say ""
    say "Next: cd $name && use coding-standards, then \"use write-prd\"."
    return 0
}

# ---------------------------------------------------------------- doctor

# Dispatches to the real checker. --json captures its human-readable stdout (the FAIL/WARN/ok
# lines already used throughout, and nothing else prints to fd 1 there) and reshapes it into one
# JSON document, so `doctor --fast` in a fleet script has something a machine can read without a
# fleet's worth of scraping.
cmd_doctor() {
    local a json=0
    for a in "$@"; do case "$a" in --json) json=1 ;; esac; done
    if [ "$json" -eq 0 ]; then
        cmd_doctor_text "$@"
        return $?
    fi

    have_python \
      || { err "keel doctor --json: python3 is required to build this output and was not found"; return 1; }

    local text rc
    text="$(cmd_doctor_text "$@")"
    rc=$?

    # Fill the cache here, in this shell, so every json_get below, run inside a $( ), inherits it
    # full instead of each re-parsing the profile on its own. Same shape and same reason as the
    # json_load call in write_ci. Not redundant.
    json_load .keel/profile.json || true
    local sv kv vt
    sv="$(json_get .keel/profile.json schema_version 2>/dev/null || true)"
    kv="$(json_get .keel/profile.json keel_version 2>/dev/null || true)"
    vt="$(json_get .keel/profile.json verify.test 2>/dev/null || true)"

    python3 - "$sv" "$kv" "$vt" "$text" <<'PY'
import json, re, sys

schema_version, keel_version, verify_test, text = sys.argv[1:5]

# The profile's harnesses array, verbatim. json_get cannot hand a list over cleanly, so read the
# file here. Anything but a list of strings (absent, older schema, hand-edited) is reported as [].
try:
    h = json.load(open(".keel/profile.json")).get("harnesses")
    harnesses = h if isinstance(h, list) and all(isinstance(x, str) for x in h) else []
except Exception:
    harnesses = []

findings = []
problems = warnings = 0
for line in text.splitlines():
    m = re.match(r'^(FAIL|WARN|ok)\s+(.*)$', line)
    if not m:
        continue
    level_raw, message = m.group(1), m.group(2)
    level = {"FAIL": "fail", "WARN": "warn", "ok": "ok"}[level_raw]
    if level == "fail":
        problems += 1
    elif level == "warn":
        warnings += 1
    findings.append({"level": level, "message": message})

print(json.dumps({
    "schema_version": int(schema_version) if schema_version.isdigit() else None,
    "keel_version": keel_version or None,
    "harnesses": harnesses,
    "verify_test_null": verify_test == "",
    "problems": problems,
    "warnings": warnings,
    "findings": findings,
}))
PY
    return "$rc"
}

cmd_doctor_text() {
    local problems=0 warnings=0 fast=0 a
    # --fast checks every field and runs none of them. verify.test here is routinely the whole
    # suite, so the honest check costs what the suite costs, and a check nobody can afford to run
    # before a commit is one they stop running at all. Unknown flags are ignored, as in cmd_init.
    for a in "$@"; do case "$a" in --fast) fast=1 ;; esac; done
    # Each returns 0 explicitly. The `condition && good || fail` idiom below depends on it: without
    # a guaranteed 0 from good, a failing good would also run fail. Stating it beats assuming it.
    fail() { printf 'FAIL  %s\n' "$1"; problems=$((problems+1)); return 0; }
    warn() { printf 'WARN  %s\n' "$1"; warnings=$((warnings+1)); return 0; }
    good() { printf 'ok    %s\n' "$1"; return 0; }

    # One harness section, printed here so this file keeps the ordering and the counters and the
    # harness file keeps the knowledge. The loop runs in this shell, not the subshell, so fail and
    # warn increment what they are meant to increment. Splitting on the first pipe alone, because a
    # message may contain one and a level never does.
    harness_section() {   # harness_section <phase>
        local line
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            case "$line" in
              fail\|*) fail "${line#fail|}" ;;
              warn\|*) warn "${line#warn|}" ;;
              ok\|*)   good "${line#ok|}" ;;
            esac
        done < <(harness_each harness_doctor_findings "$1")
    }

    [ -f .keel/profile.json ] || { fail "no .keel/profile.json. Run 'keel init'."; return 1; }
    if have_python; then
        local profile_out profile_err enum_line
        # One interpreter start parses the profile and checks its enum values against the schema,
        # because doctor's python3 starts are budgeted ("keel doctor starts python3 at most 10
        # times" in tests/test-keel.sh). Enum findings come back on stdout prefixed enum|, a schema
        # it could not read as one line prefixed noschema| (a WARN, since the profile parsed and
        # only the check could not run), and anything else is the parse error. An out-of-enum
        # value is a FAIL and not a WARN: whatever reads a gate treats a value it does not
        # recognise as a weaker one (hooks/done-guard treats it as warn), so the file reads as
        # configured while enforcing less.
        profile_out="$(python3 - "$HERE/templates/profile.schema.json" 2>&1 <<'PY'
import json, sys
prof = json.load(open(".keel/profile.json"))
try:
    schema = json.load(open(sys.argv[1]))
except Exception:
    print("noschema|the profile schema at %s could not be read, so profile values were not "
          "checked against it" % sys.argv[1])
    sys.exit(0)
def walk(s, p, path):
    for k, sub in (s.get("properties") or {}).items():
        if not isinstance(p, dict) or k not in p or not isinstance(sub, dict):
            continue
        v, here = p[k], path + [k]
        if "enum" in sub and v is not None and v not in sub["enum"]:
            gate = ", and for a gate that means a weaker one" if here[0] == "gates" else ""
            print("enum|%s is %r, which is not one of %s. keel does not recognise it%s. Fix it "
                  "with: keel profile set %s <value>" % (".".join(here), v,
                  ", ".join(str(e) for e in sub["enum"]), gate, ".".join(here)))
        if isinstance(v, dict):
            walk(sub, v, here)
walk(schema, prof, [])
PY
)"
        profile_err="$(printf '%s\n' "$profile_out" | grep -v -e '^enum|' -e '^noschema|' || true)"
        if [ -z "$profile_err" ]; then
            good "profile parses"
            while IFS= read -r enum_line; do
                case "$enum_line" in
                  enum\|*)     fail "${enum_line#enum|}" ;;
                  noschema\|*) warn "${enum_line#noschema|}" ;;
                esac
            done <<< "$profile_out"
        else
            # have_python already proved python3 runs, so a failure here is either the JSON itself
            # (json.load raises json.decoder.JSONDecodeError) or something else python3 hit trying
            # to read it. Folding both into "not valid JSON" sent people to edit a file that was
            # fine.
            case "$profile_err" in
              *JSONDecodeError*) fail "profile is not valid JSON: $profile_err" ;;
              *) fail "python3 could not check the profile: $profile_err" ;;
            esac
            return 1
        fi
    else
        warn "python3 absent: cannot validate the profile or read its fields"
    fi
    json_load .keel/profile.json || true
    harness_set_load

    # The harness section. ADR-0004: a guarantee is a property of (repository, harness), so this
    # answers for the harness in front of the person and names what the others do not get.
    #
    # It is printed before everything below it because it says which of the answers below apply.
    local running trust active harnesses h g
    running="$(harness_running)"
    if [ "$running" = unknown ]; then
        warn "cannot determine which harness is running, so this reports on every harness this repository serves"
        harnesses="$HARNESS_SET"
    else
        good "running under $running"
        harnesses="$running"
    fi
    for h in $harnesses; do
        # Trailing space stripped: the list sits mid-sentence in the two warnings below, and
        # `tr` leaves one before the full stop.
        active="$(harness_active_gates "$h" | tr '\n' ' ')"; active="${active% }"
        trust="$(harness_hooks_trusted "$h")"
        case "$trust" in
          # No "gates active" line beside either of these. Two lines, one calling the gates live and
          # one calling them dark, is worse than either alone.
          untrusted)
            warn "$h will run none of keel's hooks here until you have trusted them, so these gates are dark: ${active:-none}. The skills load without that trust and the hooks do not, so keel looks installed and is not. That trust lives in your own $h configuration and keel cannot grant it." ;;
          unknown)
            warn "$h gates the manifest grants: ${active:-none}. keel cannot tell from your $h configuration whether the hooks behind them will run on this machine, so treat none of them as proven here." ;;
          *)
            good "$h gates active: ${active:-none}" ;;
        esac
        for g in $(harness_gates); do
            harness_gate_active "$h" "$g" || warn "$h does not get $g"
        done
    done
    # A repository declaring hard_block_paths and serving a harness with no ask is protected for
    # some of the people working in it and not others.
    if grep -q '"hard_block_paths"' .keel/profile.json 2>/dev/null; then
        for h in $HARNESS_SET; do
            harness_provides "$h" pretooluse_ask \
              || warn "this repository declares hard_block_paths, which is not enforced for its $h users"
        done
    fi
    # A harness installed here that the repository does not list. A machine fact, so it belongs in
    # doctor and never in init, which writes a committed team fact.
    command -v codex >/dev/null 2>&1 && ! grep -qx codex <<< "$HARNESS_SET" \
      && warn "codex is installed on this machine but this repository does not list it in harnesses"

    local root; root="$(docs_root)"
    check_docs_ignored "$root" && good "docs root '$root' is not gitignored" \
      || fail "docs root '$root' is ignored by git (see stderr for how to fix)"
    [ -d "$root" ] && good "docs root exists" || fail "docs root '$root' is missing. Run 'keel init'."

    # Every document the repository points at has to be one a fresh clone can open.
    local refs=0 sev msg
    while IFS="$(printf '\t')" read -r sev msg; do
        [ -n "$msg" ] || continue
        refs=$((refs+1))
        case "$sev" in fail) fail "$msg" ;; warn) warn "$msg" ;; esac
    done < <(referenced_docs_findings "$root")
    [ "$refs" -eq 0 ] && good "every referenced document is in HEAD" || true

    for f in $(harness_each harness_context_file) AGENTS.md; do
        check_markers "$f"; local rc=$?
        case $rc in
          0) [ -f "$f" ] && good "$f markers intact" || warn "$f is absent" ;;
          2) fail "$f has duplicate keel markers" ;;
          3) fail "$f has an unbalanced keel marker" ;;
        esac
    done

    # The managed block's size, which doc 05 has always said doctor enforces and doctor did not.
    # It sits in the prefix of every request in this repository forever, so a line added here is not
    # paid once, it is paid per request per engineer. Target 450 tokens, ceiling 700.
    #
    harness_section context-block

    # Every verify command must actually run. This is the check that catches a profile naming a
    # path that does not exist, which otherwise surfaces as a pipeline failure blamed on CI.
    local kind; kind="$(json_get .keel/profile.json project.kind || echo service)"
    if [ "$kind" = "docs" ]; then
        good "project kind is 'docs': pre-implementation, so verify commands are not expected"
        warn "set project.kind to 'service' once there is code, so the verify checks apply again"
    fi

    # Any artifact mapped to a path must exist, or a skill will read nothing and author a duplicate.
    if have_python; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            local key path; key="${line%%=*}"; path="${line#*=}"
            [ -e "$path" ] && good "artifacts.$key -> $path" \
              || fail "artifacts.$key points at '$path', which does not exist"
        done < <(python3 -c "
import json
d=json.load(open('.keel/profile.json')).get('artifacts',{})
for k,v in d.items():
    if k.startswith('_') or not v: continue
    print(f'{k}={v}')
" 2>/dev/null | tr -d '\r')
    fi

    # The other half of the map: a key that is null while its default is sitting there. The profile
    # does not know about a document the repository has, and a skill reading the map gets the
    # fallback. A warning and never a failure, because nothing is broken.
    #
    # The same three keys `profile sync` fills, and no more. prd, stories and architecture default
    # to one file per slug, so sync will not fill them by decision, and naming a remedy that does
    # nothing for them is worse than saying nothing. FR-10, FR-11.
    #
    # json_get answers from json_load's flat cache, where a null renders as an empty string, so this
    # loop adds no interpreter start to the budget asserted in tests/test-keel.sh.
    if have_python; then
        local akey apath
        for akey in snapshot decisions plans; do
            [ -n "$(json_get .keel/profile.json "artifacts.$akey" 2>/dev/null || true)" ] && continue
            case "$akey" in
              snapshot) apath="$root/snapshot.md"; [ -f "$apath" ] || continue ;;
              *)        apath="$root/$akey"; dir_has_file "$apath" || continue ;;
            esac
            warn "artifacts.$akey is null but '$apath' exists, so the profile does not know about it. Record it with: keel profile sync"
        done
    fi

    # gates.coding_standards is a promise about a document. required with no <docs_root>/standards.md
    # is indistinguishable from off, and it is the one state in which the key reads as configured
    # while enforcing nothing, so it fails rather than warns. json_get answers from the cache: no
    # interpreter start. FR-10, docs/prd/coding-standards-enforcement.md.
    local cs; cs="$(json_get .keel/profile.json gates.coding_standards 2>/dev/null || true)"
    if [ "$cs" = required ]; then
        [ -f "$root/standards.md" ] && good "gates.coding_standards is required and $root/standards.md exists" \
          || fail "gates.coding_standards is required and $root/standards.md does not exist. Write it with coding-standards, or set the gate to warn or off"
    fi

    # The push guard is the only thing that enforces protect_default_branch outside a session, and
    # init does not install it, so without this line nothing tells anyone it is off. A WARN, not a
    # FAIL: installing it writes into the developer's git directory, which stays their choice. It
    # reads the key as the hook does, the same sed and the same `!= false`, so it reports the guard
    # wherever the hook would enforce, the key absent or not a boolean included.
    local pdb; pdb="$(sed -n 's/.*"protect_default_branch": *\([a-z]*\).*/\1/p' .keel/profile.json 2>/dev/null | head -1)"
    if [ "$pdb" != "false" ] && git rev-parse --git-dir >/dev/null 2>&1; then
        # The same state `keel guard status` reports, so the two never disagree. The absent and
        # legacy states are sent to guard install, which installs or moves the guard; the foreign
        # ones are not, because install refuses them: running it there would switch another tool's
        # hooks off. A legacy install beside hooks keel did not write is refused too, until those
        # hooks are moved, so that line names them instead.
        local lo
        case "$(guard_state)" in
          installed)
            good "push guard installed: a push to the default branch is refused outside a session too" ;;
          legacy)
            lo="$(guard_legacy_others)"
            if [ -n "$lo" ]; then
                warn "the push guard is installed in $GUARD_LEGACY_DIR/, a working-tree path, so checking out a branch runs that branch's own hooks. $GUARD_LEGACY_DIR/ also holds $lo, hooks keel did not write: move them into $(guard_dir) or remove them before keel guard install can move the guard"
            else
                warn "the push guard is installed in $GUARD_LEGACY_DIR/, a working-tree path, so checking out a branch runs that branch's own hooks. Run: keel guard install, which moves it into $(guard_dir)"
            fi ;;
          foreign-path)
            warn "conventions.protect_default_branch is not false and the push guard is not installed: core.hooksPath, which keel did not set, is $(guard_hooks_path_source), and keel guard install refuses to replace it" ;;
          foreign-hook)
            warn "conventions.protect_default_branch is not false and the push guard is not installed: $(guard_dir)/$(guard_foreign_hook) is another tool's hook, which keel guard install will not overwrite" ;;
          *)
            warn "conventions.protect_default_branch is not false and the push guard is not installed, so nothing outside a session enforces it. Run: keel guard install" ;;
        esac
    fi

    if [ "$kind" != "docs" ] && have_python; then
        # A missing test_one is an oversight when there are tests to run, and it is required then.
        # With verify.test null as well the project declares no tests at all, and failing on the
        # derived field points at the wrong thing: the root cause is one line below, as a warning.
        local t1 t0
        t1="$(json_get .keel/profile.json verify.test_one || true)"
        t0="$(json_get .keel/profile.json verify.test || true)"
        if [ -n "$t1" ]; then good "verify.test_one is set"
        elif [ -z "$t0" ]; then warn "verify.test_one is null, and so is verify.test: this project declares no tests"
        else fail "verify.test_one is null. It is required: the commit guard and tdd both need it."
        fi
        # Reads a key that a profile from before schema 6 (SCHEMA_VERSION=5 and earlier) lacks.
        # json_get answers an absent key only after an interpreter start, and doctor's starts are
        # budgeted ("keel doctor starts python3 at most 10 times" in tests/test-keel.sh), so this
        # answers from the cache, which holds a null as a line with an empty value and so tells a
        # key that is present and null from one that is absent. Status 1 means absent. A key the
        # cache lacks but the file names is a value spanning lines, which the flattener leaves
        # out, and only that case falls through to json_get.
        json_declared() {   # json_declared <file> <dotted.path>
            local line
            json_load "$1" || { json_get "$1" "$2"; return; }
            while IFS= read -r line; do
                case "$line" in
                  "$2="*) printf '%s\n' "${line#*=}"; return 0 ;;
                esac
            done <<< "$JSON_CACHE"
            grep -qF "\"${2##*.}\"" "$1" 2>/dev/null || return 1
            json_get "$1" "$2"
        }

        # verify.test_affected, read once for the suite-time note below and for its own line after
        # the loop. Trimmed, because the same-command comparison below treats `sleep 2 ` as
        # `sleep 2`, and a value of spaces alone declares nothing.
        local ta; ta="$(json_declared .keel/profile.json verify.test_affected || true)"
        ta="${ta#"${ta%%[![:space:]]*}"}"; ta="${ta%"${ta##*[![:space:]]}"}"

        # What a passing verify.test run's time means, said after the "runs" line and only then: a
        # run that failed or timed out has a time that says nothing, and its own line says what went
        # wrong. tdd runs verify.test at every unit boundary, so a suite over the threshold is paid
        # once per unit, and ten units is the size of change that multiplies it.
        #
        # keel init writes gates.suite_warn_seconds as 60 so that `keel profile set` can reach it,
        # which refuses a path the profile does not hold; an absent key still reads as 60, for a
        # profile from before schema 6. Arguments: the seconds, the verify.test command that ran,
        # and verify.test_affected.
        suite_cost_note() {
            local el="$1" tc="$2" tcn thr=60 sw sw_rc=0 digits shown mins cost
            sw="$(json_declared .keel/profile.json gates.suite_warn_seconds)" || sw_rc=$?
            if [ "$sw_rc" -eq 0 ]; then
                # Present is decided by the key being there, not by its text being empty. A present
                # null is what someone writes to switch the warning off, and reading it as the
                # default without a word would leave them believing it worked. Only an absent key
                # is 60 without a word.
                sw="${sw//$'\n'/ }"
                digits=""
                case "$sw" in
                  ''|*[!0-9]*) ;;
                  # Zeros off the front: a string of digits is a number, "090" is 90, and bash
                  # would read it as octal and refuse it.
                  *) digits="${sw#"${sw%%[!0]*}"}" ;;
                esac
                # At most nine digits, so no comparison below can overflow. The message names the
                # range, because a ten digit number is whole and "not a whole number" would be
                # false.
                if [ -n "$digits" ] && [ "${#digits}" -le 9 ]; then
                    thr="$digits"
                else
                    case "$sw" in
                      '')       shown="null or empty" ;;
                      *[!0-9]*) shown="'$sw'" ;;
                      *)        shown="$sw" ;;
                    esac
                    warn "gates.suite_warn_seconds is $shown, which is not a whole number from 1 to 999999999, so 60 was used. Set it with: keel profile set gates.suite_warn_seconds <seconds>"
                fi
            fi
            # Exclusive: a run exactly at the threshold is within it. No real run lands on the
            # boundary reliably, so no test can pin this; it is read here.
            [ "$el" -gt "$thr" ] || return 0
            tcn="${tc#"${tc%%[![:space:]]*}"}"; tcn="${tcn%"${tcn##*[![:space:]]}"}"
            # The minutes ten units spend: (seconds * 10 + 30) / 60, rounded to the nearest whole
            # minute. Nothing under a minute is worth a number.
            mins=$(( (el * 10 + 30) / 60 ))
            case "$mins" in
              0) cost="under a minute" ;;
              1) cost="about 1 minute" ;;
              *) cost="about $mins minutes" ;;
            esac
            if [ -n "$3" ] && [ "$3" != "$tcn" ]; then
                good "verify.test takes ${el}s, over ${thr}s; tdd runs verify.test_affected at unit boundaries instead, so the suite runs once at the start of each task, in review-code, ship and CI"
            elif [ -n "$3" ]; then
                # The same command saves nothing: the boundary would run the whole suite either way.
                warn "verify.test took ${el}s, over gates.suite_warn_seconds (${thr}s): tdd runs it at every unit boundary, so ten units spend $cost in it. verify.test_affected is set, but to the same command as verify.test, so it saves nothing. Give it a command that selects the tests a change affects, or raise gates.suite_warn_seconds if ${el}s is this suite's honest cost."
            else
                warn "verify.test took ${el}s, over gates.suite_warn_seconds (${thr}s): tdd runs it at every unit boundary, so ten units spend $cost in it. Set verify.test_affected, or raise gates.suite_warn_seconds if ${el}s is this suite's honest cost."
            fi
        }

        # security runs here, in full doctor, by decision on 2026-09-25: it reaches the network,
        # and --fast, which never executes a verify command, is the offline form.
        for k in test lint typecheck build security; do
            local c; c="$(json_get .keel/profile.json "verify.$k" || true)"
            if [ -z "$c" ]; then
                # A null security is ok and not a warning. keel detects one only from an npm, pnpm
                # or yarn 2+ lockfile, so a warning would fire on every other project and no keel
                # command could clear it.
                if [ "$k" = security ]; then
                    good "verify.security is null: keel detects one only from an npm, pnpm or yarn 2+ lockfile, so set it if this project has another"
                else
                    warn "verify.$k is null"
                fi
                continue
            fi
            case "$c" in *"{path}"*|*"{name}"*) good "verify.$k set (templated, not run)"; continue ;; esac
            [ "$fast" -eq 1 ] && { good "verify.$k set (not run, --fast)"; continue; }
            # Said before it runs, not after. Output is discarded, so a suite taking eleven minutes
            # is indistinguishable from a hang unless doctor names what it is waiting on.
            printf '..... verify.%s: running: %s\n' "$k" "$c"
            local t0 el rc
            t0=$SECONDS
            if [ -n "$TIMEOUT_BIN" ]; then
                # `bash -c`, because timeout takes a command and not a shell string, and these are
                # shell strings: keel writes `test -z "$(gofmt -l .)"` itself.
                "$TIMEOUT_BIN" "$VERIFY_TIMEOUT" bash -c "$c" >/dev/null 2>&1
            else
                ( eval "$c" ) >/dev/null 2>&1
            fi
            rc=$?
            el=$(( SECONDS - t0 ))
            if [ "$rc" -eq 0 ]; then
                good "verify.$k runs (${el}s): $c"
                if [ "$k" = test ]; then suite_cost_note "$el" "$c" "$ta"; fi
            elif [ -n "$TIMEOUT_BIN" ] && [ "$rc" -eq 124 ]; then
                fail "verify.$k timed out after ${VERIFY_TIMEOUT}s: $c. Either it hangs, or it needs longer than doctor is willing to wait; run it by hand to tell the two apart."
            elif [ "$k" = security ]; then
                # An audit exits non-zero on a finding at or above its threshold and when it cannot
                # reach its registry, so "does not run" would send the reader to debug a command that
                # ran. Its output is discarded like every verify command's, so the line says how to
                # tell the two apart.
                fail "verify.security exited $rc (${el}s): $c. An audit exits non-zero on a finding at or above its threshold and when it cannot reach its registry; run it to see which"
            else fail "verify.$k does not run (${el}s): $c"; fi
        done

        # Declared and never run, which is the honest treatment for e2e: it needs a running system
        # by its own description, so running it here would make doctor cost what a deployment
        # costs. security was declared here too until 2026-09-25, when init began detecting it and
        # it moved to the loop above.
        #
        # null is `ok` and not a warning. e2e's detector fires only on a node `test:e2e` script, so
        # init writes null into effectively every profile. A warning here would fire on every
        # project keel has ever made, would be clearable by no keel command, and is the required
        # value on Dart per that stack's own FR-14. "does not detect", present tense, is a claim
        # about this project rather than about what keel can do.
        local dc; dc="$(json_get .keel/profile.json verify.e2e || true)"
        if [ -z "$dc" ]; then good "verify.e2e is null: keel does not detect one, so set it if this project has one"
        else good "verify.e2e is set (declared, not run): $dc"
        fi

        # verify.test_affected is declared and never run either, under --fast too, because naming it
        # costs nothing. Running it bare would run a literal {base}: the commit is the one a tdd
        # unit's start record names, and doctor has no unit. A value without {base} is accepted, for
        # a runner that tracks changes itself. null is `ok` and not a warning, for e2e's reason:
        # init writes null into every profile and keel detects no runner, so a warning would fire
        # on every project and no keel command could clear it.
        if [ -z "$ta" ]; then good "verify.test_affected is null: tdd runs verify.test at each unit boundary"
        else good "verify.test_affected is set (declared, not run): $ta"
        fi
    fi

    # stack.has_ui is written once, by init, and a project grows a user interface after that.
    # Nothing re-runs the detector, so this is the only place the drift can surface, and it matters
    # because skills branch on the field: coding-standards reads its frontend guidance out of it.
    #
    # A warning and never a failure. The detector treats a bare `public/` directory as an interface,
    # which is right often enough to be worth saying and not right enough to stop anyone working.
    if have_python && [ "$(json_get .keel/profile.json stack.has_ui || echo true)" = "false" ] \
       && [ "$(detect_has_ui)" = "true" ]; then
        warn "stack.has_ui is false, but this project looks like it has a user interface. Skills that branch on it are reading the wrong answer. Correct it with: keel profile set stack.has_ui true"
    fi

    # Give the harness a chance to fill any cache its readers share, here, in this shell. Claude
    # Code's readers sit in a `< <( )`, which is a subshell: it inherits a variable already full,
    # but anything it loads itself dies with it, so without this each would start its own
    # interpreter. Called through the contract rather than by name: `settings_report_load` exists
    # on one harness only, and cmd_doctor calling it directly is the break this task's own note
    # says the sixth contract function exists to prevent.
    harness_set_load
    harness_each harness_doctor_findings prime >/dev/null

    harness_section plugins

    # The context watchdog is deliberately silent when it cannot run, so that a session is never
    # interrupted by the thing meant to protect it. Silence with nothing reporting it would be
    # dishonest, though: an engineer would believe they had a pause that was never going to arrive.
    # This is where that gets said.
    if [ -f "$HERE/lib/context_watch.py" ]; then
        local watch_gate
        watch_gate="$(json_get .keel/profile.json gates.context_watch 2>/dev/null || true)"
        if [ "${KEEL_CONTEXT_WATCH:-}" = "off" ]; then
            warn "the context watchdog is off for this shell (KEEL_CONTEXT_WATCH=off). No pause before the context fills."
        elif [ "$watch_gate" = "false" ]; then
            good "context watchdog disabled for this project (gates.context_watch)"
        elif ! have_python; then
            warn "python3 is absent, so the context watchdog is inert. Sessions here run to their context limit with no warning and no handoff. Everything else still works."
        else
            # The window cannot be read from a session. A 1M session records its model as plain
            # `claude-opus-5` and no field anywhere names its window, which was found by measuring a
            # real 2.4MB transcript holding 401,247 tokens against an assumed 200,000. So the
            # assumption in force is printed rather than left silent: a wrong one either stops
            # sessions at a fifth of their capacity or never fires at all, and neither announces
            # itself.
            local cw; cw="$(json_get .keel/profile.json gates.context_window 2>/dev/null || true)"
            # The bound is LONG_WINDOW, read from the one place it is defined. A second literal here
            # would drift the day a larger model ships, and that is exactly the day it matters. Read
            # with sed rather than an interpreter: both init and doctor are asserted to start
            # python3 at most ten times.
            local cwmax; cwmax="$(sed -n 's/^LONG_WINDOW = //p' "$HERE/lib/context_watch.py" | tr -d '_' | head -n1)"
            local cwdef; cwdef="$(sed -n 's/^DEFAULT_WINDOW = //p' "$HERE/lib/context_watch.py" | tr -d '_' | head -n1)"
            # Report the window the watchdog will use, not the number in the file. The two differ in
            # three ways and each was reported wrongly at first: the environment variable beats the
            # file, a value above the maximum is bounded, and a value at or below the default is
            # discarded because the profile key is a floor that only ever raises. Telling someone who
            # lowered the window that it took effect is the worst of the three, because nothing
            # later contradicts it.
            #
            # A digit screen guards every numeric comparison. `[` overflows on a value wider than a
            # signed 64 bit integer and prints its complaint on stderr, so the width is capped before
            # the value is ever compared.
            local cwnum=0 envnum=0
            local env_cw="${KEEL_CONTEXT_WINDOW:-}"
            case "$cw"     in ''|*[!0-9]*) ;; *) [ "${#cw}" -le 18 ] && cwnum=1 ;; esac
            case "$env_cw" in ''|*[!0-9]*) ;; *) [ "${#env_cw}" -le 18 ] && envnum=1 ;; esac
            case "$cwmax"  in ''|*[!0-9]*) cwmax="" ;; esac
            case "$cwdef"  in ''|*[!0-9]*) cwdef="" ;; esac

            if [ "$envnum" = 1 ] && [ -n "$cwmax" ] && [ "$env_cw" -gt "$cwmax" ]; then
                warn "KEEL_CONTEXT_WINDOW is $env_cw, above the largest context window that exists. The watchdog is using $cwmax. Correct it, or a session will never be warned."
            elif [ "$envnum" = 1 ]; then
                good "context watchdog available (window $env_cw, from KEEL_CONTEXT_WINDOW in this shell). It overrides gates.context_window and is used exactly as set."
            elif [ "$cwnum" = 1 ] && [ -n "$cwmax" ] && [ "$cw" -gt "$cwmax" ]; then
                warn "gates.context_window is $cw, above the largest context window that exists. The watchdog is using $cwmax. Correct the value, or a session will never be warned."
            elif [ "$cwnum" = 1 ] && [ -n "$cwdef" ] && [ "$cw" -lt "$cwdef" ]; then
                if [ "$running" = codex ]; then
                    warn "gates.context_window is $cw and the watchdog is ignoring it. The key is a floor and only ever raises the window, and on codex the window starts from the model_context_window the session's own rollout states. Set KEEL_CONTEXT_WINDOW to force a smaller one."
                else
                    warn "gates.context_window is $cw, below the $cwdef default, so the watchdog is using $cwdef. The key is a floor and only ever raises the window. Set KEEL_CONTEXT_WINDOW to force a smaller one."
                fi
            elif [ "$cwnum" = 1 ]; then
                good "context watchdog available (window $cw from gates.context_window, raised automatically if a session is observed exceeding it)."
            elif [ -n "$cw" ] && [ "$cw" != "None" ]; then
                warn "gates.context_window is '$cw', which is not a usable number, so the watchdog is ignoring it and assuming 200000. Set a positive integer."
            else
                if [ "$running" = codex ]; then
                    good "context watchdog available (on codex the window is read from the session itself, which states model_context_window; the conservative default applies only to a session that states none). gates.context_window is a floor and raises that starting point."
                else
                    good "context watchdog available (window assumed 200000, raised once a session is observed exceeding it). A profile written by a newer keel carries gates.context_window; set it here to start from a larger value."
                fi
            fi
        fi
    fi

    harness_section boundaries

    # Staleness. Per-project files do not update themselves when the plugin does, so a project can
    # sit on the conventions of an older keel indefinitely while every session loads the new
    # skills. Advisory: an old profile still works, it just has not been re-initialised.
    #
    # It keys off schema_version, not the release version, and that is the whole point. Comparing
    # keel_version to VERSION warned on every release, including ones that changed no field at all:
    # 0.7.0 and 0.7.1 both would have told every project to re-run init for nothing. A warning that
    # fires when nothing changed is one nobody reads on the release where something did.
    if have_python; then
        local pv sv iv
        pv="$(json_get .keel/profile.json keel_version || true)"
        sv="$(json_get .keel/profile.json schema_version || true)"
        iv=""; [ -f "$HERE/VERSION" ] && iv="$(<"$HERE/VERSION")"
        [ -n "$pv" ] && good "configured by keel $pv"
        # Numeric, and three-way rather than two. The profile is a committed file, so on a team the
        # engineer who upgraded last commits a higher schema_version than the others have installed.
        # A bare `!=` called that stale and told them to re-run init, which writes the field back
        # down, which makes the first engineer's doctor warn: the two would ping-pong the value
        # between them forever, each following the tool's advice.
        case "$sv" in
            ''|*[!0-9]*) sv_num=-1 ;;   # absent, or not a number: written before the field existed
            *)           sv_num="$sv" ;;
        esac
        if [ "$sv_num" -eq "$SCHEMA_VERSION" ]; then
            good "profile is at schema version $SCHEMA_VERSION, which this keel expects"
        elif [ "$sv_num" -gt "$SCHEMA_VERSION" ]; then
            warn "this project's profile is at schema version $sv and keel ${iv:-unknown} expects $SCHEMA_VERSION, so your keel is the older one here. Upgrade the plugin. Do not re-run 'keel init' to silence this: it would write the field back down and undo whoever upgraded first."
        else
            warn "this project's profile is at schema version ${sv:-none}; keel ${iv:-unknown} expects $SCHEMA_VERSION. Re-run 'keel init' to pick up the new fields. It merges, so your own values survive."
        fi

        # A retirement is invisible to the person holding a profile that has one, and until this
        # rule the prescribed remedy hid it. Doctor keys off schema_version and init merges, so
        # `keel init` on a schema 3 profile returned schema_version 4 with all six retired keys
        # still in the file, after which the branch above reported the profile current and nothing
        # ever mentioned them again. Every other staleness message keel has is written for a schema
        # change that adds fields, because until 4 every one of them did.
        #
        # A warning and never a failure: the key does nothing, so nothing is broken, and the fix is
        # a hand edit no keel command performs.
        if json_load .keel/profile.json; then
            local rpath rver rwhat
            while IFS='|' read -r rpath rver rwhat; do
                [ -n "$rpath" ] || continue
                # The cache is one path=value line per leaf, so the = is what makes this a whole
                # key rather than the prefix of a longer one.
                case "$JSON_CACHE" in
                    "$rpath="*|*"
$rpath="*) warn ".keel/profile.json sets $rpath, retired in schema $rver. $rwhat" ;;
                esac
            done <<RETIRED_SEEN
$(retired_keys)
RETIRED_SEEN
        fi
    fi

    harness_section permissions

    harness_section local-state

    # The handoff must stay out of git too. It is session state, stale the moment work resumes, and
    # it reaches a commit on its own through 'git add -A'. check-ignore reports a tracked path as not
    # ignored, so this catches the file that is already in the index as well as the missing rule.
    if [ -f .keel/handoff.md ] && git rev-parse --git-dir >/dev/null 2>&1; then
        if repo_ignores .keel/handoff.md; then
            good ".keel/handoff.md is git-ignored"
        else
            fail ".keel/handoff.md is not git-ignored. A handoff is session state and is stale the moment work resumes. Add it to .gitignore, and if it is already tracked, run: git rm --cached .keel/handoff.md"
        fi
    fi

    harness_section editor

    # Whether this machine has the plugin's marketplace registered, which is the real precondition
    # for the skills existing at all. Advisory, never a failure: the profile and its gates are
    # useful to a session without the plugin, and a CI runner legitimately has neither.
    #
    # This replaced a check on `gh`, which reported that gh was needed to install from the private
    # marketplace. It is not: the marketplace clones over HTTPS through the ordinary git credential
    # helper, proved by an install on a machine with no gh at all. The old wording sent people to
    # install a tool they did not need, which is worse than staying quiet.
    # Both the default config directory and CLAUDE_CONFIG_DIR are checked, because they can differ
    # and either may be the one a session actually uses. Reporting "not registered" while it sits
    # in the other directory is worse than saying nothing.
    # Registration is a boolean; freshness is not, and nothing here was checking it. The marketplace
    # clone under <config>/plugins/marketplaces/ only moves when somebody runs
    # `/plugin marketplace update`, so an install can sit a full release behind while every other
    # signal reports green: the clone, the installed copy and its gitCommitSha all agree with each
    # other and all disagree with the marketplace. That happened here for twelve days across
    # 0.16.1 and 0.17.0. `lastUpdated` is the only local record of when the clone was last known
    # current, and reading it costs no network call.
    #
    # WHAT THIS MEASURES, STATED BECAUSE THE TWO ARE EASY TO CONFUSE: fetch age, not staleness. A
    # local check cannot tell them apart, and the gap runs both ways. Nine tags landed between
    # 2026-08-17 and 2026-08-20, so on 2026-08-19 a three day old clone was already several
    # releases behind and this check would have said nothing. Across the twelve day gap to 0.17.0 a
    # user correctly on 0.16.1 is warned from 2026-08-27 with nothing to do about it. Seven days is
    # chosen anyway, because it sits between the two observed cadences: shorter than the longest
    # gap between releases, so somebody who fetched just before one hears within a week rather than
    # after the next, and longer than a release burst, so nobody who fetched yesterday is warned
    # during one. Both branches below say which of the two they are talking about.
    #
    # Hardcoded rather than a profile field. A new field bumps SCHEMA_VERSION, and the comment on
    # that constant says to move it only when a field changes, precisely so a release that changed
    # nothing else does not warn everybody.
    harness_section marketplace

    printf '\n'
    # Warnings are counted into the summary because they scroll off. Writing the 0.6.1 release notes
    # meant counting the WARN lines by hand to say "no problems and one warning", which is the tell
    # that a summary ignoring them under-reports the state of the project.
    local wsuffix=""
    if [ "$warnings" -eq 1 ]; then wsuffix=", 1 warning"
    elif [ "$warnings" -gt 1 ]; then wsuffix=", $warnings warnings"; fi
    [ "$problems" -eq 0 ] && { say "keel doctor: no problems$wsuffix"; return 0; }
    say "keel doctor: $problems problem(s)$wsuffix"
    return 1
}

# ---- supply chain scan and the push guard ----------------------------------
#
# The scanner ships with the plugin rather than being copied into each repository, for the same
# reason the skills do: a vendored copy is a copy that stops being updated, and this one is a
# denylist whose whole value is being current.

SCANNER="$HERE/tests/supply-chain-scan.sh"

cmd_scan() {
    case "${1:-}" in --leaks|--leaks-message) leak_scan "$@"; return ;; esac; [ -x "$SCANNER" ] || die "the supply chain scanner is missing from this install ($SCANNER)."
    if [ "${1:-}" = "--push" ]; then
        [ "$#" -eq 3 ] || die "usage: keel scan --push <remote> <commit>"
        scan_push "$2" "$3"
        return
    fi
    "$SCANNER" "$@"
}

# `keel scan --push <remote> <commit>` is what the pre-push hook runs, once per pushed commit. It
# scans the commit, never the working tree, which can hold a file the commit lacks or lack one it
# carries. Two parts: the commit's tree in full, and the key-file rule alone over every key file a
# commit in the push added, changed or changed the type of that the tip does not hold as a file,
# because git keeps a committed key in history and the push carries that history to the remote. It
# refuses, rather than scans in part, a commit it cannot write to disk faithfully.
scan_push() {   # scan_push <remote> <commit>
    local remote="$1" sha work tree objects fmt entry meta p mode type oid h i rc=0 allow_mode=""
    local paths=() oids=() fix=() bad=() hist=() hoids=() look=() loids=()
    # Replace refs change what git reads and not what push sends, so none is followed anywhere here.
    export GIT_NO_REPLACE_OBJECTS=1
    sha="$(git rev-parse --verify --quiet "$2^{commit}" 2>/dev/null)" || die "'$2' is not a commit in this repository."
    objects="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)/objects" || die "could not find this repository's objects."
    # The scan repository must name objects the way this one does, or a SHA-256 repository could
    # not be read. A git too old to answer echoes the flag back, and has only SHA-1.
    fmt="$(git rev-parse --show-object-format 2>/dev/null)"
    case "$fmt" in sha1|sha256) ;; *) fmt="" ;; esac
    work="$(mktemp -d)" || die "could not create a temporary directory for the scan."
    # Removed however this ends, a die or an interrupted hook included, since it holds a full copy
    # of the commit. Expanded now, since $work is local and gone by the time the trap runs.
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT
    tree="$work/tree"
    mkdir "$tree" || die "could not create a temporary directory for the scan."
    say "scanning $sha, as pushed to $remote"
    while IFS= read -r -d '' entry; do
        meta="${entry%%$'\t'*}"; p="${entry#*$'\t'}"
        read -r mode type oid <<< "$meta"
        # git refuses to check out a path with a .git component, in any case, because it would
        # configure the repository it lands in, and a path with a ., .. or empty component, because
        # it would land outside or beside where it belongs; git mktree builds either. Refused here
        # before anything is written: a clone never holds one, and a .. path would put a file
        # anywhere this user can write.
        case "/$p/" in
            */[.][gG][iI][tT]/*|*/./*|*/../*|*//*) die "$sha holds '$p', a path git refuses to check out. Nothing was scanned." ;;
        esac
        # A submodule is a commit, whose content is not in this repository to scan.
        [ "$type" = blob ] || continue
        paths+=("$p"); oids+=("$oid")
        if [ "$p" = .keel/scan-allow ]; then allow_mode="$mode"; fi
    done < <(git ls-tree -r -z "$sha")
    # The copy gets a repository of its own, outside the copy, whose index is the commit's own tree:
    # names and modes come from the commit, never from what the disk kept, so A.key beside a.KEY on
    # a case-folding disk still reaches the key rule by its own name. checkout-index writes the
    # files, with the commit's .gitattributes out of the index meanwhile and no symlink written, so
    # the pushed tree chooses no filter command, no conversion, and nowhere outside the copy to
    # write. Every file is then checked against its blob, any that differs is written again from the
    # object store, and the check runs a second time. A file still wrong then is one this filesystem
    # cannot keep apart from another path, Payload.sh and payload.sh on a case-folding disk, or A.sh
    # beside a directory a.sh, and cannot be scanned.
    scan_push_in "$work" "$tree" scan_push_checkout "$sha" "$objects" "$fmt" \
      || die "could not write $sha's tree for the scanner. git refuses to write a path it will not check out, such as one it reads as .git on this filesystem, and that is the likely reason. Nothing was scanned."
    while IFS= read -r i; do fix+=("$i"); done < <(scan_push_mismatches "$tree")
    for i in "${!fix[@]}"; do
        scan_push_blob "$tree" "${paths[${fix[$i]}]}" "${oids[${fix[$i]}]}"
    done
    while IFS= read -r i; do bad+=("${paths[$i]}"); done < <(scan_push_mismatches "$tree")
    if [ "${#bad[@]}" -gt 0 ]; then
        err "$sha holds paths this filesystem cannot keep apart, such as two that differ only in case, so not all of them can be scanned. Refused rather than scanned in part:"
        for p in "${bad[@]}"; do err "  $p"; done
        return 1
    fi
    # .keel/scan-allow is read by name, and a case-folding disk answers to it for .keel/SCAN-ALLOW,
    # while a symlink by that name is written as a file holding its target's path. So an allow list
    # is honoured only where the commit holds that exact path as a file, and anything else the disk
    # answers to the name refuses the scan.
    if [ -e "$tree/.keel/scan-allow" ] && [ "$allow_mode" != 100644 ] && [ "$allow_mode" != 100755 ]; then
        err "$sha holds a path this filesystem reads as .keel/scan-allow, and not that file itself, so its allow list cannot be trusted. Nothing was scanned."
        return 1
    fi
    scan_push_in "$work" "$tree" "$SCANNER" || rc=1
    # Key file versions in the history the push carries that the tip does not hold as a file with
    # that same content: an entry in .keel/scan-allow covers the version the tip holds, so a live key
    # a pushed commit put at an allowed path is refused though a later commit put the fixture back.
    # A pinned version is allowed, see scan_push_gone. The push is every commit reachable from the
    # tip and from no ref of <remote> fetched here, so a first push, or a remote named by URL, which
    # has no refs here, counts the tip's whole history. Added, modified or changed in type, A, M and
    # T: a key the remote already holds, changed in the push and then deleted, sends the new key all
    # the same. -c lists what a merge commit itself adds,
    # and --root what a root commit does. Plumbing, rev-list and diff-tree, because git log follows
    # porcelain configuration: with log.showRoot false it shows nothing a root commit added. The
    # walk's status is checked, since one that stops partway, on an object missing from a partial
    # clone, would otherwise read as a clean history.
    if ! git rev-list "$sha" --not --remotes="$remote" -- 2>/dev/null \
        | git diff-tree --stdin -r -c --root --no-commit-id --no-renames --diff-filter=AMT -z > "$work/log" 2>/dev/null; then
        err "could not read the history $sha carries, so its key files were not checked."
        return 1
    fi
    # Raw records, the metadata and then the path, each NUL-ended. The metadata ends in the new blob
    # and the status, for a merge's combined record as for a plain one.
    while IFS= read -r -d '' meta && IFS= read -r -d '' p; do
        meta="${meta% *}"
        if [ -n "$p" ]; then hist+=("$p"); hoids+=("${meta##* }"); fi
    done < "$work/log"
    # What the tip holds is looked up in the tip itself, exactly, case and all, never through a
    # filesystem that may fold case: TEST.key is not held because test.key is. Only a file with the
    # same blob counts: a tip holding deploy.key/notes.txt does not hold the key a pushed commit
    # added as deploy.key.
    # A name holding a newline cannot be looked up one per line, and one with a ., .. or empty
    # component would be read relative to the working directory, so each is checked outright, and so
    # is any path cat-file did not answer for.
    : > "$work/gone"
    for p in "${!hist[@]}"; do
        case "/${hist[$p]}/" in
            *$'\n'*|*/./*|*/../*|*//*) scan_push_gone "${hist[$p]}" "${hoids[$p]}" ;;
            *) look+=("${hist[$p]}"); loids+=("${hoids[$p]}") ;;
        esac
    done
    if [ "${#look[@]}" -gt 0 ]; then
        i=0
        while IFS= read -r h; do
            [ "$h" = "blob ${loids[$i]}" ] || scan_push_gone "${look[$i]}" "${loids[$i]}"
            i=$((i+1))
        done < <(for p in "${look[@]}"; do printf '%s:%s\n' "$sha" "$p"; done | git cat-file --batch-check='%(objecttype) %(objectname)' 2>/dev/null)
        while [ "$i" -lt "${#look[@]}" ]; do
            scan_push_gone "${look[$i]}" "${loids[$i]}"
            i=$((i+1))
        done
    fi
    ( cd "$tree" && "$SCANNER" --secret-paths < "$work/gone" ) || rc=1
    return "$rc"
}

# ---- keel scan --leaks and keel scan --leaks-message -----------------------
#
# The leak guard: what a push, or a message, carries that must not reach the public repository. It
# checks against the internal deny list, which the deny list loader reads from outside any
# repository, and against two rules of its own: a root commit in a push, and a Claude-Session
# trailer. Its output says WHERE a pattern matched and WHICH deny list line it was, and never what
# matched, the pattern, a commit subject, or a path or ref name that itself matches: a guard that
# prints the leak has made a second copy of it, in a terminal and in a CI log.
#
# `keel scan --leaks <remote> [<object>:<ref>]...` checks the commits those pushes carry, by the
# walk scan_push makes: for each, its message, its author and committer, its paths, and the files it
# added, modified or changed in type. `keel scan --leaks-message <file>` checks one text file, such
# as a message or a pull request body. Exit 0 with no finding, 1 with any, 2 on a usage error or a
# history that cannot be read.

# shellcheck source=lib/deny-list.sh
. "$HERE/lib/deny-list.sh"

LEAK_SCISSORS='# ------------------------ >8 ------------------------'

leak_usage() { err "usage: keel scan --leaks <remote> [<object>:<ref>]...   or   keel scan --leaks-message <file>"; }

# leak_show <text>: the text with control characters shown as ?, since a path or a name from a
# pushed repository could otherwise write a line of its own into this output.
leak_show() { printf '%s' "${1//[[:cntrl:]]/?}"; }

# leak_emit <text>: one finding, counted in leak_scan's $found.
leak_emit() { printf 'leak guard: %s\n' "$1"; found=$((found+1)); }

# leak_split <raw object> <message out>: the headers of a commit or tag into LEAK_AUTHOR,
# LEAK_COMMITTER and LEAK_TAGGER, and the message after them, as it is, into the second file.
leak_split() {
    local line
    LEAK_AUTHOR=""; LEAK_COMMITTER=""; LEAK_TAGGER=""
    {
        while IFS= read -r line; do
            [ -n "$line" ] || break
            case "$line" in
                author\ *)    LEAK_AUTHOR="${line#author }" ;;
                committer\ *) LEAK_COMMITTER="${line#committer }" ;;
                tagger\ *)    LEAK_TAGGER="${line#tagger }" ;;
            esac
        done
        cat > "$2"
    } < "$1"
}

# leak_ident <header>: LEAK_NAME and LEAK_EMAIL from "Name <email> time zone".
leak_ident() {
    local rest="${1% *}"
    rest="${rest% *}"
    LEAK_NAME="${rest%%<*}"; LEAK_NAME="${LEAK_NAME% }"
    LEAK_EMAIL="${rest#*<}"; LEAK_EMAIL="${LEAK_EMAIL%%>*}"
}

# leak_trailers <message file> <where prefix>: queues a finding in leak_scan's $work/struct for each
# line of the message whose key is Claude-Session, in any case. Plain bash and not grep, so the
# greps of a run stay one per pattern.
leak_trailers() {
    local line n=0 l
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n+1))
        l="${line#"${line%%[![:space:]]*}"}"
        case "$l" in
            [Cc][Ll][Aa][Uu][Dd][Ee]-[Ss][Ee][Ss][Ss][Ii][Oo][Nn]:*)
                printf '%smessage line %s: a Claude-Session trailer\n' "$2" "$n" >> "$work/struct" ;;
        esac
    done < "$1"
}

# leak_push <remote> [<object>:<ref>]...: run inside leak_scan, whose variables it fills. Writes
# every candidate text of the push to $work/c, one file for each kind, and every file a commit in
# range added to $work/o. Returns 2 where leak_scan is to stop.
leak_push() {
    local remote="$1" arg obj ref id type next steps n k u mode oid p cur colons np src pat toplevel
    local f=() w=() tips=() tagids=()
    shift
    git rev-parse --git-dir >/dev/null 2>&1 || { err "this is not a git repository."; return 2; }
    for arg in "$@"; do
        case "$arg" in
            ?*:?*) ;;
            *) leak_usage; return 2 ;;
        esac
        obj="${arg%%:*}"; ref="${arg#*:}"
        printf '%s\n' "$ref" >> "$work/c/refs"
        nrefs=$((nrefs+1))
        id=""; type=""; steps=0
        case "$obj" in -*) ;; *) id="$(git rev-parse --verify --quiet "$obj^{object}" 2>/dev/null)" ;; esac
        [ -z "$id" ] || type="$(git cat-file -t "$id" 2>/dev/null)"
        # A tag is checked and then peeled, and so is a tag of a tag.
        while [ "$type" = tag ] && [ "$steps" -lt 20 ]; do
            tagids+=("$id")
            read -r _ next < <(git cat-file tag "$id" 2>/dev/null)
            id="$(git rev-parse --verify --quiet "${next:-x}^{object}" 2>/dev/null)"
            type=""
            [ -z "$id" ] || type="$(git cat-file -t "$id" 2>/dev/null)"
            steps=$((steps+1))
        done
        if [ "$type" != commit ]; then
            err "$(leak_show "$obj") is not a commit or tag in this repository."
            return 2
        fi
        tips+=("$id")
    done

    n=0
    for id in ${tagids[@]+"${tagids[@]}"}; do
        git cat-file tag "$id" > "$work/raw" 2>/dev/null || { err "could not read the tag $id."; return 2; }
        leak_split "$work/raw" "$work/c/tm$n"
        leak_ident "$LEAK_TAGGER"
        printf '%s\n%s\n' "$LEAK_NAME" "$LEAK_EMAIL" > "$work/c/tg$n"
        tag7[n]="$(git rev-parse --short=7 "$id")"
        n=$((n+1))
    done
    ntags=$n

    # The commits: every commit reachable from a pushed commit and from no remote-tracking ref of
    # <remote>, the walk scan_push makes, with its status checked, since a walk that stops partway
    # would read as a clean range. --parents is for the root rule.
    if ! git rev-list --parents "${tips[@]}" --not --remotes="$remote" -- > "$work/walk" 2>/dev/null; then
        err "could not read the history this push carries, so nothing was checked."
        return 2
    fi
    n=0
    while IFS=' ' read -r -a w; do
        [ "${#w[@]}" -gt 0 ] || continue
        csha[n]="${w[0]}"
        c7[n]="$(git rev-parse --short=7 "${w[0]}")"
        printf '%s\n' "${w[0]}" >> "$work/shas"
        if [ "${#w[@]}" -eq 1 ]; then
            printf '%s has no parent, so this push carries a history the remote does not have\n' "${c7[$n]}" >> "$work/struct"
        fi
        n=$((n+1))
    done < "$work/walk"
    ncommits=$n
    k=0
    while [ "$k" -lt "$ncommits" ]; do
        git cat-file commit "${csha[$k]}" > "$work/raw" 2>/dev/null || { err "could not read the commit ${csha[$k]}."; return 2; }
        leak_split "$work/raw" "$work/c/m$k"
        leak_ident "$LEAK_AUTHOR"; f=("$LEAK_NAME" "$LEAK_EMAIL")
        leak_ident "$LEAK_COMMITTER"
        printf '%s\n%s\n%s\n%s\n' "${f[0]}" "${f[1]}" "$LEAK_NAME" "$LEAK_EMAIL" > "$work/c/id$k"
        leak_trailers "$work/c/m$k" "${c7[$k]} "
        k=$((k+1))
    done

    # Files added, modified or changed in type, the listing scan_push makes, with the commit id kept
    # so each finding names its commit. The output is NUL-ended tokens: a commit id on its own, and
    # for each file a record starting with a colon and then its path. A merge's -c record has a colon
    # for each parent, and its modes and blobs run to one more than that.
    : > "$work/c/paths"
    if [ "$ncommits" -gt 0 ]; then
        if ! git diff-tree --stdin -r -c --root --no-renames --diff-filter=AMT -z < "$work/shas" > "$work/dt" 2>/dev/null; then
            err "could not read the files this push carries, so nothing was checked."
            return 2
        fi
        cur=-1
        while IFS= read -r -d '' src; do
            case "$src" in
                :*)
                    IFS= read -r -d '' p || break
                    [ "$cur" -ge 0 ] || { err "git listed a file before a commit."; return 2; }
                    read -r -a f <<< "$src"
                    colons="${f[0]%%[!:]*}"; np=${#colons}
                    f[0]="${f[0]#"$colons"}"
                    mode="${f[$np]}"; oid="${f[$((2*np+1))]}"
                    eci[nentries]="$cur"; epath[nentries]="$p"
                    printf '%s\n' "${p//$'\n'/ }" >> "$work/c/paths"
                    # A submodule is a commit, whose content is not in this repository to read.
                    if [ "$mode" != 160000 ]; then
                        if [ -f "$work/s/$oid" ]; then
                            read -r u < "$work/s/$oid"
                        else
                            nblobs=$((nblobs+1)); u=$nblobs
                            git cat-file blob "$oid" > "$work/o/$u" 2>/dev/null || { err "could not read the file $oid of the commit ${csha[$cur]}."; return 2; }
                            printf '%s\n' "$u" > "$work/s/$oid"
                        fi
                        printf '%s\n' "$nentries" >> "$work/m/$u"
                    fi
                    nentries=$((nentries+1)) ;;
                *)
                    cur=$((cur+1))
                    while [ "$cur" -lt "$ncommits" ] && [ "${csha[$cur]}" != "$src" ]; do cur=$((cur+1)); done
                    [ "$cur" -lt "$ncommits" ] || { err "git listed a commit the walk did not."; return 2; } ;;
            esac
        done < "$work/dt"
    fi

    # Ignored means what git check-ignore --no-index says in this working tree, which reads
    # .gitignore and .git/info/exclude, and with core.excludesFile emptied nothing of this user's
    # own. A path with a ., .. or empty component is refused by scan_push and is not asked about.
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"
    n=0
    if [ -n "$toplevel" ] && [ "$nentries" -gt 0 ]; then
        k=0
        while [ "$k" -lt "$nentries" ]; do
            case "/${epath[$k]}/" in
                */./*|*/../*|*//*) ;;
                *) printf '%s\0' "${epath[$k]}" >> "$work/feed"; fed[n]="$k"; n=$((n+1)) ;;
            esac
            k=$((k+1))
        done
    fi
    if [ "$n" -gt 0 ]; then
        ( cd "$toplevel" && git -c core.excludesFile=/dev/null check-ignore --no-index -z -v -n --stdin < "$work/feed" > "$work/ignored" 2>/dev/null )
        [ $? -le 1 ] || { err "could not read this repository's ignore rules, so nothing was checked."; return 2; }
        k=0
        while IFS= read -r -d '' src && IFS= read -r -d '' _ && IFS= read -r -d '' pat && IFS= read -r -d '' _; do
            if [ -n "$src" ]; then
                case "$pat" in '!'*) ;; *) ign[${fed[$k]}]=1 ;; esac
            fi
            k=$((k+1))
        done < "$work/ignored"
    fi
    return 0
}

# leak_scan --leaks <remote> [<object>:<ref>]...   or   leak_scan --leaks-message <file>
leak_scan() {
    local mode="$1" shown work line hit name rest which l ci k u pi
    local nrefs=0 ncommits=0 ntags=0 nentries=0 nblobs=0 found=0
    local csha=() c7=() tag7=() eci=() epath=() fed=() ign=() pm=()
    shift
    export GIT_NO_REPLACE_OBJECTS=1
    deny_load
    shown="$DENY_FILE"
    case "$shown" in "${HOME:-/nonexistent}"/*) shown="$(printf '%s/%s' '~' "${shown#"$HOME"/}")" ;; esac
    if [ -f "$DENY_FILE" ]; then
        say "leak guard: deny list loaded from $shown ($DENY_LOADED patterns)"
    else
        say "leak guard: WARNING no deny list at $shown, so only the 2 generic patterns ran. Client names are not checked on this machine."
    fi
    case "$mode" in
        --leaks)         [ "$#" -ge 1 ] || { leak_usage; return 2; } ;;
        --leaks-message) [ "$#" -eq 1 ] || { leak_usage; return 2; }
                         [ -f "$1" ] && [ -r "$1" ] || { err "cannot read '$(leak_show "$1")'."; return 2; } ;;
    esac
    if [ "$mode" = --leaks ] && [ "$#" -eq 1 ]; then
        say "leak guard: nothing pushed, nothing checked"
        return 0
    fi
    work="$(mktemp -d)" || { err "could not create a temporary directory for the leak guard."; return 2; }
    # Removed however this ends, an interrupted push included, since it holds a copy of what the
    # push carries. Expanded now, since $work is local and gone by the time the trap runs.
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT
    mkdir "$work/c" "$work/o" "$work/s" "$work/m" || { err "could not create a temporary directory for the leak guard."; return 2; }
    : > "$work/struct"; : > "$work/hits"
    if [ "$mode" = --leaks ]; then
        leak_push "$@" || return 2
    else
        # Every line up to a scissors line, comment lines included, since git commits a # line under
        # some cleanup modes.
        while IFS= read -r line || [ -n "$line" ]; do
            [ "$line" != "$LEAK_SCISSORS" ] || break
            printf '%s\n' "$line"
        done < "$1" > "$work/c/mf"
        leak_trailers "$work/c/mf" ""
    fi

    # The binary test, once over every file a commit added: the scanner's own, grep -I, which lists
    # the text files (an empty one is not listed either). Then one grep per pattern over all of
    # the candidates, as tests/no-internal-leaks.sh does. Names are relative to $work to keep the
    # argument list short, and the locale is C so that a file the test calls text is searched as
    # text, whatever bytes it holds.
    if [ "$nblobs" -gt 0 ]; then
        ( cd "$work" && LC_ALL=C grep -rIl '' o ) > "$work/text" 2>/dev/null
    fi
    ( cd "$work/c" && printf 'c/%s\n' * ) > "$work/cands"
    if [ -s "$work/text" ]; then cat "$work/text" >> "$work/cands"; fi
    pi=0
    while [ "$pi" -lt "${#DENY[@]}" ]; do
        ( cd "$work" && tr '\n' '\0' < cands | LC_ALL=C xargs -0 grep -anHE -- "${DENY[$pi]}" 2>/dev/null ) \
          | while IFS= read -r hit; do
                name="${hit%%:*}"; rest="${hit#*:}"; line="${rest%%:*}"
                case "$line" in ''|*[!0-9]*) continue ;; esac
                printf '%s\t%s\t%s\n' "$pi" "$name" "$line"
            done >> "$work/hits"
        pi=$((pi+1))
    done

    # A path that matches a pattern is not named wherever a line would name it.
    while IFS=$'\t' read -r pi name line; do
        if [ "$name" = c/paths ]; then pm[line-1]=1; fi
    done < "$work/hits"
    while IFS= read -r l; do leak_emit "$l"; done < "$work/struct"
    k=0
    while [ "$k" -lt "$nentries" ]; do
        if [ -n "${ign[$k]:-}" ]; then
            if [ -n "${pm[$k]:-}" ]; then l="a changed path"; else l="$(leak_show "${epath[$k]}")"; fi
            leak_emit "${c7[${eci[$k]}]} $l: a path this repository ignores"
        fi
        k=$((k+1))
    done
    while IFS=$'\t' read -r pi name line; do
        which="${DENY_WHERE[$pi]}"
        case "$name" in
            c/mf)    leak_emit "message line $line: $which" ;;
            c/m*)    ci="${name#c/m}"; leak_emit "${c7[$ci]} message line $line: $which" ;;
            c/id*)   ci="${name#c/id}"
                     case "$line" in 1) l="author name" ;; 2) l="author email" ;; 3) l="committer name" ;; *) l="committer email" ;; esac
                     leak_emit "${c7[$ci]} $l: $which" ;;
            c/tm*)   ci="${name#c/tm}"; leak_emit "tag ${tag7[$ci]} message line $line: $which" ;;
            c/tg*)   ci="${name#c/tg}"
                     case "$line" in 1) l="tagger name" ;; *) l="tagger email" ;; esac
                     leak_emit "tag ${tag7[$ci]} $l: $which" ;;
            c/paths) k=$((line-1)); leak_emit "${c7[${eci[$k]}]} a changed path: $which" ;;
            c/refs)  leak_emit "a pushed ref name: $which" ;;
            o/*)     u="${name#o/}"
                     while IFS= read -r k; do
                         if [ -n "${pm[$k]:-}" ]; then l="a changed path"; else l="$(leak_show "${epath[$k]}")"; fi
                         leak_emit "${c7[${eci[$k]}]} $l line $line: $which"
                     done < "$work/m/$u" ;;
        esac
    done < "$work/hits"

    if [ "$found" -gt 0 ]; then
        say "leak guard: $found finding(s)"
        return 1
    fi
    if [ "$mode" = --leaks ]; then
        say "leak guard: checked $ncommits commit(s), $ntags tag(s) and $nrefs ref name(s), no findings"
    else
        say "leak guard: message checked, no findings"
    fi
    return 0
}

# leak_deny_shown: the deny list's path as the scan prints it, with the home directory as ~.
leak_deny_shown() {
    local shown="$DENY_FILE"
    case "$shown" in "${HOME:-/nonexistent}"/*) shown="$(printf '%s/%s' '~' "${shown#"$HOME"/}")" ;; esac
    printf '%s' "$shown"
}

# scan_push_gone <path> <blob>: run inside scan_push, whose $work and $tree it reads. Queues the
# history version for the key-file rule, unless the commit's .keel/scan-allow pins it: a line naming
# the path and then that blob. A pin covers one reviewed version, so a fixture regenerated in the
# history a first push walks can be allowed without allowing whatever else that path ever held. By
# here, anything at .keel/scan-allow is the commit's own file, since scan_push refused the rest.
scan_push_gone() {
    local line f o
    if [ -f "$tree/.keel/scan-allow" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in \#*) continue ;; esac
            f="${line%% *}"; o="${line#"$f"}"; o="${o# }"; o="${o%% *}"
            if [ "$f" = "$1" ] && [ "$o" = "$2" ]; then
                printf 'ALLOW %s %s [structural-secret-material] pinned in .keel/scan-allow\n' "$1" "$2"
                return 0
            fi
        done < "$tree/.keel/scan-allow"
    fi
    printf '%s\0' "$1" >> "$work/gone"
}

# scan_push_in <work> <tree> <command>...: <command> run in <tree>, with git pointed at the scan's
# own repository and at nothing else. Every variable git reads to find or configure a repository is
# cleared first, from git's own list: a linked worktree's hook runs with GIT_DIR set, and
# GIT_CONFIG_PARAMETERS and its kin carry configuration. System and global configuration are left
# out too, so no filter or hook this user has configured runs over the pushed tree. HOME and
# XDG_CONFIG_HOME point at the work directory as well: a git older than 2.32 ignores
# GIT_CONFIG_GLOBAL and reads ~/.gitconfig, and every git reads the global attributes file under
# XDG_CONFIG_HOME whatever GIT_CONFIG_GLOBAL says.
scan_push_in() {
    local work="$1" tree="$2" v
    shift 2
    (
        for v in $(git rev-parse --local-env-vars); do unset "$v"; done
        export GIT_DIR="$work/git" GIT_WORK_TREE="$tree" GIT_NO_REPLACE_OBJECTS=1 \
            GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HOME="$work" XDG_CONFIG_HOME="$work"
        cd "$tree" || exit 1
        "$@"
    )
}

# scan_push_checkout <commit> <objects> <format>: run through scan_push_in. The scan repository,
# reading the pushed repository's objects in place, with the commit's tree as its index and on disk.
# The commit's .gitattributes leave the index while checkout-index writes, so they choose no filter,
# eol conversion or encoding; they come back with the rest when the index is read again, and on disk
# through scan_push_mismatches; matched in any case, since a case-folding disk reads
# A/.GITATTRIBUTES for a/. core.symlinks is off so checkout-index writes a symlink as the plain file
# git stores, its target's path: on a case-folding disk a symlink x can replace a directory X whose
# files are then written through it, outside the copy. core.fsmonitor and core.autocrlf are set here
# because on a git older than 2.32, which ignores GIT_CONFIG_GLOBAL, a global setting would still
# apply. core.precomposeunicode is off because git on macOS turns it on at init, and then lists a
# decomposed name it reads from disk a second time, precomposed, as an untracked file the allow list
# does not name.
scan_push_checkout() {
    local sha="$1" objects="$2" fmt="$3" p
    git init -q ${fmt:+"--object-format=$fmt"} && git config core.fsmonitor false && git config core.autocrlf false \
      && git config core.symlinks false && git config core.precomposeunicode false \
      && printf '%s\n' "$objects" > "$(git rev-parse --git-path objects/info/alternates)" \
      && git read-tree "$sha" || return 1
    git ls-files -z | while IFS= read -r -d '' p; do
        case "/$p" in */[.][gG][iI][tT][aA][tT][tT][rR][iI][bB][uU][tT][eE][sS]) printf '%s\0' "$p" ;; esac
    done | git update-index -z --force-remove --stdin || return 1
    # Its failures, a path this filesystem cannot write as the commit has it, are left to
    # scan_push_mismatches, which decides.
    git checkout-index -a -f 2>/dev/null
    git read-tree "$sha"
}

# scan_push_mismatches <dir>: one line per index into the caller's paths and oids whose file under
# <dir> is not exactly that blob. hash-object reads one path per line, drops a trailing CR from it,
# and stops at a file it cannot open; it also follows a symlink, which would read outside the tree.
# So a symlink, or anything not a plain file, is a mismatch outright, and a name holding a newline
# or a CR is hashed on its own. Any file the batch did not reach is a mismatch too.
scan_push_mismatches() {
    local dir="$1" i n h hidx=()
    for i in "${!paths[@]}"; do
        if [ -L "$dir/${paths[$i]}" ] || [ ! -f "$dir/${paths[$i]}" ]; then
            printf '%s\n' "$i"
        elif [[ "${paths[$i]}" == *$'\n'* || "${paths[$i]}" == *$'\r'* ]]; then
            [ "$(git hash-object --no-filters -- "$dir/${paths[$i]}" 2>/dev/null)" = "${oids[$i]}" ] || printf '%s\n' "$i"
        else
            hidx+=("$i")
        fi
    done
    [ "${#hidx[@]}" -gt 0 ] || return 0
    n=0
    while IFS= read -r h; do
        [ "$h" = "${oids[${hidx[$n]}]}" ] || printf '%s\n' "${hidx[$n]}"
        n=$((n+1))
    done < <(for i in "${hidx[@]}"; do printf '%s/%s\n' "$dir" "${paths[$i]}"; done | git hash-object --no-filters --stdin-paths 2>/dev/null)
    while [ "$n" -lt "${#hidx[@]}" ]; do
        printf '%s\n' "${hidx[$n]}"
        n=$((n+1))
    done
}

# scan_push_blob <dir> <path> <blob>: the blob's bytes at <dir>/<path>, as git stores them. Its
# failures are not checked here: the second scan_push_mismatches is what decides.
scan_push_blob() {
    {
        rm -f "$1/$2"
        mkdir -p "$(dirname "$1/$2")"
        git cat-file blob "$3" > "$1/$2"
    } 2>/dev/null
}

# The guard is opt-in: it writes three hooks into this repository's git directory, and a tool that
# does that the moment you run `init` is a tool people stop running.
#
# It lives in git's own hooks directory, never in the working tree, and sets no core.hooksPath.
# Until 2026-09-26 it used core.hooksPath=.githooks, a working-tree path, so every checkout replaced
# the hooks with the checked-out branch's own and a fork's pull request ran its code on checkout.
# No checkout writes into the git directory. `git rev-parse --git-common-dir` is used and not
# `--git-path hooks`, because --git-path follows core.hooksPath, which would name .githooks again;
# the common dir is shared by every worktree, and is relative to the current directory.
#
# It never takes over another tool's hooks: a core.hooksPath keel did not set, or a same-named hook
# without keel's mark, belongs to husky, lefthook or a scanner, and replacing either switches that
# tool off. Nothing here writes git configuration at all, least of all globally.
GUARD_LEGACY_DIR=".githooks"
GUARD_MARK='installed by `keel guard install`'

guard_dir() { printf '%s/hooks' "$(git rev-parse --git-common-dir)"; }

# The top of the working tree, which git resolves a relative core.hooksPath against, rather than the
# current directory. A bare repository has no working tree, so the current directory stands in.
guard_top() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

# core.hooksPath as git reads it and the config it came from, so a refusal names the file to edit:
# nothing in this repository undoes a global or system setting.
guard_hooks_path_source() {
    local s; s="$(git config --show-scope --get core.hooksPath 2>/dev/null)" || return 0
    printf "'%s', set in the %s git config" "${s#*$'\t'}" "${s%%$'\t'*}"
}

# The hooks in keel's old .githooks install that keel did not write, space separated. git runs them
# only while core.hooksPath points there, so moving keel's out must not unset it while any remain.
# Only executable files count, because git runs no other kind: a README.md there is no hook. A
# *.sample file is one of git's inert examples, which git skips even when it is executable.
guard_legacy_others() {
    local f out=""
    for f in "$(guard_top)/$GUARD_LEGACY_DIR"/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        case "$f" in *.sample) continue ;; esac
        grep -qF "$GUARD_MARK" "$f" || out="$out ${f##*/}"
    done
    printf '%s' "${out# }"
}

# The first of keel's three hook names whose file in the hooks directory lacks keel's mark, which
# makes it another tool's: the pre-commit framework and lefthook write there. Status 1 when none.
guard_foreign_hook() {
    local d f; d="$(guard_dir)"
    for f in pre-push pre-commit prepare-commit-msg; do
        if [ -e "$d/$f" ] && ! grep -qF "$GUARD_MARK" "$d/$f"; then printf '%s' "$f"; return 0; fi
    done
    return 1
}

# Whether the installed pre-push carries keel's mark and holds LEAK_GUARD=1 on its third line, which
# is where guard_hook_body writes the leak guard's choice. Status 1 for any other state.
guard_leak_on() {
    local d; d="$(guard_dir)"
    grep -qF "$GUARD_MARK" "$d/pre-push" 2>/dev/null || return 1
    [ "$(sed -n 3p "$d/pre-push" 2>/dev/null)" = "LEAK_GUARD=1" ]
}

# One answer to "is the guard installed", for `guard status` and doctor alike:
#   legacy        core.hooksPath is .githooks and keel's pre-push is there: keel's own old install
#   foreign-path  core.hooksPath points anywhere else, so git never runs the hooks directory. A
#                 .githooks without keel's mark is a project's own hooks, and lands here
#   installed     keel's executable pre-push is in the hooks directory, whatever sits beside it:
#                 the push guard runs, and status names another tool's pre-commit on its own line
#   foreign-hook  the hooks directory holds another tool's pre-push, pre-commit or prepare-commit-msg
#   absent        none of these, a keel pre-push that lost its executable bit included
guard_state() {
    local hp d top rp rd; hp="$(git config core.hooksPath 2>/dev/null || true)"; d="$(guard_dir)"
    top="$(guard_top)"
    # A core.hooksPath naming the hooks directory itself redirects nothing, so it is not foreign.
    # A relative one is resolved as git resolves it, against the top of the working tree.
    if [ -n "$hp" ]; then
        case "$hp" in /*) rp="$hp" ;; *) rp="$top/$hp" ;; esac
        rp="$(cd "$rp" 2>/dev/null && pwd -P)"; rd="$(cd "$d" 2>/dev/null && pwd -P)"
        if [ -n "$rp" ] && [ "$rp" = "$rd" ]; then hp=""; fi
    fi
    if [ "$hp" = "$GUARD_LEGACY_DIR" ] && grep -qF "$GUARD_MARK" "$top/$GUARD_LEGACY_DIR/pre-push" 2>/dev/null; then
        printf 'legacy'
    elif [ -n "$hp" ]; then
        printf 'foreign-path'
    elif [ -x "$d/pre-push" ] && grep -qF "$GUARD_MARK" "$d/pre-push"; then
        printf 'installed'
    elif guard_foreign_hook >/dev/null; then
        printf 'foreign-hook'
    else
        printf 'absent'
    fi
}

# The pre-push hook, with the leak guard off or on as $GUARD_LEAK_CHOICE says (0 or 1, default 0).
# Line 3 of the file holds the choice, which a reinstall and `keel guard status` read back. A
# variable and not an argument, so that the call in cmd_guard keeps the text documents cite.
GUARD_LEAK_CHOICE=0
guard_hook_body() {
    printf '#!/usr/bin/env bash\nVERIFY_KEYS="%s"\nLEAK_GUARD=%s\n' "$VERIFY_KEYS" "$GUARD_LEAK_CHOICE"  # baked in: this file runs later as its own process, with no access back into this shell
    cat <<'HOOK'
# pre-push hook, installed by `keel guard install`.
#
# Two refusals. A push to the default branch, because work lands through a pull request. And a push
# carrying anything the supply chain scan flags: this repository's contents run on other people's
# machines, so the last point at which a bad file is cheap to remove is before it reaches a remote
# where it is permanent. With LEAK_GUARD=1 (keel guard install --leak-guard) a third: a push whose
# commits name something on the owner's deny list.
#
# Remove with `keel guard uninstall`. To push past it once, deliberately and on the record:
#   git push --no-verify
set -uo pipefail

# The branch is read from the profile, never assumed. A repo whose default is not `main` is common,
# and a guard protecting the wrong branch protects nothing while reading as though it does. Absent,
# fall back to what the remote says its HEAD is, and when neither answers, check nothing rather than
# guess: a refusal naming the wrong branch teaches people to pass --no-verify by reflex.
protected="$(sed -n 's/.*"default_branch": *"\([^"]*\)".*/\1/p' .keel/profile.json 2>/dev/null | head -1)"
if [ -z "$protected" ]; then
    protected="$(git symbolic-ref --quiet --short "refs/remotes/${1:-origin}/HEAD" 2>/dev/null || true)"
    protected="${protected##*/}"
fi
# Plain BRE, no `\|` alternation: that is a GNU extension, and on the BSD sed every macOS ships it
# matches nothing, so the flag would read as unset and the guard would refuse a project that had
# switched it off. Caught by the test for exactly that case.
protect="$(sed -n 's/.*"protect_default_branch": *\([a-z]*\).*/\1/p' .keel/profile.json 2>/dev/null | head -1)"

# The commits the push sends, each once: the scan at the end reads them. And, for the leak guard,
# each pushed <local sha>:<remote ref>, unpeeled.
pushed=""
pairs=()
# Only when git is feeding the hook. A push supplies its refs on stdin; run by hand from a terminal
# there is nothing to read, and a `read` against a tty would hang rather than check anything.
if [ ! -t 0 ]; then
    blocked=""
    loosened=""
    have_py=0
    # python3 -c 'pass' rather than command -v: Windows' App Execution Alias puts a python3.exe on
    # PATH that prints a not-found message and exits 49 without running anything, and command -v
    # would call that present.
    python3 -c 'pass' >/dev/null 2>&1 && have_py=1
    # Each line is <local ref> <local sha> <remote ref> <remote sha>, and the local ref is the push
    # source as written, which can hold a space: `:/fix HEAD` names a commit by its message. So the
    # fields are taken from the right, where neither sha nor a ref name can hold one.
    while IFS= read -r line; do
        rsha="${line##* }"; line="${line% *}"
        rref="${line##* }"; line="${line% *}"
        lsha="${line##* }"
        # A branch delete, a local sha of all zeros, 40 of them or a SHA-256 repository's 64, sends
        # no content. A commit pushed under two refs, a branch and an annotated tag on it, is
        # scanned once: a tag's own sha is peeled to its commit, and one that does not peel is kept
        # as it is, so the scan still refuses it. The peel ignores replace refs, as keel scan --push
        # does: they change what git reads and not what push sends, so a replaced tag object would
        # peel to the replacement's commit.
        case "$lsha" in
            *[!0]*)
                pairs+=("$lsha:$rref")
                commit="$(GIT_NO_REPLACE_OBJECTS=1 git rev-parse --verify --quiet "$lsha^{commit}" 2>/dev/null)" || commit="$lsha"
                case " $pushed " in *" $commit "*) ;; *) pushed="$pushed $commit" ;; esac ;;
        esac
        if [ -n "$protected" ] && [ "$protect" != "false" ] && [ "$rref" = "refs/heads/$protected" ]; then
            blocked="$protected"
        fi
        # Loosening check: read from the two commits the push is about to move the remote between,
        # never from the working tree, so an uncommitted edit is not what gets checked. Skipped on a
        # branch delete (the all-zero local sha) and where python3 is absent, the same posture the
        # pre-commit hook already takes toward JSON it cannot safely parse with sed.
        if [ "$have_py" -eq 1 ] && [ "$lsha" != "0000000000000000000000000000000000000000" ]; then
            # A first push has no remote tip (the all-zero remote sha). Compare against the
            # remote-tracking default branch instead, so a branch born weaker than main is caught on
            # its first push and not only on its second. Skipped where that ref is absent too.
            if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
                rsha=""
                cmp_branch="$protected"
                # $protected can be unnamed here specifically because this push deletes the
                # profile: the working tree is this push's own, so .keel/profile.json is already
                # gone from it, which is the very case this comparison exists to catch. Only for
                # this lookup, not for $protected itself (naming the wrong branch there teaches
                # --no-verify by reflex): one remote-tracking branch is not a guess, it is the
                # only candidate; more than one is left alone, same posture as $protected above.
                if [ -z "$cmp_branch" ]; then
                    only_ref="$(git for-each-ref --format='%(refname)' "refs/remotes/${1:-origin}" 2>/dev/null | grep -v '/HEAD$')"
                    [ "$(printf '%s\n' "$only_ref" | grep -c .)" -eq 1 ] && cmp_branch="${only_ref##*/}"
                fi
                [ -n "$cmp_branch" ] && rsha="$(git rev-parse --verify --quiet "refs/remotes/${1:-origin}/$cmp_branch" 2>/dev/null || true)"
            fi
            old_p=""
            [ -n "$rsha" ] && old_p="$(git show "$rsha:.keel/profile.json" 2>/dev/null || true)"
            new_p="$(git show "$lsha:.keel/profile.json" 2>/dev/null || true)"
            if [ -n "$old_p" ] && [ -z "$new_p" ]; then
                # The profile itself is gone: every gate and verify command it carried goes with
                # it, the maximal loosening. There is no new-side JSON document to hand the python
                # comparator, so this is refused directly rather than compared.
                loosened="$loosened.keel/profile.json: deleted (present on the remote, gone from this push)
"
            elif [ -n "$old_p" ] && [ -n "$new_p" ]; then
                report="$(python3 - "$old_p" "$new_p" "$VERIFY_KEYS" <<'PY'
import json, sys

def get(d, path):
    for k in path.split("."):
        if not isinstance(d, dict) or k not in d:
            return None
        d = d[k]
    return d

try:
    old, new, verify_keys = json.loads(sys.argv[1]), json.loads(sys.argv[2]), sys.argv[3].split()
except Exception:
    sys.exit(0)

order = {"required": 2, "warn": 1, "off": 0, True: 2, False: 0}
for gate in ("commit_guard", "done_verified", "security_audit", "coding_standards"):
    o, n = get(old, "gates." + gate), get(new, "gates." + gate)
    # A key present in old but not a recognized value in new, absent, null, or an unrecognized
    # string such as a typo, is a loosening, not just "off" left unread: treat it as the same
    # weakest value "off" would be, so deleting the key or misspelling its value is caught the
    # same way setting it to "off" would be. A key not a recognized value in old too is left
    # alone, an older or incomplete profile schema on the baseline side, not a loosening this
    # push made, and there is nothing to compare it against anyway.
    if o in order and n not in order:
        n = "off"
    if o in order and n in order and order[n] < order[o]:
        print("gates.%s: %r -> %r" % (gate, o, n))

# This loosening check excludes test_one (templated with {path}/{name}) and format_fix (rewrites
# files rather than checking them), neither a runnable bare command, and test_affected (a template
# with {base}; dropping it makes the unit boundary run the whole suite, wider and not narrower).
# It keeps test in scope, unlike write_ci, which gives test its own CI step: a push weakening
# verify.test itself is exactly the case this check must catch.
for key in (k for k in verify_keys if k not in ("test_one", "test_affected", "format_fix")):
    o, n = get(old, "verify." + key), get(new, "verify." + key)
    # null or a non-string (true, a number, a list) both mean "no runnable command any more".
    if o and (not n or not isinstance(n, str)):
        print("verify.%s: a command -> %r" % (key, n))

o_paths = get(old, "hard_block_paths") or []
n_paths = get(new, "hard_block_paths") or []
removed = [p for p in o_paths if p not in n_paths]
if removed:
    print("hard_block_paths: dropped %r" % removed)
PY
)"
                [ -n "$report" ] && loosened="$loosened$report
"
            fi
        fi
    done

    if [ -n "$blocked" ]; then
        cat >&2 <<MSG

keel guard: push refused. '$blocked' is the default branch.

Work lands through a pull request, so this branch is written by a merge and not by a push. What
went to it directly skipped review, and on a shared branch that is not a mistake one person can
undo quietly.

  git switch -c <branch>
  git push -u origin <branch>

then open the pull request: 'gh pr create', or the link git prints on that push.

To push anyway, deliberately and on the record:  git push --no-verify
Or, if this project genuinely pushes to its default branch, set
conventions.protect_default_branch to false in .keel/profile.json.
MSG
        exit 1
    fi

    if [ -n "$loosened" ]; then
        cat >&2 <<MSG

keel guard: push refused. The profile is weaker on this branch than on the remote.

$loosened
Each of these lowers a gate, drops a blocked path, or removes a verify command this project was
relying on. If this is deliberate, say so in the commit and push past it once, on the record:

  git push --no-verify
MSG
        exit 1
    fi
fi

# The leak guard, after the checks above and before the supply chain scan. It is opted into, and
# what it guards against cannot be removed once pushed, so unlike the supply chain scan below it
# fails closed: with no keel, or one that lacks the mode, nothing was checked and the push is refused.
# That reverses, for the leak guard only, the 2026-09-27 choice to allow a push nothing could scan.
if [ "$LEAK_GUARD" = 1 ]; then
    if ! command -v keel >/dev/null 2>&1; then
        printf 'keel guard: the leak guard is on and keel is not on PATH, so nothing was checked. Push refused.\n' >&2
        exit 1
    fi
    case "$(keel --help 2>/dev/null)" in
        *"scan --leaks"*) ;;
        *)
            printf 'keel guard: the keel on PATH is too old for the leak guard, so nothing was checked. Push refused.\n' >&2
            exit 1 ;;
    esac
    leak_remote=origin
    [ "$#" -eq 0 ] || leak_remote="$1"
    if ! keel scan --leaks "$leak_remote" ${pairs[@]+"${pairs[@]}"}; then
        cat >&2 <<'MSG'

keel guard: push refused by the leak guard.

Each finding above names a commit, a field or a file, and the deny list line whose pattern
matched, never the matched text. Open the deny list on this machine to see the pattern, and do not
paste it anywhere public. Rewrite the commit (git commit --amend, or git rebase -i), then push
again.

A Claude-Session trailer is removed from every commit not yet pushed by running the commit-msg
hook over each of them again, where <upstream> is what the branch is based on (origin/main):

  git rebase <upstream> --exec 'git commit --amend --no-edit'

To push anyway, deliberately and on the record:  git push --no-verify
MSG
        exit 1
    fi
fi

# The installed keel's scanner, never one from the repository being pushed: a branch that edits
# tests/supply-chain-scan.sh would otherwise be judged by its own copy, and could weaken the check
# on the very push that publishes the change. With no keel reachable nothing is checked, and it
# says so rather than refusing: keel is often on PATH only inside an agent session, and a refusal
# outside one teaches --no-verify by reflex.
if ! command -v keel >/dev/null 2>&1; then
    printf 'keel guard: keel is not on PATH, so nothing was scanned. Push allowed.\n' >&2
    exit 0
fi

# What git feeds the hook is what gets scanned: each pushed commit and the history it carries, and
# never the working tree, which can hold a file the commit lacks or lack one it carries. git always
# passes the remote and its URL, so a hook with no arguments is one run by hand, and the working
# tree is what there is to scan. With git's arguments and nothing pushed, a delete or a push with
# nothing to update, nothing is published and nothing is scanned.
#
# The hook is written by the keel that installed it, and the scan runs with the keel on PATH, which
# can be older: one with no --push ignores it and scans the working tree while reading as a clean
# scan of the push. So it is asked first, and an older one says so and scans the working tree, as
# this hook did before, rather than pass a push it never looked at. Its help is read whole, not
# piped to grep -q, since grep stopping early would fail that pipeline under pipefail.
refused=0
if [ "$#" -eq 0 ]; then
    printf 'keel guard: scanning the working tree\n'
    keel scan || refused=1
elif [ -n "$pushed" ]; then
    case "$(keel --help 2>/dev/null)" in
        *"scan --push"*)
            printf 'keel guard: scanning before push\n'
            for sha in $pushed; do
                keel scan --push "$1" "$sha" || refused=1
            done ;;
        *)
            printf 'keel guard: the keel on PATH is too old to scan the commits being pushed, so the working tree is scanned instead. Update keel to scan what is pushed.\n' >&2
            keel scan || refused=1 ;;
    esac
fi
[ "$refused" -eq 0 ] && exit 0

cat >&2 <<'MSG'

keel guard: push refused.

Everything above either runs on, or leaks to, whoever clones or installs this. Once it is on a
remote it is in history permanently, which is why the refusal is here rather than in review.

For a committed key, keystore or certificate, deleting the file is not the fix. It stays in
history, so the credential has to be rotated with whoever issued it.

If a finding is wrong, there are two ways to record that, and both stay visible on every run:

  a line in a text file   append to that line:  supply-chain-scan: allow <why this one is fine>
  a whole file            add to .keel/scan-allow:  <path> <why this one is fine>

To push anyway, deliberately and on the record:  git push --no-verify
MSG
exit 1
HOOK
}

# The commit-msg hook, written only while the leak guard is on. It rewrites the message through a
# temporary file, in this order: it removes every Claude-Session line, adds a Signed-off-by for the
# author, then asks the installed keel to check the message against the deny list. A keel that is
# absent, or whose help does not name the mode, cannot check it, and an older keel answers an unknown
# mode by running the supply chain scan and exiting 0, so its exit status would pass every message:
# the capability is read from the help, whole, as the pre-push hook reads it, and the commit is
# refused when it is missing.
guard_commit_msg_body() {
    cat <<'HOOK'
#!/usr/bin/env bash
# commit-msg hook, installed by `keel guard install` when the leak guard is on (--leak-guard).
# Remove with `keel guard uninstall`, or `keel guard install --no-leak-guard`. To commit past it
# once, on the record:
#   git commit --no-verify
set -uo pipefail

msg="${1:-}"
[ -n "$msg" ] && [ -f "$msg" ] || exit 0

tmp="$(mktemp "${TMPDIR:-/tmp}/keel-commit-msg.XXXXXX")" || exit 1
trap 'rm -f "$tmp"' EXIT

# Every line whose key is Claude-Session, in any case, is dropped. Every other line is kept as it
# is, Co-Authored-By lines included.
LC_ALL=C awk 'tolower(substr($0, 1, 15)) != "claude-session:"' "$msg" > "$tmp" || exit 1
cat "$tmp" > "$msg" || exit 1

# The sign-off, as git var gives the author: "Name <email> time zone", of which the last two fields
# are not wanted. addIfDifferent adds it once however many times the message passes through.
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null)" || ident=""
ident="${ident% *}"
ident="${ident% *}"
if [ -n "$ident" ]; then
    git interpret-trailers --in-place --if-exists addIfDifferent \
        --trailer "Signed-off-by: $ident" "$msg" || exit 1
fi

# A usable keel names the mode in its help, which is read whole and not piped to grep -q.
usable=0
if command -v keel >/dev/null 2>&1; then
    case "$(keel --help 2>/dev/null)" in
        *"scan --leaks-message"*) usable=1 ;;
    esac
fi
if [ "$usable" -eq 0 ]; then
    printf 'keel guard: the leak guard is on and the keel on PATH cannot check a message, so nothing was checked. Commit refused.\n' >&2
    exit 1
fi

keel scan --leaks-message "$msg"
rc=$?
case "$rc" in
    0) exit 0 ;;
    1)
        printf 'keel guard: commit refused by the leak guard. The message is kept in .git/COMMIT_EDITMSG; edit it and commit again.\n' >&2
        exit 1 ;;
    *)
        printf 'keel guard: the leak guard is on and the keel on PATH cannot check a message, so nothing was checked. Commit refused.\n' >&2
        exit 1 ;;
esac
HOOK
}

# The commit gate. Installed alongside the push hook and inert until the profile turns it on, which
# is why it is a gate rather than part of the install: a team adopts the guard for its push
# protections, and a commit gate that arrived uninvited with them is how the whole thing gets
# uninstalled.
#
# It refuses and never formats. house-defaults and coding-standards both require a gate to be a
# check-only command, and a hook that rewrites files and re-stages them puts content into a commit
# its author never read.
guard_precommit_body() {
    cat <<'HOOK'
#!/usr/bin/env bash
# pre-commit hook, installed by `keel guard install`.
#
# Off unless the project asks for it: set gates.commit_guard to "required" to block a commit, or to
# "warn" to report and let it through. Anything else, including the "off" that init writes, and this
# hook does nothing.
#
# It checks and never rewrites, so a failure names verify.format_fix as the remedy rather than
# running it. Remove with `keel guard uninstall`. To commit past it once, on the record:
#   git commit --no-verify
set -uo pipefail

# python3 rather than the sed the pre-push hook uses for its one field. A verify command can contain
# quotes, and `test -z "$(gofmt -l .)"` is one keel writes itself: pulling that out of JSON with a
# regex yields a command that no longer runs, which reads as the project failing its own gate.
field() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
d = json.load(open(".keel/profile.json"))
for k in sys.argv[1].split("."):
    if not isinstance(d, dict) or k not in d: sys.exit(1)
    d = d[k]
print("" if d is None else d)
PY
}

[ -f .keel/profile.json ] || exit 0
# python3 -c 'pass' rather than command -v: Windows' App Execution Alias puts a python3.exe on
# PATH that prints a not-found message and exits 49 without running anything, and command -v would
# call that present.
if ! python3 -c 'pass' >/dev/null 2>&1; then
    printf 'keel guard: python3 is absent, so nothing was checked. Commit allowed.\n' >&2
    exit 0
fi

gate="$(field gates.commit_guard || true)"
case "$gate" in
  required|warn) ;;
  *) exit 0 ;;
esac

# The fast subset, and only that. Tests are absent deliberately: verify.test_one takes a name this
# hook has no way to derive from a changed file, and running a whole suite on every commit is how a
# gate gets bypassed by reflex.
failed=""
for k in format lint typecheck; do
    cmd="$(field "verify.$k" || true)"
    [ -n "$cmd" ] || continue
    # The two shapes doctor also declines to run. A template is not a command until something fills
    # it in, and filling it in here would mean guessing.
    case "$cmd" in *"{path}"*|*"{name}"*) continue ;; esac
    printf 'keel guard: %s\n' "$cmd"
    eval "$cmd" || failed="$failed  verify.$k: $cmd
"
done

[ -n "$failed" ] || exit 0

{
    printf '\n'
    if [ "$gate" = "warn" ]; then
        printf 'keel guard: these did not pass. The commit was allowed because gates.commit_guard\n'
        printf 'is "warn" rather than "required".\n\n'
    else
        printf 'keel guard: commit refused.\n\n'
    fi
    printf '%s\n' "$failed"
    fix="$(field verify.format_fix || true)"
    if [ -n "$fix" ]; then
        printf 'To format in place:  %s\n\n' "$fix"
    fi
    printf 'These are gates, so they check and never rewrite. A hook that reformatted your files\n'
    printf 'would put content into a commit its author never read.\n\n'
    printf 'To commit anyway, deliberately and on the record:  git commit --no-verify\n'
    printf 'Or set gates.commit_guard to "off" in .keel/profile.json.\n'
} >&2

[ "$gate" = "warn" ] && exit 0
exit 1
HOOK
}

# Appends the keel_version a commit was made under, so a later question ("was this commit made
# under a standard that would have caught this") is answerable from `git log` rather than by
# cross-referencing dates by hand. Mechanical, because a trailer someone has to remember to type is
# a trailer that is missing exactly when it matters. Only keel_version: the model that produced a
# dispatched change is already visible live in its description, per the 2026-09-19 CHANGELOG entry,
# and durability for that claim is a separate, unsettled question this hook does not attempt.
guard_prepare_commit_msg_body() {
    cat <<'HOOK'
#!/usr/bin/env bash
# prepare-commit-msg hook, installed by `keel guard install`.
# Remove with `keel guard uninstall`.
set -uo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0
[ -f .keel/profile.json ] || exit 0

# conventions.no_attribution_footers true means this repository's commit messages are a title and a
# body and nothing else, and a trailer is a footer. Read with sed, like keel_version below, because
# a git hook cannot count on python3.
footers="$(sed -n 's/.*"no_attribution_footers": *\([a-z]*\).*/\1/p' .keel/profile.json 2>/dev/null | head -1)"
[ "$footers" = true ] && exit 0

version="$(sed -n 's/.*"keel_version": *"\([^"]*\)".*/\1/p' .keel/profile.json 2>/dev/null | head -1)"
[ -n "$version" ] || exit 0

# --if-exists doNothing is the duplicate guard: an amend, a reword, or a squash brings the previous
# message, trailer included, back through this hook. Placed above git's comment block, not after
# it, which a raw append gets wrong in the editor flow. Never fails the commit: a trailer is worth
# having and not worth refusing a commit over.
git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Keel-Version: $version" "$msg_file" 2>/dev/null || exit 0
HOOK
}

cmd_guard() {
    git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository."
    case "${1:-status}" in
        install)
            local st d f others leak="" explicit_off="" arg; st="$(guard_state)"; d="$(guard_dir)"
            shift
            for arg in "$@"; do
                case "$arg" in
                    --leak-guard)    [ "$leak" != 0 ] || die "--leak-guard and --no-leak-guard exclude each other."; leak=1 ;;
                    --no-leak-guard) [ "$leak" != 1 ] || die "--leak-guard and --no-leak-guard exclude each other."; leak=0; explicit_off=1 ;;
                    *) die "unknown option '$arg' for guard install. Try --leak-guard or --no-leak-guard." ;;
                esac
            done
            # A reinstall keeps the choice the installed pre-push holds, so an upgrade cannot switch
            # the leak guard off silently. Only --no-leak-guard does.
            if [ -z "$leak" ]; then
                if guard_leak_on; then leak=1; else leak=0; fi
            fi
            # Decided by guard_state, not by the setting's value: a .githooks without keel's mark
            # is a project's own hooks, and unsetting core.hooksPath would switch them off.
            if [ "$st" = foreign-path ]; then
                die "core.hooksPath is $(guard_hooks_path_source) and not by keel, so git runs no hooks from $d. Replacing it would switch those hooks off; unset it yourself if keel's guard should take their place."
            fi
            if f="$(guard_foreign_hook)"; then
                die "$d/$f is another tool's hook, and installing would overwrite it. Remove or rename it, then re-run."
            fi
            # The leak guard writes a fourth hook, so another tool's commit-msg refuses it as another
            # tool's pre-push refuses the rest. A repository that never opted in ignores it.
            if [ "$leak" = 1 ] && [ -e "$d/commit-msg" ] && ! grep -qF "$GUARD_MARK" "$d/commit-msg"; then
                die "$d/commit-msg is another tool's hook, and installing would overwrite it. Remove or rename it, then re-run."
            fi
            # Checked before anything is written, so a refusal leaves the repository as it was.
            if [ "$st" = legacy ]; then
                others="$(guard_legacy_others)"
                [ -z "$others" ] || die "$GUARD_LEGACY_DIR/ also holds $others, hooks keel did not write, and unsetting core.hooksPath would stop them running. Move them into $d or remove them, then re-run."
            fi
            mkdir -p "$d"
            GUARD_LEAK_CHOICE="$leak"
            guard_hook_body > "$d/pre-push"
            guard_precommit_body > "$d/pre-commit"
            guard_prepare_commit_msg_body > "$d/prepare-commit-msg"
            chmod +x "$d/pre-push" "$d/pre-commit" "$d/prepare-commit-msg"
            local off_said=""
            if [ "$leak" = 1 ]; then
                guard_commit_msg_body > "$d/commit-msg"
                chmod +x "$d/commit-msg"
            elif [ "$explicit_off" = 1 ]; then
                # Only a commit-msg carrying keel's mark is removed: another tool's is left alone, and
                # the line below says "removed" only when there is none standing in its place.
                if grep -qF "$GUARD_MARK" "$d/commit-msg" 2>/dev/null; then rm -f "$d/commit-msg"; fi
                [ -e "$d/commit-msg" ] || off_said=1
            fi
            if [ "$st" = legacy ]; then
                # The unset reaches this repository's own config only, so a setting from another
                # scope, a global one included, is named rather than retried.
                git config --unset core.hooksPath 2>/dev/null || die "could not unset core.hooksPath, which is $(guard_hooks_path_source). Unset it in that config, which for a global or system setting changes every repository on the machine, then re-run 'keel guard install'."
                # Only the repository's own setting is unset. One from another scope then takes
                # over, and git would run none of the hooks just written.
                [ "$(guard_state)" = installed ] || die "unset this repository's core.hooksPath, but git now reads core.hooksPath as $(guard_hooks_path_source), so it runs no hooks from $d. Unset it there, then re-run 'keel guard install'."
                say "moved the guard out of $GUARD_LEGACY_DIR/, a working-tree path that every checkout replaces, and unset core.hooksPath. Delete $GUARD_LEGACY_DIR/, with 'git rm -r $GUARD_LEGACY_DIR' where it is committed"
            fi
            if [ "$leak" = 1 ]; then
                say "installed pre-push, pre-commit, prepare-commit-msg and commit-msg in $d, where no checkout can replace them"
                say "the leak guard is on: each push and each commit message is checked against the deny list"
            else
                say "installed pre-push, pre-commit and prepare-commit-msg in $d, where no checkout can replace them"
                [ -z "$off_said" ] || say "the leak guard is off; removed keel's commit-msg"
            fi
            say "the commit hook stays inert until gates.commit_guard is 'required' or 'warn'"
            say "the hooks are not committed: each clone runs 'keel guard install' for itself"
            ;;
        uninstall)
            local d f others; d="$(guard_dir)"
            # Only files carrying keel's mark: a same-named hook without it is another tool's.
            for f in pre-push pre-commit prepare-commit-msg commit-msg; do
                if grep -qF "$GUARD_MARK" "$d/$f" 2>/dev/null; then rm -f "$d/$f"; fi
            done
            # An install at .githooks is unhooked, not deleted: those files are often committed,
            # and keel does not delete tracked files. Not even unhooked while it also holds hooks
            # keel did not write, since unsetting core.hooksPath would stop those running too.
            if [ "$(guard_state)" = legacy ] && others="$(guard_legacy_others)" && [ -n "$others" ]; then
                say "left core.hooksPath pointing at $GUARD_LEGACY_DIR/, which also holds $others, hooks keel did not write. keel's own hooks there still run; remove them and the setting yourself if you want them gone"
            elif [ "$(guard_state)" = legacy ]; then
                if git config --unset core.hooksPath 2>/dev/null; then
                    say "unset core.hooksPath, which pointed at keel's old install in $GUARD_LEGACY_DIR/. Delete $GUARD_LEGACY_DIR/ yourself, with 'git rm -r $GUARD_LEGACY_DIR' where it is committed"
                else
                    say "left core.hooksPath as $(guard_hooks_path_source), which this repository cannot unset, so keel's old hooks in $GUARD_LEGACY_DIR/ still run. Unset it in that config, which for a global or system setting changes every repository on the machine"
                fi
            fi
            say "removed keel's push, commit and message hooks from $d. Hooks other tools wrote are untouched"
            ;;
        status)
            local d st others; d="$(guard_dir)"
            st="$(guard_state)"
            if [ "$st" = installed ]; then
                # A hook body is fixed at install time, and one written before keel scan --push
                # scans the working tree rather than the commits being pushed.
                if grep -qF "scan --push" "$d/pre-push"; then
                    say "push guard: active"
                else
                    say "push guard: installed before it scanned the commits being pushed, so it scans the working tree. Re-run 'keel guard install'"
                fi
                local cg; cg="$(json_get .keel/profile.json gates.commit_guard 2>/dev/null || true)"
                if [ -e "$d/pre-commit" ] && ! grep -qF "$GUARD_MARK" "$d/pre-commit"; then
                    say "commit guard: not keel's. $d/pre-commit is another tool's hook"
                elif [ ! -x "$d/pre-commit" ]; then
                    say "commit guard: not installed. Re-run 'keel guard install'"
                else
                    case "$cg" in
                      required) say "commit guard: active. format, lint and typecheck run before each commit" ;;
                      warn)     say "commit guard: reporting only (gates.commit_guard is 'warn')" ;;
                      *)        say "commit guard: installed but off. Set gates.commit_guard to 'required' in .keel/profile.json" ;;
                    esac
                fi
                if [ -e "$d/prepare-commit-msg" ] && ! grep -qF "$GUARD_MARK" "$d/prepare-commit-msg"; then
                    say "message guard: not keel's. $d/prepare-commit-msg is another tool's hook"
                elif [ ! -x "$d/prepare-commit-msg" ]; then
                    say "message guard: not installed. Re-run 'keel guard install'"
                else
                    # The line says what the hook will do, and a hook body is fixed at install time:
                    # one written before the hook read conventions.no_attribution_footers adds the
                    # trailer whatever the key says. Read with the hook's own sed, because that read
                    # is the one the hook acts on.
                    local nf_key; nf_key="$(sed -n 's/.*"no_attribution_footers": *\([a-z]*\).*/\1/p' .keel/profile.json 2>/dev/null | head -1)"
                    if [ "$nf_key" != true ]; then
                        say "message guard: active. commits get a Keel-Version trailer"
                    elif grep -q no_attribution_footers "$d/prepare-commit-msg"; then
                        say "message guard: installed, adds no trailer (conventions.no_attribution_footers is true)"
                    else
                        say "message guard: installed before conventions.no_attribution_footers, so commits still get a Keel-Version trailer. Re-run 'keel guard install'"
                    fi
                fi
                # Only a repository that opted in sees these lines; the others' status is unchanged.
                if guard_leak_on; then
                    local lshown
                    deny_load
                    lshown="$(leak_deny_shown)"
                    if [ ! -x "$d/commit-msg" ] || ! grep -qF "$GUARD_MARK" "$d/commit-msg"; then
                        say "leak guard: on, but commit-msg is missing or not keel's. Re-run 'keel guard install --leak-guard'"
                    elif [ -f "$DENY_FILE" ]; then
                        say "leak guard: on, deny list loaded ($DENY_LOADED patterns)"
                    else
                        say "leak guard: on, WARNING no deny list at $lshown, generic patterns only"
                    fi
                fi
            elif [ "$st" = legacy ]; then
                # install refuses to move it while hooks keel did not write sit beside it, so those
                # are named first rather than sending the user to a command that will refuse.
                others="$(guard_legacy_others)"
                if [ -n "$others" ]; then
                    say "push guard: installed in $GUARD_LEGACY_DIR/, a working-tree path, so checking out a branch runs that branch's own hooks. $GUARD_LEGACY_DIR/ also holds $others, hooks keel did not write: move them into $d or remove them before 'keel guard install' can move the guard"
                else
                    say "push guard: installed in $GUARD_LEGACY_DIR/, a working-tree path, so checking out a branch runs that branch's own hooks. Re-run 'keel guard install' to move it into $d"
                fi
                return 1
            elif [ "$st" = foreign-path ]; then
                say "push guard: inactive. core.hooksPath, which keel did not set, is $(guard_hooks_path_source)"
                return 1
            elif [ "$st" = foreign-hook ]; then
                say "push guard: not installed. $d/$(guard_foreign_hook) is another tool's hook"
                return 1
            else
                say "push guard: not installed. Run 'keel guard install'"
                return 1
            fi
            ;;
        *) die "unknown guard subcommand '$1'. Try install, uninstall, or status." ;;
    esac
}

# `keel plan status` and `keel plan tick` read and tick an implementation plan's steps by id. A
# step is a checkbox line whose bold title opens with its id, `- [ ] **Step 3.2: Hand over**`, the
# form skills/write-plan/references/plan-template.md writes. Its box is ` ` open, `x` done, `-`
# deferred or `~` not applicable, and anything after the closing ** is its tail: a note, or a
# deferred step's reason. A line inside a fenced code block is an example, as the template's own
# are, so it is never a step.
#
# PLAN_AWK_LIB is prepended to both commands' awk programs so they cannot disagree about what a step
# is. fenced(line) tracks fences and returns 1 for a fence line or a line inside one. It reads them
# as CommonMark does: a fence opens only on a line indented at most three columns (a tab counting to
# the next multiple of four), since a line indented further is code or a fence's content, and closes
# only on a line of the same character, at least as long, indented at most three columns past the
# list item it opened in, with nothing but spaces after it. So a ```` fence holding a ``` example
# stays open, as the template writes its nested examples, and so does a fence holding a fence line
# indented four or more columns past it: read as a closer, such a line would end the outer fence,
# and the outer closer would open a phantom fence hiding the next task and its open steps from
# status, and so from ship's gate. A fence may open after one list marker, `1. ```bash`, as
# CommonMark allows, since a missed one's closing line would open a phantom fence hiding steps, and
# such a fence also closes when its item ends, at a list item indented less than the fence's
# content, so one never closed cannot hide the steps after it. A fence opened on its own line inside
# a list item, as listctx() tracks the open items, belongs to the item as CommonMark has it: it
# closes on a closer at most three columns past the item's content, and ends with the item, at a
# non-blank line indented less than that content, so one left open, or one opened by an example's
# stray last ```, cannot hide the plan after its item. A line that ends the item and has the form of
# the fence's closer is read as that closer, where CommonMark opens a new fence, because the new
# fence would hide every line after it. Outside a list item an indented fence keeps CommonMark's
# reading, content at any indent, since only an item bounds it. A line opening with an inline
# backtick span is not a fence: a backtick run followed later on its line by another backtick opens
# none, as CommonMark rules. A closing fence may end in CR, since a CRLF checkout adds one.
# step(line) returns 1 for a step line and sets sid, smark, stitle and stail.
PLAN_AWK_LIB='
function lead(line,   i, c, n) {
    n = 0
    for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (c == " ") n++
        else if (c == "\t") n += 4 - n % 4
        else break
    }
    return n
}
function fenced(line,   t, c, n, s, r, ind, blank, ded) {
    t = line; sub(/^[ \t]+/, "", t)
    ind = lead(line); blank = (t == "" || t == "\r")
    # Indentation is compared in columns, as findent is counted, since a tab reaches the next
    # multiple of four and counted as one character it would end the fence four columns early.
    if (infence && findent && t ~ /^([-*+]|[0-9]+[.)])[ \t]/ && ind < findent)
        infence = 0
    # A fence opened inside a list item ends where the item does, at a non-blank line indented less
    # than the content of the item, since fenced code has no lazy continuation.
    ded = 0
    if (infence && fitem && !blank && ind < fitem) { infence = 0; ded = 1 }
    c = substr(t, 1, 1); n = 0
    if (c == "`" || c == "~") while (substr(t, n + 1, 1) == c) n++
    if (infence) {
        if (n >= 3 && c == fch && n >= flen && ind - findent <= 3 &&
            substr(t, n + 1) ~ /^[ \t\r]*$/) { infence = 0; lpara = 0; return 1 }
        return 1
    }
    listctx(t, ind, blank, n)
    # The item ended on a line that would close its fence: CommonMark opens a new fence there, which
    # would hide every line after it, so it is read as the closer, which hides none.
    if (ded && n >= 3 && c == fch && n >= flen && substr(t, n + 1) ~ /^[ \t\r]*$/) return 1
    # s is the column the content of a list item on this line starts at, counted in columns, as
    # ind is, since a tab after the marker reaches the next multiple of four.
    s = 0; r = t
    if (sub(/^([-*+]|[0-9]+[.)])/, "", r) && r ~ /^[ \t]/) {
        s = ind + length(t) - length(r); t = r; sub(/^[ \t]+/, "", t)
        s = lead(sprintf("%" s "s", "") substr(r, 1, length(r) - length(t)))
    }
    c = substr(t, 1, 1)
    if (c == "`" || c == "~") {
        n = 0; while (substr(t, n + 1, 1) == c) n++
        if (n >= 3) {
            if (ind > 3) return 0
            if (c == "`" && index(substr(t, n + 1), "`")) return 0
            infence = 1; fch = c; flen = n; fline = NR; findent = s; fitem = 0
            # A fence on its own line inside a list item belongs to the item: it closes on a line
            # at most three columns past the content of the item, and ends with the item.
            if (s == 0 && ind > 0 && nli > 0 && ind >= li[nli]) {
                findent = li[nli]; fitem = li[nli]
            }
            return 1
        }
    }
    return 0
}
# listctx(t, ind, blank, n): tracks the open list items, as li[1..nli], each the column its content
# starts at, for a line outside a fence: t is the line without its indent, ind that indent in
# columns, and n the length of a fence run it opens with. A list item closes the items its marker is
# not inside and opens one; any other non-blank line indented less than the content of the innermost
# item closes the items it is not inside, unless it continues a paragraph (lazily, as CommonMark
# allows).
function listctx(t, ind, blank, n,   r, w, cc) {
    if (blank) { lpara = 0; return }
    if (t ~ /^([-*+]|[0-9]+[.)])([ \t]|\r?$)/) {
        r = t; sub(/^([-*+]|[0-9]+[.)])/, "", r)
        w = ind + length(t) - length(r)
        cc = lead(sprintf("%" w "s", "") r)
        if (r ~ /^[ \t\r]*$/ || cc - w > 4) cc = w + 1
        while (nli > 0 && li[nli] > ind) nli--
        li[++nli] = cc; lpara = 1
        return
    }
    if (nli > 0 && ind < li[nli] && !(lpara && n < 3 && substr(t, 1, 1) != "#"))
        while (nli > 0 && li[nli] > ind) nli--
    lpara = (n < 3 && substr(t, 1, 1) != "#")
}
function step(line,   rest, i, j, t) {
    if (line !~ /^- \[[ xX~-]\] \*\*Step [0-9]+[a-z]*\.[0-9]+: /) return 0
    smark = substr(line, 4, 1); if (smark == "X") smark = "x"
    rest = substr(line, 14)
    i = index(rest, ": "); sid = substr(rest, 1, i - 1); rest = substr(rest, i + 2)
    # The title ends at the first ** that ends the line or opens a note or reason, since a title may
    # hold one, as a glob does, and parking rewrites all after the end. With none such it ends at the
    # first **, so a parked step whose tail lacks its prefix stays a step that status flags.
    for (i = 1; (j = index(substr(rest, i), "**")) > 0; i += j) {
        t = substr(rest, i + j + 1)
        if (t == "" || t == "\r" || t ~ /^ (Note|Deferred|Not applicable): /) {
            stitle = substr(rest, 1, i + j - 2); stail = t
            return 1
        }
    }
    i = index(rest, "**"); if (i == 0) return 0
    stitle = substr(rest, 1, i - 1); stail = substr(rest, i + 2)
    return 1
}
'

cmd_plan() {
    case "${1:-}" in
        status) shift
                [ "$#" -eq 1 ] || die "usage: keel plan status <plan>"
                plan_status "$1" ;;
        tick)   shift; plan_tick "$@" ;;
        report) shift; plan_report "$@" ;;
        risk)   shift; plan_risk "$@" ;;  batches) shift; plan_batches "$@" ;;
        *) die "unknown plan subcommand '${1:-}'. Try status, tick, report, risk or batches." ;;
    esac
}

# plan_unaddressable <plan>: prints that the plan has no step ids, as one written before steps
# carried them. Neither status nor tick can find a step in it, so after printing this they exit 3,
# which a caller tells apart from a plan that is merely not done, and reads the plan by hand.
plan_unaddressable() {
    err "$1 has no step ids, so it is unaddressable: read and tick its checkboxes by hand"
}

# plan_status <plan>: one line per task, in the order tasks first appear, counting its steps by
# state, then `next: <id>` for the first open step, or `next: none`, then a `problem:` line for each
# deferred or not-applicable step with no reason, each id that appears twice, each open checkbox
# that is not a step it can read, and a fence that never closes, and exit 1 when there is one. A
# reason must start with a character that is not blank (a space, tab or CR). A parked step without
# its reason is indistinguishable from a forgotten one, and a repeated id names no one step. An open
# box is recognised in any GFM list-item form, `-`, `*`, `+` or numbered, indented or quoted, and
# one it cannot read, for its form or a missing id, is open work that ship's gate, which reads this,
# would otherwise pass. An unclosed fence hides every step after the line it opens on, so an
# unfinished plan would read as done. A plan with no step ids exits 3; a fence that never closes is
# reported as such rather than as a plan without ids.
plan_status() {
    [ -f "$1" ] || die "no such plan: $1"
    local rc
    # shellcheck disable=SC2016  # $0 is awk's record, not a shell expansion
    awk "$PLAN_AWK_LIB"'
        fenced($0) { next }
        step($0) {
            nstep++
            task = sid; sub(/\.[0-9]+$/, "", task)
            if (!(task in seen)) { seen[task] = 1; order[++ntask] = task }
            count[task, smark]++
            if (smark == " " && nextid == "") nextid = sid
            if (sid in ids) problem[++nproblem] = "step " sid " appears more than once"
            ids[sid] = 1
            if (smark == "-" && stail !~ /^ Deferred: [^ \t\r]/)
                problem[++nproblem] = "step " sid " is deferred with no reason"
            if (smark == "~" && stail !~ /^ Not applicable: [^ \t\r]/)
                problem[++nproblem] = "step " sid " is not applicable with no reason"
        }
        /^[ \t>]*([-*+]|[0-9]+[.)])[ \t]+\[ \]/ && !step($0) {
            problem[++nproblem] = "line " NR " is an open checkbox that is not a step keel can read"
        }
        END {
            if (!nstep && !infence) exit 3
            for (k = 1; k <= ntask; k++) {
                t = order[k]
                printf "task %s: %d done, %d open, %d deferred, %d not applicable\n",
                    t, count[t, "x"], count[t, " "], count[t, "-"], count[t, "~"]
            }
            print "next: " (nextid == "" ? "none" : nextid)
            if (infence) problem[++nproblem] = "line " fline " opens a fence that never closes"
            for (k = 1; k <= nproblem; k++) print "problem: " problem[k]
            exit (nproblem > 0 ? 1 : 0)
        }' "$1"
    rc=$?
    [ "$rc" -ne 3 ] || plan_unaddressable "$1"
    return "$rc"
}

# plan_report <plan> [--json]: when the plan was planned, when each task and the whole plan were
# delivered, the lead time between them, and how many commits since reworked it, all from git.
# Nothing is stored: a plan's own history is the record. Times are author times, since a rebase
# rewrites committer times and this measures when the work was done, shown in UTC and subtracted as
# epochs. Planned is the author time of the first commit that has the plan. A step closes, by any
# mark, at a commit where it is closed and is open or absent in every parent that has the plan; a
# commit that adds the plan has no such parent, so a step already closed there closes there. A merge
# therefore closes nothing that a branch it brought in had closed, and tasks run in parallel
# worktrees keep the times of their own commits. A step's time is its latest close, so one closed,
# reopened and closed again dates from its last close; a task's time is the latest of its steps',
# and the task is open while any step of it is, in the latest committed copy. The history walk keeps
# every side of a merge (--full-history) in topological order. Each committed copy is read by
# PLAN_AWK_LIB, so a step means here what it means to status. The working-tree copy is never read,
# so an uncommitted tick changes nothing; the history is the plan's path alone, so a rename starts
# it again. The path is a literal one, never a pattern, and may be any name git can hold. Rounds,
# routing and loop are the last `rounds: <n>`, the last `routing: <text>` and the last
# `loop: <light|full>` in the notes of the task's done steps, read in the plan's order (a loop that
# is neither word is not read, and a task with none prints none); the note is the text after the
# last ` Note: ` in the step's tail, as plan tick writes it, so step text before it, or a step with
# no note, is never read as fields; a field begins the note or follows `; `, so `subrounds: 3` and
# prose such as `Implementer routing: x` are not fields, and routing runs to the next `;` or the end
# of the note. The loop is what `keel plan risk` decided for the task; execute-plan writes it into
# the same note. Rework counts the commits reachable from HEAD that carry the line `Reworks <path>`
# alone, the path as git has it from the repository root, so a line naming another plan, or one this
# path begins, is not one. A plan with no step ids exits 3, as status does; one with no commit that
# has it exits 4; a shallow clone exits 5, since the commits the times come from are not there.
#
# plan_report_copy <top> <rel> <commit> <tag>: the facts one committed copy gives, as tab separated
# lines for plan_report's awk: <tag> the commit and its author time (C for a commit in the plan's
# history, which may close a step; X for one read only to judge those against), P the commit and each
# parent that also has the plan, S a step's id, mark and tail, H the routing header. Returns 1 for a
# commit without the plan.
plan_report_copy() {
    local top="$1" rel="$2" hash="$3" tag="$4" copy at parents p
    copy="$(git -C "$top" show "$hash:$rel" 2>/dev/null)" || return 1
    read -r at parents <<< "$(git -C "$top" show -s --format='%at %P' "$hash")"
    printf '%s\t%s\t%s\n' "$tag" "$hash" "$at"
    for p in $parents; do
        if git -C "$top" cat-file -e "$p:$rel" 2>/dev/null; then printf 'P\t%s\t%s\n' "$hash" "$p"; fi
    done
    # shellcheck disable=SC2016  # $0 is awk's record, not a shell expansion
    printf '%s\n' "$copy" | awk -v c="$hash" "$PLAN_AWK_LIB"'
        fenced($0) { next }
        step($0) {
            t = stail; sub(/\r$/, "", t)
            printf "S\t%s\t%s\t%s\t%s\n", c, sid, smark, t
            next
        }
        /^\*\*Implementer routing:\*\*/ && !seen {
            v = $0; sub(/^\*\*Implementer routing:\*\*[ \t]*/, "", v); sub(/[ \t\r]+$/, "", v)
            printf "H\t%s\t%s\n", c, v; seen = 1
        }'
}

plan_report() {
    local plan="" json=0 a dir base rel list facts="" hash one need fin last="" top n=0 hashes="" msg rc
    for a in "$@"; do
        case "$a" in
            --json) json=1 ;;
            -*) die "unknown option '$a'. Usage: keel plan report <plan> [--json]" ;;
            *) [ -z "$plan" ] || die "usage: keel plan report <plan> [--json]"; plan="$a" ;;
        esac
    done
    [ -n "$plan" ] || die "usage: keel plan report <plan> [--json]"
    [ -f "$plan" ] || die "no such plan: $plan"
    dir="$(cd "$(dirname "$plan")" && pwd)" || die "cannot read the directory of $plan"
    base="$(basename "$plan")"
    # The walk runs from the top of the tree, where a root-relative path means what it says.
    top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || top=""
    if [ -n "$top" ] && [ "$(git -C "$top" rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then
        err "$plan is in a shallow clone, which lacks the commits its planned and delivered times come from: run git fetch --unshallow, then report again"
        return 5
    fi
    # The path is looked up from the plan's own directory, so a relative path from anywhere in the
    # tree reports the same; --full-name makes it one `git show <commit>:<path>` takes. Every path
    # is literal, never a pattern (d/p[1].md is not d/p1.md), and -z hands it back unquoted, so a
    # name with non-ASCII characters is exact.
    rel=""
    IFS= read -r -d '' rel < <(git --literal-pathspecs -C "$dir" ls-files -z --full-name -- "$base" 2>/dev/null) || true
    list=""
    [ -z "$rel" ] || [ -z "$top" ] || list="$(git --literal-pathspecs -C "$top" rev-list --full-history --topo-order --reverse HEAD -- "$rel" 2>/dev/null)"
    if [ -z "$list" ]; then
        err "$plan has no history yet: commit it, and the report reads the commits"
        return 4
    fi
    while read -r hash; do
        [ -n "$hash" ] || continue
        # A commit that does not have the plan, one that deleted it, is skipped.
        one="$(plan_report_copy "$top" "$rel" "$hash" C)" || continue
        facts="$facts$one"$'\n'; last="$hash"
    done <<EOF
$list
EOF
    # The latest copy is HEAD's, or the last that has the plan where HEAD has deleted it.
    if git -C "$top" cat-file -e "HEAD:$rel" 2>/dev/null; then fin="$(git -C "$top" rev-parse HEAD)"; else fin="$last"; fi
    if [ -z "$fin" ]; then
        err "$plan has no history yet: commit it, and the report reads the commits"
        return 4
    fi
    # The parents that carry the plan, and the latest copy, may not be in the walk (the plan is the
    # same there as in a commit that is); their copies are what a closing is judged against, and they
    # close nothing themselves.
    need="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "P" { print $3 }'; printf '%s\n' "$fin")"
    need="$(sort -u <<< "$need")"
    while read -r hash; do
        [ -n "$hash" ] || continue
        if ! grep -qxF -e "$hash" <<< "$list"; then
            one="$(plan_report_copy "$top" "$rel" "$hash" X)" || continue
            facts="$facts$one"$'\n'
        fi
    done <<EOF
$need
EOF
    facts="$(printf 'F\t%s\n' "$fin")"$'\n'"$facts"
    # --fixed-strings finds the candidates; the line must then stand alone, which a pattern cannot
    # say. The message is read through a here-string: a pipe into grep -q can die of SIGPIPE under
    # pipefail and read as no match.
    while read -r hash; do
        [ -n "$hash" ] || continue
        msg="$(git -C "$top" show -s --format=%B "$hash")"
        if grep -qxF -e "Reworks $rel" <<< "$msg"; then
            n=$((n + 1)); hashes="$hashes $(git -C "$top" rev-parse --short "$hash")"
        fi
    done <<EOF
$(git -C "$top" rev-list --fixed-strings --grep="Reworks $rel" HEAD)
EOF
    # shellcheck disable=SC2016  # $0 is awk's record, not a shell expansion
    RW_N="$n" RW_H="$hashes" awk -v json="$json" -v rel="$rel" '
        # The UTC date of an epoch, by the civil-from-days arithmetic, so that neither a date that
        # takes -d nor one that takes -r is needed, and BSD and GNU awk agree.
        function iso(e,   days, z, era, doe, yoe, y, doy, mp, d, m, s) {
            days = int(e / 86400); s = e - days * 86400
            z = days + 719468; era = int(z / 146097); doe = z - era * 146097
            yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
            y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
            mp = int((5 * doy + 2) / 153); d = doy - int((153 * mp + 2) / 5) + 1
            m = (mp < 10) ? mp + 3 : mp - 9; if (m <= 2) y++
            return sprintf("%04d-%02d-%02dT%02d:%02d:%02dZ", y, m, d, int(s / 3600), int(s % 3600 / 60), s % 60)
        }
        # A JSON string, built a character at a time because gsub reads backslashes in its
        # replacement differently in each awk.
        function jstr(s,   i, ch, out) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                ch = substr(s, i, 1)
                if (ch == "\\") out = out "\\\\"
                else if (ch == "\"") out = out "\\\""
                else if (ch == "\t") out = out "\\t"
                else if (ch < " ") out = out " "
                else out = out ch
            }
            return "\"" out "\""
        }
        BEGIN { FS = "\t" }
        $1 == "F" { fin = $2; next }
        $1 == "C" { epoch[$2] = $3 + 0; if (!first) first = $2; nc++; clist[nc] = $2; next }
        $1 == "X" { epoch[$2] = $3 + 0; next }
        $1 == "P" { npar[$2]++; par[$2, npar[$2]] = $3; next }
        $1 == "S" {
            k = $2; tl = $5; for (f = 6; f <= NF; f++) tl = tl "\t" $f
            mark[k, $3] = $4; note[k, $3] = tl
            if (!((k, $3) in listed)) { listed[k, $3] = 1; nid[k]++; idat[k, nid[k]] = $3 }
            next
        }
        $1 == "H" { hdr[$2] = $3 }
        # The field in a note that begins it or follows "; ", the last such, as its text. The note is
        # the text after the last " Note: " in the tail, the marker plan tick writes, so step text
        # before it is never read, and a tail with no such marker has no note. "; " is put before
        # the note so the first field is no special case.
        function lastfield(s, key, numeric,   v, out, pre, i, at, off) {
            s = " " s; at = 0; off = 0
            while ((i = index(substr(s, off + 1), " Note: ")) > 0) { at = off + i; off = at }
            if (!at) return ""
            s = substr(s, at + 7); sub(/^[ \t]+/, "", s)
            s = "; " s; pre = "; " key ": "; out = ""
            while ((i = index(s, pre)) > 0) {
                s = substr(s, i + length(pre))
                v = s; sub(/;.*$/, "", v); gsub(/^[ \t]+|[ \t\r]+$/, "", v)
                if (numeric) { if (match(v, /^[0-9]+/)) out = substr(v, 1, RLENGTH) + 0 } else if (v != "") out = v
            }
            return out
        }
        END {
            n = fin
            if (!nid[n]) exit 3
            routing = (hdr[n] == "") ? "inherit (not stated)" : hdr[n]
            for (a = 1; a <= nid[n]; a++) {
                sid = idat[n, a]; t = sid; sub(/\.[0-9]+$/, "", t)
                if (!(t in tseen)) { tseen[t] = 1; torder[++ntask] = t }
                if (mark[n, sid] == " ") { topen[t] = 1; continue }
                # The latest commit at which this step closed: closed there, and open or absent in
                # every parent that has the plan. A merge whose parents already hold the close is
                # not one, so a branch merged later keeps the time of its own commit.
                have = 0; ce = 0
                for (j = 1; j <= nc; j++) {
                    h = clist[j]
                    if (!((h, sid) in mark) || mark[h, sid] == " ") continue
                    closes = 1
                    for (q = 1; q <= npar[h]; q++) {
                        pp = par[h, q]
                        if (((pp, sid) in mark) && mark[pp, sid] != " ") { closes = 0; break }
                    }
                    if (closes && (!have || epoch[h] > ce)) { ce = epoch[h]; have = 1 }
                }
                if (!have) ce = epoch[n]
                if (ce > tclose[t]) tclose[t] = ce
                if (mark[n, sid] != "x") continue
                v = lastfield(note[n, sid], "rounds", 1); if (v != "") trounds[t] = v
                v = lastfield(note[n, sid], "routing", 0); if (v != "") trouting[t] = v
                v = lastfield(note[n, sid], "loop", 0); if (v == "light" || v == "full") tloop[t] = v
            }
            planned = epoch[first]; delivered = ""
            for (a = 1; a <= ntask; a++) {
                t = torder[a]
                if (topen[t]) { open = 1; continue }
                if (delivered == "" || tclose[t] > delivered) delivered = tclose[t]
            }
            if (open) delivered = ""
            lead = (delivered == "") ? "" : sprintf("%.1f", (delivered - planned) / 3600)
            nrw = ENVIRON["RW_N"] + 0; rw = ENVIRON["RW_H"]; sub(/^ /, "", rw)
            if (json) {
                printf "{\"plan\": %s, \"planned\": %s, \"planned_routing\": %s, \"tasks\": [",
                    jstr(rel), jstr(iso(planned)), jstr(routing)
                for (a = 1; a <= ntask; a++) {
                    t = torder[a]
                    printf "%s{\"task\": %s, \"done\": %s, \"rounds\": %s, \"routing\": %s, \"loop\": %s}", (a > 1 ? ", " : ""),
                        jstr(t), (topen[t] ? "null" : jstr(iso(tclose[t]))),
                        (topen[t] || !(t in trounds) ? "null" : trounds[t]),
                        (topen[t] || !(t in trouting) ? "null" : jstr(trouting[t])),
                        (topen[t] || !(t in tloop) ? "null" : jstr(tloop[t]))
                }
                printf "], \"delivered\": %s, \"lead_time_hours\": %s, \"rework\": {\"count\": %d, \"commits\": [",
                    (delivered == "" ? "null" : jstr(iso(delivered))), (lead == "" ? "null" : lead), nrw
                m = split(rw, hh, " ")
                for (a = 1; a <= m; a++) printf "%s%s", (a > 1 ? ", " : ""), jstr(hh[a])
                print "]}}"
                exit 0
            }
            print "planned: " iso(planned)
            print "planned routing: " routing
            for (a = 1; a <= ntask; a++) {
                t = torder[a]
                if (topen[t]) { print "task " t ": open"; continue }
                printf "task %s: done %s, rounds %s, routing %s", t, iso(tclose[t]),
                    ((t in trounds) ? trounds[t] : "unknown"), ((t in trouting) ? trouting[t] : "unknown")
                if (t in tloop) printf ", loop %s", tloop[t]
                printf "\n"
            }
            print "delivered: " (delivered == "" ? "not yet" : iso(delivered))
            print "lead time: " (lead == "" ? "not yet" : lead "h")
            # Held in a variable: busybox awk reads `nrw (` as a call to a function.
            rwtxt = (nrw > 0) ? " (" rw ")" : ""
            print "rework: " nrw rwtxt
        }' <<< "$facts"
    rc=$?
    [ "$rc" -ne 3 ] || plan_unaddressable "$plan"
    return "$rc"
}

# plan_risk [--staged | --range <a>..<b> | <path>...]: which review loop a change gets, decided from
# the project's own hard_block_paths and not from anyone's judgement of the change. It prints each
# changed path that a declared pattern matches, then a last line, `loop: full` or `loop: light`, and
# exits 0 when it decided. Only that last line with that exit is the light loop: every other outcome
# is the full loop, so a caller that cannot run this, or reads anything but `loop: light` and 0,
# reviews more and never less. The exits are 1 for a usage error, 3 when a profile cannot be read
# or python3 is absent, 4 when nothing is staged (or the range changes no file), 6 when git cannot
# be run or this is not a git work tree; none of those prints a `loop:` line.
# THE LIST IS A UNION. hooks/sensitive-guard reads the nearest .keel/profile.json walking up from
# the directory it runs in, which can be any directory, so this matches the changed paths against
# the patterns of every profile the hook could read: the root's as the base has it (HEAD for
# --staged, <a> for --range) and as the working tree has it (the only one for explicit paths, which
# name no commit); every nested */.keel/profile.json tracked at the base, tracked, modified or
# untracked in the working tree (git ls-files --others without --exclude-standard, so the ignored
# too); and the nearest profile above the repository, whatever directory keel runs in. The hook
# stops at the first profile it meets, so from svc, which has its own, it never reads the one above
# the repository, and from the root, which has none, it does: keel walks up from the repository's
# parent as well as from the current directory, by the logical $PWD, symlinks unresolved, as the
# hook does, and by the resolved path, and from the logical parent of the repository where that
# differs. Patterns are used as written and matched against the root-relative paths, as the hook
# matches them, so a nested profile's `src/payments` is the root's src/payments. Any match prints
# the matching paths and `loop: full`. The base is in the union so a change cannot lower its own
# review, and the working tree is in it because the hook reads that.
# Discovery is case-insensitive, as a macOS file system is, so .Keel/Profile.JSON is a profile. A
# change that adds, edits or deletes any such profile, root or nested, is `loop: full` naming it,
# whatever the profiles say, and so is a change to any path whose last component is .keel, in any
# case: a symlink, a submodule or a file of that name.
# Exit 3 is for a profile that was found and cannot be read: not valid JSON, a symlink (a profile
# that is one, or a directory named .keel that is one, tracked at the base or present, dangling or
# not, none of it followed), a profile that is not a plain file at the base or not a regular file in
# the working tree (a FIFO is never opened, since that waits for a writer for ever), a .keel that is
# a submodule (mode 160000), or a hard_block_paths that is not a list of strings. It names it. A
# nested repository named .keel that is untracked is listed by git with a slash, svc/.keel/, and is
# read for the profile.json in it. A match elsewhere is still `loop: full`, since nothing unread can
# make a match less; the exit is for when nothing matched, and a full verdict reached with
# something unread says so in one line on stderr, written before the paths.
# Nothing declared, which is no hard_block_paths key, an empty list or no profile anywhere, is the
# light loop and says so (the `no hard_block_paths declared` line is for when no profile declares a
# list), as decided for the plan this serves: a project with no list has named nothing sensitive.
# Lists that match nothing are light with no such line. Only a missing key or [] is no list. Any
# other value, `{}`, `""`, `false` and `0` included, is a list that cannot be read, exit 3.
# The matching rule is the one in hooks/sensitive-guard (`matches`): a pattern matches a path by
# fnmatch, or everything under it as a directory, so `src/payments` covers `src/payments/fee.sh`. It
# is mirrored here and not shared, because the hook must stay a single file that runs without keel;
# tests/test-plan.sh cuts the hook's rule out at test time and requires the same verdict from both.
# The paths are taken from `git rev-parse --show-toplevel`, so the verdict does not depend on the
# directory keel runs in, except that a profile above the repository which only a symlinked path to
# it passes is read when keel runs through that path. Git names changed paths from the root, and so
# must the paths given on the command line. They are root-relative: an absolute path, one that
# leaves the root with .., or the root itself is a usage error, since none is a name git gives and
# it would read as light.
# The changed paths come from `git diff --no-renames --name-only -z`, the index for --staged (never
# the working tree) and the two commits for --range. --no-renames, because a rename reports only its
# new name otherwise, and a file moved out of a declared directory would read as light. -z, because
# splitting on whitespace tears a name with a space in two. A range git cannot read exits 6, as git
# failing does. A matched path is printed with any control character escaped (\n), and one that
# would begin `loop:` is led by ./, so no path line can read as the verdict.
plan_risk() {
    local mode="" rev="" lo="" hi="" a top paths=() usage
    usage="usage: keel plan risk [--staged | --range <a>..<b> | <path>...]"
    while [ "$#" -gt 0 ]; do
        a="$1"; shift
        case "$a" in
            --staged) [ -z "$mode" ] || die "$usage"; mode="staged" ;;
            --range)
                [ -z "$mode" ] && [ "$#" -gt 0 ] || die "$usage"
                rev="$1"; shift; mode="range"
                case "$rev" in *..*) ;; *) die "$usage" ;; esac
                lo="${rev%%..*}"; hi="${rev#*..}"
                # `a...b` is a different comparison, a name led by - would read as an option, and
                # `a..b..c` is no pair of revisions.
                case "$lo" in ""|-*) die "$usage" ;; esac
                case "$hi" in ""|-*|.*|*..*) die "$usage" ;; esac ;;
            --) while [ "$#" -gt 0 ]; do paths[${#paths[@]}]="$1"; shift; done ;;
            -*) die "unknown option '$a'. Usage: ${usage#usage: }" ;;
            *) paths[${#paths[@]}]="$a" ;;
        esac
    done
    if [ "${#paths[@]}" -gt 0 ]; then
        [ -z "$mode" ] || die "$usage"
        mode="paths"
        for a in "${paths[@]}"; do [ -n "$a" ] || die "$usage"; done
    fi
    [ -n "$mode" ] || mode="staged"
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
    if [ -z "$top" ]; then
        err "git cannot be run here, or this is not a git work tree, so keel cannot tell what \
changed"
        return 6
    fi
    have_python || { err "python3 is absent, so keel cannot read the profile to tell which paths \
are sensitive"; return 3; }
    python3 - "$mode" "$top" "$lo" "$hi" "$usage" \
        ${paths[@]+"${paths[@]}"} <<'PY'
import json, os, posixpath, stat, subprocess, sys, unicodedata
from fnmatch import fnmatch

mode, top, lo, hi, usage = sys.argv[1:6]
given = sys.argv[6:]

def stop(code, msg):
    sys.stderr.write("keel: " + msg + "\n")
    sys.exit(code)

def matches(f, p):
    # The rule of hooks/sensitive-guard, mirrored: a bare directory has to match what is under it.
    p = p.rstrip("/")
    return fnmatch(f, p) or fnmatch(f, p + "/*")

def esc(s):
    # No control character, and no line or paragraph break, reaches the output as itself.
    short = {"\n": "\\n", "\r": "\\r", "\t": "\\t"}
    return "".join(
        short.get(c) or ("\\x%02x" % ord(c) if ord(c) < 256 else "\\u%04x" % ord(c))
        if unicodedata.category(c) in ("Cc", "Cs", "Zl", "Zp") else c for c in s)

def show(f):
    # Git never names a path with a leading ./, so the prefix cannot be taken for a real one.
    f = esc(f)
    return "./" + f if f.startswith("loop:") else f

def git(*args):
    try:
        return subprocess.run(["git", "-C", top] + list(args), capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        stop(6, "git could not be run, so keel cannot tell what changed")

def why(r):
    # Git's own first line, when it said one: nothing, rather than a bare colon, when it did not.
    line = r.stderr.decode("utf-8", "replace").strip().split("\n")[0]
    return ": " + line if line else ""

def names(*args):
    r = git("diff", "--no-renames", "--name-only", "-z", *args)
    if r.returncode != 0:
        stop(6, "git diff failed, so keel cannot tell what changed" + why(r))
    return [f for f in r.stdout.decode("utf-8", "replace").split("\0") if f]

def head_unborn():
    # True on a branch with no commit yet, which has no profile; other trouble reading HEAD stops.
    if git("rev-parse", "--verify", "--quiet", "HEAD").returncode == 0:
        return False
    s = git("symbolic-ref", "--quiet", "HEAD")
    if s.returncode == 0 and git("show-ref", "--verify", "--quiet",
                                 s.stdout.decode("utf-8", "replace").strip()).returncode != 0:
        return True
    stop(6, "git cannot read HEAD, so keel cannot read the profile as it has it")

if mode == "paths":
    # Normalised, so ./src//payments/x is src/payments/x, which is how git would name it. Paths are
    # root-relative: one that is absolute, leaves the root or is the root names nothing git does.
    changed = []
    for p in given:
        n = posixpath.normpath(p)
        if p.startswith("/") or n in (".", "..") or n.startswith("../"):
            stop(1, "a path is named from the repository root, so it cannot be absolute, leave "
                 "the root or be the root. " + usage)
        changed.append(n)
elif mode == "range":
    changed = names(lo, hi, "--")
    if not changed:
        stop(4, "the range %s..%s changes no file, so there is nothing to decide a loop from" %
             (esc(lo), esc(hi)))
else:
    changed = names("--cached")
    if not changed:
        stop(4, "nothing is staged, so there is nothing to decide a loop from: stage the change "
             "first")

# A change to a profile, at the root or below it, in any case, is never light, whatever the profile
# it leaves says.
def is_profile(path):
    # Case-insensitive, as a macOS file system is: .Keel/Profile.JSON is the file the hook opens.
    parts = path.lower().split("/")
    return len(parts) >= 2 and parts[-2] == ".keel" and parts[-1] == "profile.json"

def is_keel_name(path):
    # The last component, so a nested repository or submodule named .keel, which git lists with a
    # trailing slash when it is untracked, is one too.
    return path.rstrip("/").rsplit("/", 1)[-1].lower() == ".keel"

own = sorted(f for f in changed if is_profile(f) or is_keel_name(f))
if own:
    for f in own:
        print(show(f))
    sys.stdout.flush()
    sys.stderr.write("keel: " + show(own[0]) + " is part of this change, and a change cannot lower "
                     "its own review by editing the list that judges it, so the loop is full\n")
    print("loop: full")
    sys.exit(0)

# The union: every list the hook could read from some directory. An absent profile is no list; one
# that exists in any form and cannot be read is recorded and decides nothing unless nothing else
# does.
lists = []     # the patterns of every profile that read
broken = []    # (where, why) for every one that did not

def take(where, raw):
    try:
        data = json.loads(raw.decode("utf-8"))
    except (ValueError, RecursionError) as e:
        broken.append((where, "is not valid JSON: %s" % e))
        return
    if not isinstance(data, dict):
        broken.append((where, "is not a JSON object"))
        return
    # Only a missing key or [] is no list: {} and "" and false and 0 are lists that cannot be read.
    patterns = data["hard_block_paths"] if "hard_block_paths" in data else []
    if not isinstance(patterns, list) or not all(isinstance(p, str) for p in patterns):
        broken.append((where, "has a hard_block_paths that is not a list of strings"))
        return
    lists.append(patterns)

# The base: the profiles as HEAD has them for --staged (a branch with no commit has none), as <a>
# has them for --range, and none for paths, which name no commit.
unborn = head_unborn() if mode == "staged" else False
base = lo if mode == "range" else (None if mode == "paths" or unborn else "HEAD")
if base is not None:
    r = git("ls-tree", "-r", "-z", base)
    if r.returncode != 0:
        stop(6, "git ls-tree failed, so keel cannot read the profiles as %s has them%s" %
             (esc(base), why(r)))
    for rec in r.stdout.decode("utf-8", "surrogateescape").split("\0"):
        meta, _, path = rec.partition("\t")
        if not path:
            continue
        fmode, _typ, obj = meta.split(" ", 2)
        where = esc(base) + ":" + esc(path)
        # A link is not followed, a profile that is one is not absent, and a `.keel` that is one
        # hides a profile the hook would read. A `.keel` that is a gitlink is a repository whose
        # files this repository does not hold, so it is a profile that cannot be read.
        if is_keel_name(path) and fmode == "120000":
            broken.append((where, "is a symlink, which keel does not follow"))
        elif is_keel_name(path) and fmode == "160000":
            broken.append((where, "is a submodule, whose files keel does not read"))
        elif is_profile(path):
            if fmode not in ("100644", "100755"):
                broken.append((where, "is not a plain file"))
                continue
            b = git("cat-file", "blob", obj)
            if b.returncode != 0:
                broken.append((where, "cannot be read" + why(b)))
            else:
                take(where, b.stdout)

# The working tree: every profile tracked, modified or untracked in it, ignored ones too, since the
# hook opens whatever file is there. --others without --exclude-standard lists the ignored.
real_top = os.path.realpath(top)
seen = set()

def shown(p):
    q = os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))
    return esc(q[len(real_top) + 1:] if q.startswith(real_top + os.sep) else q)

def inside(k):
    # The profile files directly in the directory k, in whatever case. A directory that cannot be
    # listed is tried by name.
    try:
        inner = os.listdir(k)
    except OSError:
        inner = ["profile.json"]
    return [os.path.join(k, m) for m in sorted(inner)
            if m.lower() == "profile.json" and os.path.lexists(os.path.join(k, m))]

def work(p, keel_entry):
    # p is a profile file, or an entry named .keel, in the working tree.
    q = os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))
    if (q, keel_entry) in seen:
        return
    seen.add((q, keel_entry))
    where = shown(p)
    if os.path.islink(p):
        broken.append((where, "is a symlink, which keel does not follow"))
        return
    if keel_entry:
        # A `.keel` that is a directory, as an untracked nested repository is: what the hook
        # reads is the profile inside it.
        for q in inside(p):
            work(q, False)
        return
    try:
        st = os.stat(p)
    except FileNotFoundError:
        return      # tracked, and gone from the working tree: the base has it
    except OSError as e:
        broken.append((where, "cannot be read: %s" % e))
        return
    # Opening a FIFO waits for a writer for ever, so only a regular file is opened.
    if not stat.S_ISREG(st.st_mode):
        broken.append((where, "is not a regular file"))
        return
    try:
        with open(p, "rb") as fh:
            raw = fh.read()
    except FileNotFoundError:
        return      # tracked, and gone from the working tree: the base has it
    except OSError as e:
        broken.append((where, "cannot be read: %s" % e))
        return
    take(where, raw)

entries = []    # (path, index mode or None) for everything git lists in the working tree
for flag in ("--stage", "--others"):
    r = git("ls-files", "-z", flag)
    if r.returncode != 0:
        stop(6, "git could not list the profiles in the working tree, so keel cannot tell which "
             "paths are sensitive" + why(r))
    for rec in r.stdout.decode("utf-8", "surrogateescape").split("\0"):
        meta, tab, path = rec.partition("\t")
        if flag == "--stage" and tab:
            entries.append((path, meta.split(" ", 1)[0]))
        elif flag == "--others" and rec:
            entries.append((rec, None))
for path, fmode in entries:
    # An untracked nested repository is listed with a slash at the end, as svc/.keel/.
    path = path.rstrip("/")
    if is_keel_name(path) and fmode == "160000":
        broken.append((shown(os.path.join(top, path)),
                       "is a submodule, whose files keel does not read"))
    elif is_keel_name(path):
        work(os.path.join(top, path), True)
    elif is_profile(path):
        work(os.path.join(top, path), False)

def forms(d):
    # Every form of a profile directly in <d>: a `.keel` that is a link, or a profile file in a
    # `.keel` directory, in whatever case. A directory that cannot be listed is tried by name.
    out = []
    try:
        names_ = os.listdir(d)
    except OSError:
        names_ = [".keel"]
    for n in sorted(names_):
        if n.lower() != ".keel":
            continue
        k = os.path.join(d, n)
        if os.path.islink(k):
            out.append((k, True))
        elif os.path.isdir(k):
            out.extend((q, False) for q in inside(k))
    return out

def upward(d):
    # The profile hooks/sensitive-guard reads from d: the nearest walking up, which may be above
    # the repository.
    while True:
        found = forms(d)
        if found:
            return found
        up = os.path.dirname(d)
        if up == d:
            return []
        d = up

def starts():
    # Where the hook may start its walk. It starts at its own $PWD, symlinks unresolved, and the
    # walk stops at the first profile, so one in the repository hides what is above it. The hook
    # can run from any directory, so the nearest profile above the repository is read whatever
    # directory keel runs in, by its resolved path and by the logical one, besides the nearest
    # from the directory itself, by either path.
    here = os.getcwd()
    out = []
    logical = os.environ.get("PWD", "")
    try:
        if not logical or not os.path.isabs(logical) or not os.path.samefile(logical, "."):
            logical = ""
    except OSError:
        logical = ""
    if logical:
        out.append(logical)
    out.append(here)
    out.append(os.path.dirname(real_top))
    # The repository's parent by the logical path: the same number of components up from $PWD as
    # the resolved cwd is below the root.
    rel = os.path.relpath(os.path.realpath(here), real_top)
    if logical and not rel.startswith(".."):
        root = logical
        for _ in range(0 if rel == "." else len(rel.split(os.sep))):
            root = os.path.dirname(root)
        try:
            if root != real_top and os.path.samefile(root, real_top):
                out.append(os.path.dirname(root))
        except OSError:
            pass
    return out

for start in starts():
    for p, keel_entry in upward(start):
        work(p, keel_entry)

union = sorted({p for patterns in lists for p in patterns})
hit = sorted({f for f in changed for p in union if matches(f, p)})
if hit:
    if broken:
        # Full anyway, since nothing unread can make a match less, but a reader of the verdict
        # should know a list was not read. Written before the paths, so the last line stays last.
        more = " and %d more" % (len(broken) - 3) if len(broken) > 3 else ""
        sys.stderr.write("keel: " + esc("unreadable profile%s: %s%s; the loop is full on what a "
                                        "readable list matched" % (
            "s" if len(broken) > 1 else "", "; ".join("%s %s" % b for b in broken[:3]), more)) +
            "\n")
        sys.stderr.flush()
    for f in hit:
        print(show(f))
    print("loop: full")
    sys.exit(0)
if broken:
    shown_ = "; ".join("%s %s" % b for b in broken[:3])
    more = " and %d more" % (len(broken) - 3) if len(broken) > 3 else ""
    stop(3, "%s%s, so keel cannot tell which paths are sensitive and the loop cannot be decided" %
         (shown_, more))
if not union:
    print("no hard_block_paths declared")
print("loop: light")
PY
}

# plan_batches <plan> [--json]: the batches a plan's tasks allow, read from the plan and printed so
# that write-plan can declare them and execute-plan can check a declared one. One line per
# scheduling step in plan order, `batch: 1 2` for tasks that may run at the same time and
# `alone: 3` for one that may not, then a `why:` line for each task that could not join the step
# before it, then one `check:` line. Exit 0 when it printed, 1 for a usage error or a missing plan,
# 3 for a plan with no `### Task` heading outside a fence. The command proposes and the plan
# declares: it only reads what a plan says, so it cannot see a Done when that names a neighbour's
# test, or a last step that does not commit, and prints those two conditions as the `check:` line
# every time, which is a reminder to the person approving the plan and never a verdict.
# A task is the text from its `### Task <id>:` heading to the next `### Task` heading or the next
# `## ` heading, so a section after the last task is not read into it. An id is digits then any
# letters (1, 1b, 2A), compared without regard to case, because plans write both and a dependency
# that differs from its heading only in case is still that task. A line inside a fenced block is an
# example, as everywhere in this file, so PLAN_AWK_LIB's fenced() skips it.
# HIDDEN TASKS: a line that opens like a task heading (`#`s, then `task` as a word, in any case,
# after up to three spaces and any `>` quote marks, and with spaces or a tab after the #s, since
# Markdown renders each of those as a heading) but is not `### Task <id>:` exactly at the start of
# the line, such as `### Task 2 - b`, `###<TAB>Task 2: b`, `## Task 2: b`, `### TASK 2: b`,
# `  ### Task 2: b` or `> ### Task 2: b`, or a step whose task (its id before the last dot, as plan
# status reads it) has no such heading, is a task the schedule cannot see. It could edit any file or
# need any task, so a batch beside it could put two agents on one file or run a task before its
# dependency: every task in the plan runs alone, with one `why:` line naming the first such
# heading, else the first such step.
# FILES OUTSIDE A TASK: a Files-like label or list item (as the strict form below defines them)
# after the first task heading but in no task's section, as under a `## ` heading between two tasks
# or after the last, names paths this command cannot give to one task, since it could belong to the
# task above it or below it: every task runs alone, with one `why:` line naming the line. A
# self-review item written `6. **Files:** ...` counts too, which costs that plan its batches and
# never makes one unsafe; the template's self-review writes no such label.
# UNCLOSED FENCE: a fence that never closes hides every line after it, and so any task there, which
# could edit any file and need any task: every task runs alone, with one `why:` line naming the line
# number and text of the line that opens it. It is checked first, since the lines it hides could
# hold any other reason.
# STRICT FORM: a task can join a batch only when its `**Depends on:**` line and its `**Files:**`
# block each fully match a form read exactly as written below, and anything else runs alone with a
# `why:` line. The lines are free text, and a free-text reading misreads some ways of writing them
# into an unsafe batch (a task batched with one it depends on, or two tasks on one file). Running
# alone costs only overlap, never safety, so where the text is in any doubt the task runs alone,
# and write-plan writes these lines itself, so it can write the form.
# `**Depends on:**` is read from the label's own line, after the label, with the spaces around it
# and one trailing `.` removed. What remains is exactly one of: `none`; `task <id>`;
# `tasks <id> and <id>`; `tasks <id>, <id> and <id>` (any number of ids before the `and`, with a
# comma allowed before it once two ids precede it); or `tasks <id> to <id>`, every task between the
# two in plan order, the first above the second, and every task whose number lies between theirs,
# since plans are not always in number order; one of those below the task runs it alone. `task`
# and `tasks` match in any case and the rest exactly, with one space between words, and an id is
# digits then any letters (1, 1b, 2A), compared without regard to case because plans write both.
# Anything else, `none` followed by more text included, is not the form: `tasks 1-2`,
# `tasks 1 (schema) and 2` and `task 1, with row 3` each run alone. A second Depends on line would
# be unread, so it also runs the task alone.
# `**Files:**` is the block from the label to the next blank line, `**Label:**` line or section end,
# and every line in it is one of: the label line with nothing after it; a list item `- <Word>: `
# where Word is Create, Modify, Delete, Test or Rename, optionally followed by a note in parentheses
# before the colon, then backticked paths separated by `, `, with `and` allowed only before the
# last; or an indented line of backticked paths with the same separators, which must continue a line
# that ended on a separator. A path is one token of letters, digits and `._-/@+` that does not start
# or end with `/` and has no empty, `.` or `..` segment, because a space, `:`, `#`, `*`, `?`, `[`,
# `{` or `\` is how a plan writes a note, a line range, a pattern or a place in the file, and each
# read as a path makes one file read as two (a.sh:3, a.sh#x) or a pattern read as a file, and a `./`
# or `//` lets lib/./x.sh hide as a file apart from lib/x.sh. Anything else in the block, prose and
# a Markdown link included, is not the form. Nor is a block that is ambiguous about where it ends: a
# list item, or an indented line that continues the last item as a paragraph, after a blank line but
# before the next label (either may belong to the block), a fenced block there or inside it (its
# paths would go unread), or a list that ends on a separator with nothing to continue it. Nor is a
# task that names paths outside the block: a second Files label, or any other label with `file` or
# `files` as a whole word, in any case (`**Test files:**`, `**Files (tests):**`, `**File:**`, but
# not `**Profile key record:**` or `**Filename:**`, which name no path), quoted or in a list item
# (`> **Files:**`, `- **Files:**`), or a list item opening with exactly Create, Modify, Delete, Test
# or Rename in any case, then `:` or ` (`, anywhere else in the task, quoted or not, since Markdown
# renders each as a label or list item and the batch would not see those paths. The reason for one
# of these, or for a line after the blank line that ends the block, quotes the first such line with
# its number, so the writer can find it. A block with no path counts as no Files block.
# Paths compare without regard to case, because on a case-insensitive file system
# App.tsx and app.tsx are one file and merging two paths can only stop a batch; for the same
# reason a path that holds another (skills/x and skills/x/a.md) is shared with it, since a
# directory written without its trailing `/` is still a legal path.
# SCHEDULING walks the tasks in order and never moves one above a task before it. A task joins the
# current batch when each dependency landed before the batch began, it shares no path with a task
# already in it, and it is batchable; otherwise the batch is closed and the task starts the next
# one, or runs alone. A reason names only the dependencies in the step just closed, since those are
# what held the task back, and the first shared path with the tasks in it that have it.
# UNBATCHABLE tasks run alone, each with its reason, because each is a case where the paths or the
# order are not known, and a batch built on a guess puts two agents on one file:
#   - an id on more than one heading, compared without case: the id names no one task, so neither
#     the task nor a task that depends on that id can be placed, and both run alone.
#   - no Depends on line, one not in the strict form, a range that reaches a task below it, or a
#     dependency on a task the plan does not have above it: the order is unknown, and a task cannot
#     be scheduled before one that is not yet written.
#   - no Files block, or one not in the strict form: the paths are unknown. A directory (ending in
#     `/`) or a pattern is not in the strict form, since skills/x/ and skills/x/a.md compare as
#     different strings and would let two overlapping tasks batch.
#   - shared config: a lockfile or dependency manifest, a lint, format or type config, a CI file,
#     or .keel/profile.json, matched by basename or by path as listed and without regard to case,
#     since the file system may ignore it. Two agents each editing one of these produce two versions
#     of it, whatever else they touch.
# A task gets one reason, the first of those in that order. A task that follows a lone unbatchable
# one is checked against it, since that task is the step before it: a dependency on it, or a path
# shared with it, is the follower's own why, and it starts a new step either way. Only a follower
# with neither (for example a free task after a task with no Depends on line) gets no why, because
# nothing held it back from that step but the lone task being unbatchable, and that reason was
# given with the lone task.
# KNOWN LIMITS: plans in the template's form are read exactly, and a structure the reader cannot
# place runs every task alone. A line-by-line reader cannot be complete against every piece of
# Markdown, so these remain, each outside the template's form: ids compare as strings, so `Task 01`
# and `task 1` are two tasks; a `Depends on:` line inside a blockquote is not read, so with a plain
# one beside it the quoted one is ignored; an HTML comment is read as plain text, so a heading
# inside one is a task and a label sharing a line with `<!--` is not read; a fence inside a
# blockquote, or indented four or more columns in a nested list, is not a fence, so its lines are
# read as plain text; a fence opened on its own line inside a list item ends where this reader takes
# the item to end, which can differ from CommonMark after a lazy line that does not follow a
# paragraph; a closing line indented less than the item's content is read as the fence's closer,
# where CommonMark opens a new fence; and a file named in prose outside a Files block, such as an
# italic `*Files:*` followed by a backticked path, is not read. docs/03 gives the reason each is
# accepted.
# --json prints the same steps, reasons and check as one object, built in awk since python3 may be
# absent, with a reason for the whole plan (a hidden task) under an empty task, and with quotes,
# backslashes and control characters escaped. A hidden heading's reason quotes the heading, which
# may hold any of them, so the escape keeps the object valid.
plan_batches() {
    local plan="" json=0 n=0 a usage check rc
    usage="usage: keel plan batches <plan> [--json]"
    check="in each batch, every Done when names only its task's own test, and each last step commits"
    for a in "$@"; do
        case "$a" in
            --json) json=1 ;;
            -*) die "$usage" ;;
            *) [ "$n" -eq 0 ] || die "$usage"; n=1; plan="$a" ;;
        esac
    done
    [ "$n" -eq 1 ] || die "$usage"
    [ -f "$plan" ] || die "no such plan: $plan"
    # shellcheck disable=SC2016  # $0 is awk's record, not a shell expansion
    awk -v json="$json" -v check="$check" "$PLAN_AWK_LIB"'
        function jesc(s,   i, c, o) {
            o = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\\") o = o "\\\\"
                else if (c == "\"") o = o "\\\""
                else if (c in ctl) o = o sprintf("\\u%04x", ctl[c])
                else o = o c
            }
            return o
        }
        # joinlist(list, n): the n items as "a", "a and b" or "a, b and c".
        function joinlist(list, n,   k, o, sep) {
            o = list[1]
            for (k = 2; k <= n; k++) { sep = (k == n) ? " and " : ", "; o = o sep list[k] }
            return o
        }
        # islabel(s): s is a `**Label:**` line, which ends a Files block.
        function islabel(s) { return s ~ /^[ \t]*\*\*[^*]+:\*\*/ }
        # fileslabel(s), fileitem(s): s is a label with `file` or `files` as a whole word in any
        # case (not `Profile` or `Filename`, which name no path), or a list item
        # opening with Create, Modify, Delete, Test or Rename in any case, after any `>` quote marks
        # and, for the label, a list marker, since Markdown renders each of those as that label or
        # item. Either names paths, which a batch must see. The word counts when no letter follows
        # it and a `:` comes later on the line, or ` (` follows it, since a misplaced backtick or
        # space before the colon still names a path. A longer word (`Tests:`, `Created by:`) is
        # not one of the five, so its item is prose and names none.
        function fileslabel(s) {
            return tolower(s) ~ /^[ \t>]*(([-*+]|[0-9]+[.)])[ \t]+)?\*\*([^*]*[^a-z*])?files?([^a-z*][^*]*)?:\*\*/
        }
        function fileitem(s) {
            s = tolower(s)
            return s ~ /^[ \t>]*([-*+]|[0-9]+[.)])[ \t]+(create|modify|delete|test|rename)(([^a-z][^:]*)?:| \()/
        }
        # isid(s): s is an id, digits then any letters. The letters are tested one by one against
        # ALPHA so that a locale cannot widen a range such as a-z to accented letters. The digits
        # are tested by index too: macOS awk splits a multibyte character with substr, and under a
        # UTF-8 locale a regex match on the lone byte is fatal.
        function isid(s,   i, n) {
            n = length(s); i = 1
            while (i <= n && index("0123456789", substr(s, i, 1))) i++
            if (i == 1) return 0
            for (; i <= n; i++) if (index(ALPHA, substr(s, i, 1)) == 0) return 0
            return 1
        }
        # okpath(tok): tok is one path of the strict form: letters, digits and the marks in PCH, not
        # starting with /, with no empty, . or .. segment (and so no trailing /). Testing the
        # string between slashes finds a leading ./ and a trailing /. as well as /./ and /../.
        function okpath(tok,   i, q) {
            if (tok == "" || substr(tok, 1, 1) == "/") return 0
            for (i = 1; i <= length(tok); i++) if (index(PCH, substr(tok, i, 1)) == 0) return 0
            q = "/" tok "/"
            return !(index(q, "//") || index(q, "/./") || index(q, "/../"))
        }
        function addpath(t, tok,   l) {
            l = tolower(tok)
            if (!((t, l) in pset)) { path[t, ++np[t]] = tok; pset[t, l] = 1 }
        }
        # pathlist(t, r): the backticked paths of one Files line, r being the text from the first
        # backtick. Paths are separated by ", ", and `and` (as " and " or ", and ") may come only
        # before the last, which is also true across a line break: fand records that one has been
        # read, so exactly one path may follow. A line may end on a separator (fpend) only when the
        # next line continues it. Returns 0 when the line is not in the strict form.
        function pathlist(t, r,   j, tok) {
            fpend = 0
            for (;;) {
                if (substr(r, 1, 1) != "`") return 0
                r = substr(r, 2); j = index(r, "`")
                if (j == 0) return 0
                tok = substr(r, 1, j - 1); r = substr(r, j + 1)
                if (!okpath(tok)) return 0
                addpath(t, tok)
                if (fand) return (r == "")
                if (r == "") return 1
                if (r == ",") { fpend = 1; return 1 }
                if (r == " and" || r == ", and") { fand = 1; fpend = 1; return 1 }
                if (substr(r, 1, 6) == ", and ") { fand = 1; r = substr(r, 7) }
                else if (substr(r, 1, 5) == " and ") { fand = 1; r = substr(r, 6) }
                else if (substr(r, 1, 2) == ", ") r = substr(r, 3)
                else return 0
            }
        }
        # fileline(t, s): one line of the Files block of task t. A list item opens a list and ends
        # the one before it, which must not be waiting for a continuation. Any line not in the
        # strict form marks the whole block, since its paths cannot be told from prose.
        function fileline(t, s,   r, w, k, j, note) {
            sub(/[ \t]+$/, "", s)
            if (substr(s, 1, 2) == "- ") {
                if (fpend) fbad[t] = 1
                fpend = 0; fand = 0
                r = substr(s, 3); w = ""
                for (k = 1; k <= 5; k++)
                    if (substr(r, 1, length(FW[k])) == FW[k]) { w = FW[k]; break }
                if (w == "") { fbad[t] = 1; return }
                r = substr(r, length(w) + 1)
                if (substr(r, 1, 2) == " (") {
                    j = index(r, ")")
                    if (j == 0) { fbad[t] = 1; return }
                    note = substr(r, 3, j - 3)
                    if (note == "" || index(note, "(") || index(note, "`")) { fbad[t] = 1; return }
                    r = substr(r, j + 1)
                }
                if (substr(r, 1, 2) != ": ") { fbad[t] = 1; return }
                if (!pathlist(t, substr(r, 3))) fbad[t] = 1
                return
            }
            if (s ~ /^ +`/) {
                if (!fpend || !pathlist(t, substr(s, index(s, "`")))) fbad[t] = 1
                return
            }
            fbad[t] = 1
        }
        # outside(t, s): line s of task t, outside its Files block, may name paths, so the block is
        # not in the strict form. The first such line is kept with its number for the reason, so
        # the writer can find it, unless the block was already spoiled by an earlier line.
        function outside(t, s) {
            if (!fbad[t]) fwhere[t] = " (line " NR ": '"'"'" s "'"'"')"
            fbad[t] = 1
        }
        # endfiles(): the Files block, and the lines after it up to the next label, are over. A list
        # still waiting for a continuation then has none.
        function endfiles() {
            if (infiles && fpend && cur_t) fbad[cur_t] = 1
            infiles = 0; trail = 0; fpend = 0; fand = 0
        }
        function putdep(t, w,   l) {
            l = tolower(w)
            if ((t, l) in dseen) return
            dseen[t, l] = 1; dep[t, ++ndep[t]] = w; dlow[t, ndep[t]] = l
        }
        # numof(id): the number an id opens with, its letters dropped.
        function numof(s) { sub(/[A-Za-z]+$/, "", s); return s + 0 }
        # addrange(t, a, b): every task from a to b in plan order, and every task whose number lies
        # between the numbers of a and b, wherever it sits, since plans are not always in number
        # order and a reader takes `tasks 1 to 3` to mean task 2 too. The first end must be above
        # the second, since a range read backwards is a typo whose meaning is not known. A task in
        # the numbered span that is not above task t cannot be one it waits for, so the range is not
        # known either and sets rbad[t]. A range with an end the plan does not have names both
        # ends, and unbatchable() finds the one that is missing.
        function addrange(t, a, b,   x, y, k, lo, hi, v) {
            if ((tolower(a) in idx) && (tolower(b) in idx)) {
                x = idx[tolower(a)]; y = idx[tolower(b)]
                if (x >= y) { dbad[t] = 1; return }
                for (k = x; k <= y; k++) putdep(t, tid[k])
                lo = numof(a); hi = numof(b)
                for (k = 1; k <= ntask; k++) {
                    v = numof(tid[k])
                    if (v < lo || v > hi) continue
                    if (k >= t) rbad[t] = 1
                    else putdep(t, tid[k])
                }
            } else { putdep(t, a); putdep(t, b) }
        }
        # parsedeps(t): the dependencies of task t from its Depends on text, which must be in the
        # strict form (see plan_batches); any other text sets dbad[t] and adds none.
        function parsedeps(t,   s, n, wd, j, m, ids, tok, comma, lastcomma, rest, k) {
            if (dbad[t]) return
            s = deptext[t]
            sub(/^ +/, "", s); sub(/ +$/, "", s)
            if (substr(s, length(s)) == ".") s = substr(s, 1, length(s) - 1)
            if (s == "none") return
            n = 0; rest = s
            while ((j = index(rest, " ")) > 0) {
                wd[++n] = substr(rest, 1, j - 1); rest = substr(rest, j + 1)
            }
            wd[++n] = rest
            if (n < 2 || (tolower(wd[1]) != "task" && tolower(wd[1]) != "tasks")) {
                dbad[t] = 1; return
            }
            if (tolower(wd[1]) == "task") {
                if (n == 2 && isid(wd[2])) putdep(t, wd[2]); else dbad[t] = 1
                return
            }
            m = 0; lastcomma = 0; j = 2
            while (j <= n && wd[j] != "and" && wd[j] != "to") {
                tok = wd[j]; comma = (substr(tok, length(tok)) == ",")
                if (comma) tok = substr(tok, 1, length(tok) - 1)
                if (!isid(tok)) { dbad[t] = 1; return }
                ids[++m] = tok; lastcomma = comma; j++
                if (!comma) break
            }
            if (m == 0 || j + 1 != n || !isid(wd[n])) { dbad[t] = 1; return }
            if (wd[j] == "and" && !(lastcomma && m < 2)) {
                for (k = 1; k <= m; k++) putdep(t, ids[k])
                putdep(t, wd[n])
            } else if (wd[j] == "to" && m == 1 && !lastcomma) addrange(t, ids[1], wd[n])
            else dbad[t] = 1
        }
        # overlap(p, q): p and q are one path or one holds the other, without regard to case.
        function overlap(p, q,   lp, lq) {
            lp = tolower(p); lq = tolower(q)
            return (lp == lq || index(lq, lp "/") == 1 || index(lp, lq "/") == 1)
        }
        function isconfig(p,   n, parts, b) {
            p = tolower(p)
            n = split(p, parts, "/"); b = parts[n]
            if (index(b, " ") == 0 && index(CFG, " " b " ")) return 1
            if (b ~ /^requirements.*\.txt$/ || b ~ /^\.eslintrc/ || b ~ /^eslint\.config\./ ||
                b ~ /^\.prettierrc/ || b ~ /^prettier\.config\./ || b ~ /^\.golangci\./ ||
                b ~ /^tsconfig.*\.json$/) return 1
            p = "/" p
            return (p ~ /\/\.github\/workflows\// || p ~ /\/\.circleci\// ||
                    p ~ /\/\.keel\/profile\.json$/)
        }
        # unbatchable(t): why task t must run alone, or "" when it may be batched.
        function unbatchable(t,   k, d, me) {
            me = "task " tid[t]
            if (idcount[tolower(tid[t])] > 1)
                return me " shares its id with another task, so its dependents cannot be placed"
            if (!hasdep[t]) return me " has no Depends on line, so its order is unknown"
            if (dbad[t])
                return me " has a Depends on line not in the strict form, so its order is unknown"
            if (rbad[t])
                return me " has a range that reaches a task below it, so its order is unknown"
            for (k = 1; k <= ndep[t]; k++) {
                d = dlow[t, k]
                if ((d in idcount) && idcount[d] > 1) {
                    d = ", which more than one task has as its id, so its order is unknown"
                    return me " depends on task " dep[t, k] d
                }
                if (!(d in idx) || idx[d] >= t)
                    return me " depends on task " dep[t, k] ", which this plan does not have above it"
            }
            if (fbad[t]) {
                d = " has a Files block not in the strict form, so its paths are unknown"
                return me d fwhere[t]
            }
            if (np[t] == 0) return me " has no Files block, so its paths are unknown"
            for (k = 1; k <= np[t]; k++)
                if (isconfig(path[t, k])) return me " edits shared config " path[t, k]
            return ""
        }
        # flush(): close the current batch as one step.
        function flush(   k) {
            if (ncur == 0) return
            nstep++; scount[nstep] = ncur
            for (k = 1; k <= ncur; k++) smem[nstep, k] = cur[k]
            ncur = 0
        }
        # blocked(t): why task t cannot join the current batch, or "".
        function blocked(t,   k, m, o, isdep, list, n, p, found, nf, shown) {
            for (k = 1; k <= ndep[t]; k++) isdep[idx[dlow[t, k]]] = 1
            n = 0
            for (m = 1; m <= ncur; m++) if (cur[m] in isdep) list[++n] = "task " tid[cur[m]]
            if (n > 0) return "task " tid[t] " depends on " joinlist(list, n)
            # A shared path is named by the shorter of the two, which holds the other.
            for (k = 1; k <= np[t]; k++) {
                p = path[t, k]; nf = 0; shown = p
                for (m = 1; m <= ncur; m++)
                    for (o = 1; o <= np[cur[m]]; o++)
                        if (overlap(p, path[cur[m], o])) {
                            found[++nf] = "task " tid[cur[m]]
                            if (length(path[cur[m], o]) < length(shown)) shown = path[cur[m], o]
                            break
                        }
                if (nf > 0) return "task " tid[t] " shares " shown " with " joinlist(found, nf)
            }
            return ""
        }
        BEGIN {
            for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = i
            # Lower case, because isconfig() lowers the name it tests.
            CFG = " package-lock.json pnpm-lock.yaml yarn.lock package.json cargo.lock cargo.toml"
            CFG = CFG " go.mod go.sum poetry.lock uv.lock pyproject.toml gemfile gemfile.lock"
            CFG = CFG " composer.json composer.lock pubspec.yaml pubspec.lock biome.json ruff.toml"
            CFG = CFG " .ruff.toml .editorconfig rustfmt.toml .rubocop.yml .gitlab-ci.yml"
            CFG = CFG " jenkinsfile azure-pipelines.yml bitbucket-pipelines.yml "
            ALPHA = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            PCH = ALPHA "0123456789._-/@+"
            FW[1] = "Create"; FW[2] = "Modify"; FW[3] = "Delete"; FW[4] = "Test"; FW[5] = "Rename"
        }
        { line = $0; sub(/\r$/, "", line) }
        # A fence inside the Files block, or between it and the next label, hides lines from this
        # reading, so any path in it would go unread: the block is not in the strict form.
        # The line that opens a fence is kept, so a fence that never closes can be named (see END).
        # A fence after the blank line that ends the block is quoted in the reason, as any other
        # line there is, so the writer can find it.
        fenced($0) {
            if (fline == NR) fopen = line
            if (trail) outside(cur_t, line); else if (infiles) fbad[cur_t] = 1
            next
        }
        # A step names its task by the number before its last dot, as plan status reads it. A task
        # with a step and no heading read below is one the schedule cannot see (see END).
        step($0) {
            t0 = sid; sub(/\.[0-9]+$/, "", t0)
            if (!(tolower(t0) in steptask)) {
                steptask[tolower(t0)] = 1; stask[++nst] = t0; sfirst[nst] = sid
            }
        }
        # A line that opens like a task heading but is not one read below hides a task. It is
        # matched in any case, after up to three spaces and any `>` quote marks, and with spaces or
        # a tab after the #s, since Markdown renders each of those as a heading, and a task heading
        # this reader misses is one the schedule cannot see.
        {
            h = tolower(line)
            for (;;) {
                sub(/^(   |  | )/, "", h)
                if (substr(h, 1, 1) != ">") break
                h = substr(h, 2)
            }
        }
        h ~ /^#+[ \t]*task([^a-z0-9_]|$)/ && line !~ /^### Task [0-9]+[A-Za-z]*:/ {
            if (unread == "") unread = line
        }
        line ~ /^###[ \t]+Task/ || line ~ /^##[ \t]/ { endfiles(); cur_t = 0 }
        line ~ /^### Task [0-9]+[A-Za-z]*:/ {
            ntask++; cur_t = ntask
            tid[ntask] = substr(line, 10, index(substr(line, 10), ":") - 1)
            if (!(tolower(tid[ntask]) in idx)) idx[tolower(tid[ntask])] = ntask
            idcount[tolower(tid[ntask])]++
            next
        }
        # A Files line after the first task heading but in no task, as under a `## ` heading between
        # two tasks, names paths this reader cannot give to one task (see END).
        cur_t == 0 {
            if (ntask && orphan == "" && (fileslabel(line) || fileitem(line))) orphan = line
            next
        }
        # The Files block runs to a blank line or a label; after the blank line, up to the next
        # label, a list item may belong to the block, so it is not in the strict form either.
        infiles || trail {
            if (islabel(line)) endfiles()
            else if (infiles) {
                if (line ~ /^[ \t]*$/) { endfiles(); trail = 1 }
                else fileline(cur_t, line)
                next
            } else {
                # An indented line there continues the last item of the block as a paragraph, so it
                # may hold a path too.
                if (line ~ /^[ \t]*([-*+]|[0-9]+[.)])[ \t]/ || line ~ /^[ \t]+[^ \t]/ ||
                    fileslabel(line)) outside(cur_t, line)
                next
            }
        }
        # A second Files-like label (`**Test files:**`, `**Files (tests):**`), or a Files-like list
        # item outside the Files block, names paths the block does not, which a batch would not
        # see, so the task runs alone.
        fileslabel(line) && line !~ /^[ \t]*\*\*Files:\*\*/ { outside(cur_t, line) }
        fileitem(line) { outside(cur_t, line) }
        line ~ /^[ \t]*\*\*Depends on:\*\*/ {
            if (hasdep[cur_t]) dbad[cur_t] = 1
            else {
                hasdep[cur_t] = 1; t0 = line; sub(/^[ \t]*\*\*Depends on:\*\*/, "", t0)
                deptext[cur_t] = t0
            }
            next
        }
        line ~ /^[ \t]*\*\*Files:\*\*/ {
            if (seenfiles[cur_t]) outside(cur_t, line)
            seenfiles[cur_t] = 1; infiles = 1; trail = 0; fpend = 0; fand = 0
            t0 = line; sub(/^[ \t]*\*\*Files:\*\*/, "", t0)
            if (t0 !~ /^[ \t]*$/) fbad[cur_t] = 1
        }
        END {
            if (ntask == 0) exit 3
            endfiles()
            # A task the schedule cannot see, behind a heading it does not read or with steps and
            # no heading, could edit any file and depend on any task, so no batch is safe: every
            # task runs alone, under one reason for the whole plan, which has no task of its own.
            wide = ""
            # A fence that never closes hides every line after it, and so any task there, which
            # could edit any file and need any task, so no batch is safe.
            if (infence) {
                wide = "the fence opened at line " fline ", '"'"'" fopen "'"'"', never closes, so"
                wide = wide " every task runs alone, since a task it hides could run out of order"
            } else if (unread != "")
                wide = "the heading '"'"'" unread "'"'"' is not one this command reads"
            else
                for (k = 1; k <= nst; k++)
                    if (!(tolower(stask[k]) in idx)) {
                        wide = "step " sfirst[k] " names task " stask[k]
                        wide = wide ", which has no heading this command reads"
                        break
                    }
            if (wide != "" && !infence) {
                wide = wide ", so every task runs alone, since a task it cannot see could run"
                wide = wide " out of order"
            } else if (wide == "" && orphan != "") {
                # A Files line in no task could belong to any task near it, so no batch is safe.
                wide = "the line '"'"'" orphan "'"'"' names files outside any task, so every task"
                wide = wide " runs alone, since this command cannot tell which task it belongs to"
            }
            if (wide != "") {
                for (t = 1; t <= ntask; t++) { cur[++ncur] = t; flush() }
                nwhy = 1; wtask[1] = ""; wtext[1] = wide
                ntask = 0   # so nothing below parses or schedules a task
            }
            for (t = 1; t <= ntask; t++) {
                parsedeps(t)
                # A block not in the strict form names no paths, whatever it held up to the line
                # that spoiled it, so a task after it is never held back by a half-read block.
                if (fbad[t]) np[t] = 0
            }
            for (t = 1; t <= ntask; t++) {
                r = unbatchable(t)
                if (r != "") {
                    flush(); cur[++ncur] = t; flush(); prevlone = t
                    nwhy++; wtask[nwhy] = tid[t]; wtext[nwhy] = r
                    continue
                }
                # Straight after a lone unbatchable task the current batch is empty, but the step
                # before this task is that lone task, so it is checked against it.
                if (ncur == 0 && prevlone) { cur[1] = prevlone; ncur = 1; r = blocked(t); ncur = 0 }
                else r = blocked(t)
                if (r != "") { flush(); nwhy++; wtask[nwhy] = tid[t]; wtext[nwhy] = r }
                prevlone = 0
                cur[++ncur] = t
            }
            flush()
            if (json) {
                out = "{\"steps\": ["
                for (s = 1; s <= nstep; s++) {
                    if (s > 1) out = out ", "
                    if (scount[s] == 1) out = out "{\"alone\": \"" jesc(tid[smem[s, 1]]) "\"}"
                    else {
                        out = out "{\"batch\": ["
                        for (k = 1; k <= scount[s]; k++) {
                            sep = (k > 1) ? ", " : ""
                            out = out sep "\"" jesc(tid[smem[s, k]]) "\""
                        }
                        out = out "]}"
                    }
                }
                out = out "], \"why\": ["
                for (w = 1; w <= nwhy; w++) {
                    sep = (w > 1) ? ", " : ""
                    out = out sep "{\"task\": \"" jesc(wtask[w]) "\", \"reason\": \""
                    out = out jesc(wtext[w]) "\"}"
                }
                print out "], \"check\": \"" jesc(check) "\"}"
                exit 0
            }
            for (s = 1; s <= nstep; s++) {
                if (scount[s] == 1) print "alone: " tid[smem[s, 1]]
                else {
                    out = "batch:"
                    for (k = 1; k <= scount[s]; k++) out = out " " tid[smem[s, k]]
                    print out
                }
            }
            for (w = 1; w <= nwhy; w++) print "why: " wtext[w]
            print "check: " check
        }' "$plan"
    rc=$?
    [ "$rc" -ne 3 ] || err "$plan has no ### Task heading outside a fenced block, so it has no batches"
    return "$rc"
}

# plan_lock <plan>: holds <plan>.lock until plan_unlock, so two ticks on one plan cannot each
# read it before the other writes and drop one's change, which a concurrent batch's ticks otherwise
# do. mkdir is the lock because it is atomic on every filesystem keel runs on and needs no flock,
# which macOS lacks. It waits about ten seconds, then fails naming the lock, because a tick killed
# with SIGKILL leaves it behind and nothing else would say so. A mkdir that fails with no lock
# present is retried once, since a lock released between the failed mkdir and the check is not an
# error; if that fails with still no lock, as in a directory it cannot write, it fails at once.
plan_lock() {
    local n=0
    until mkdir "$1.lock" 2>/dev/null; do
        if [ ! -e "$1.lock" ]; then
            mkdir "$1.lock" 2>/dev/null && break
            [ -e "$1.lock" ] || die "cannot create $1.lock, so the plan cannot be locked: check its \
directory is writable"
        fi
        n=$((n + 1))
        [ "$n" -lt 100 ] || die "$1.lock is held by another keel plan tick. If none is running, one was killed: remove $1.lock"
        sleep 0.1
    done
    PLAN_LOCK="$1.lock"
    trap 'rmdir "$PLAN_LOCK" 2>/dev/null' EXIT
    trap 'exit 130' INT TERM
}

# plan_unlock: clears the traps before releasing, because an EXIT trap left set would rmdir the lock
# a second time at exit, by which point another tick may hold it. Planning saw exactly that: 18 of
# 20 concurrent ticks landed until the traps were cleared first.
plan_unlock() {
    trap - EXIT INT TERM
    rmdir "$PLAN_LOCK"
}

# plan_tick <plan> <id> [--note <text> | --defer <reason> | --not-applicable <reason>]: sets one
# step's state and rewrites only its line. Done is the default; a note follows the title as
# ` Note: <text>`, for a step the ticker did not witness. --defer and --not-applicable park the step
# with ` Deferred: <reason>` or ` Not applicable: <reason>` instead, and refuse without a reason,
# since a parked step without one reads as forgotten. A reason must start with a character that is
# not blank, matching what status accepts, so tick never writes a line status then flags. Parking
# replaces anything after the title, a note included, since it no longer describes the step. Ticking
# a parked step done drops its reason, which no longer describes it. Text must be one line, since
# it is written on the step's own line. The rewrite goes through a temporary file, so an awk that
# fails leaves the plan as it was. It is written back with `cat >` rather than `mv`, so the plan
# keeps its mode and a symlinked plan is written through; a failed write is an error, since the plan
# is then unticked or truncated. A CRLF line keeps its CR at the end, after any note or reason. A
# plan with no step ids exits 3; a fence that never closes is reported as such rather than as a plan
# without ids.
plan_tick() {
    local plan="${1:-}" id="${2:-}" opt="${3:-}" text="${4:-}" mark=x tail="" tmp rc
    [ -n "$plan" ] && [ -n "$id" ] && [ "$#" -le 4 ] \
      || die "usage: keel plan tick <plan> <id> [--note <text> | --defer <reason> | --not-applicable <reason>]"
    [ -f "$plan" ] || die "no such plan: $plan"
    case "$text" in *$'\n'*) die "a note or reason must be one line: it is written on the step's own line" ;; esac
    case "$opt" in
        "") ;;
        --note) [ -n "$text" ] || die "--note needs its text"; tail=" Note: $text" ;;
        --defer)
                 case "$text" in
                     ""|[[:space:]]*) die "a reason is required: --defer <reason>" ;;
                 esac
                 mark=-; tail=" Deferred: $text" ;;
        --not-applicable)
                 case "$text" in
                     ""|[[:space:]]*) die "a reason is required: --not-applicable <reason>" ;;
                 esac
                 mark="~"; tail=" Not applicable: $text" ;;
        *) die "unknown option '$opt'. Try --note, --defer or --not-applicable." ;;
    esac
    plan_lock "$plan"
    tmp="$(mktemp)" || die "cannot create a temporary file"
    # ENVIRON rather than awk -v, because -v rewrites backslash escapes: a note holding \t would be
    # written with a tab.
    # shellcheck disable=SC2016  # $0 is awk's record, not a shell expansion
    PLAN_ID="$id" PLAN_MARK="$mark" PLAN_TAIL="$tail" awk "$PLAN_AWK_LIB"'
        BEGIN { id = ENVIRON["PLAN_ID"]; mark = ENVIRON["PLAN_MARK"]; tail = ENVIRON["PLAN_TAIL"] }
        { line[NR] = $0 }
        fenced($0) { next }
        step($0) { nstep++; if (sid == id) { hits++; at = NR; oldtail = stail; title = stitle } }
        END {
            if (!nstep) exit (infence ? 6 : 3)
            if (!hits) exit 4
            if (hits > 1) exit 5
            cr = ""; if (oldtail ~ /\r$/) { cr = "\r"; sub(/\r$/, "", oldtail) }
            if (mark == "x") {
                if (oldtail ~ /^ (Deferred|Not applicable): /) oldtail = ""
                tail = oldtail tail
            }
            line[at] = "- [" mark "] **Step " id ": " title "**" tail cr
            for (i = 1; i <= NR; i++) print line[i]
        }' "$plan" > "$tmp"
    rc=$?
    # A complete copy has the plan's record count and ends in a newline, as awk's print always does:
    # busybox awk exits 0 on a failed write, and copying a short file back would cut the plan.
    if [ "$rc" -eq 0 ] \
       && { [ "$(awk 'END { print NR }' "$tmp")" != "$(awk 'END { print NR }' "$plan")" ] \
            || [ -n "$(tail -c 1 "$tmp")" ]; }; then
        err "could not write the tick: the ticked copy of $plan came out incomplete, so $plan \
is unchanged"
        rc=1
    fi
    case "$rc" in
        0) if ! cat "$tmp" > "$plan"; then
               # The > has already truncated the plan, so the ticked copy is the only whole one and
               # is not removed.
               err "could not write $plan, which may now be truncated; the ticked copy is kept \
at $tmp"
               plan_unlock
               return 1
           fi ;;
        3) plan_unaddressable "$plan" ;;
        6) err "$plan has a fence that never closes, which hides every step after it: see keel \
plan status $plan"; rc=1 ;;
        4) err "no step $id in $plan"; rc=1 ;;
        5) err "step $id appears more than once in $plan, so it names no one step"; rc=1 ;;
    esac
    rm -f "$tmp"
    plan_unlock
    return "$rc"
}

CI_REVIEW_MARK='# installed by `keel ci-review install`. Remove it with `keel ci-review remove`.'
CI_REVIEW_FILE=.github/workflows/keel-review.yml

# True if the workflow exists and keel wrote it. Only the first line counts: a user's own file that
# quotes the mark further down is theirs, and so is a keel file whose first line they replaced.
# A trailing carriage return is ignored, so a checkout that converted the line endings is still
# keel's.
ci_review_is_keels() {
    local first
    [ -f "$CI_REVIEW_FILE" ] || return 1
    first="$(head -n 1 "$CI_REVIEW_FILE")"
    [ "${first%$'\r'}" = "$CI_REVIEW_MARK" ]
}

# The host of a remote URL, lower-cased, from <scheme>://[userinfo@]host[:port]/... for the schemes
# http, https, ssh, git, git+ssh and ssh+git, or from [user@]host:path. Non-zero, printing nothing,
# for any other form, so a URL this does not understand is never taken for a host: a local path (a
# '/' before the first ':'), the remote-helper form <transport>::<address>, and a host holding '['
# or ']', which covers an IPv6 literal and git's [host:port]:path, do not parse and so are never
# refused. In the [user@]host:path form the brackets are looked for before the user is stripped, so
# [git@gitlab.com:22]:path does not parse as gitlab.com. The whole URL is lower-cased first. For a
# scheme URL the authority ends at the first '/', '?' or '#', as git ends it, and the host follows
# the last '@' inside it. A port and one trailing dot are dropped. Only the host is printed, never
# the userinfo.
ci_review_origin_host() {
    local url host
    url="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    # git reads <transport>::<address> as a remote helper, naming the transport as a URL scheme.
    [[ "$url" =~ ^[a-z][a-z0-9+.-]*:: ]] && return 1
    case "$url" in
        http://*|https://*|ssh://*|git://*|git+ssh://*|ssh+git://*)
            host="${url#*://}"; host="${host%%[/?#]*}"; host="${host##*@}" ;;
        *://*) return 1 ;;
        *:*) host="${url%%:*}"; case "$host" in */*|*[][]*) return 1 ;; esac; host="${host##*@}" ;;
        *) return 1 ;;
    esac
    case "$host" in *[][]*) return 1 ;; esac
    host="${host%%:*}"; host="${host%.}"
    [ -n "$host" ] || return 1
    printf '%s' "$host"
}

# Prints <n>|<fact> and returns 0 when review in CI should not be installed here, or prints nothing
# and returns 1. <n> is the rule that fired: 1 for another CI's file with no GitHub workflow, 2 for
# an origin on a host known not to be GitHub. <fact> is a lower-case clause with no consequence and
# no full stop; each caller adds the consequence that fits it. Rule 1 is checked first. Runs from
# the repository root. A workflow on a platform that never runs it is a dead file that says review
# in CI is on, and "a second CI system is the worst outcome" (docs/03-install-and-distribution.md),
# so a repository whose CI is another system, or whose origin is on a host known not to be GitHub,
# gets nothing. keel's own workflow does not count as GitHub Actions being in use, or an install
# from before the marker was added would vouch for itself; a user's file of the same name does.
# Any other host is let through, because GitHub Enterprise runs on hosts of any name, and
# self-hosted Azure DevOps Server cannot be told from its name.
ci_review_elsewhere() {
    local pair url host mine=''
    # An empty name matches no file, so unless keel's own file is there nothing is left out.
    ci_review_is_keels && mine="${CI_REVIEW_FILE##*/}"
    if [ -z "$(find .github/workflows -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) \
                 ! -name "$mine" -print -quit 2>/dev/null)" ]; then
        for pair in $CI_MARKER_PAIRS; do
            if [ -f "${pair%%:*}" ]; then
                printf "1|this repository's CI is %s (%s) and it has no GitHub workflow" \
                    "${pair##*:}" "${pair%%:*}"
                return 0
            fi
        done
    fi
    url="$(git remote get-url origin 2>/dev/null)" || return 1
    host="$(ci_review_origin_host "$url")" || return 1
    case "$host" in
        dev.azure.com|*.dev.azure.com|*.visualstudio.com|*gitlab*|*bitbucket*)
            printf "2|this repository's origin is on %s" "$host"
            return 0 ;;
    esac
    return 1
}

# Writes the workflow from the template, swapping in the oauth secret when $1 is 1. Non-zero when
# any step fails. This script runs without set -e, so an unchecked mkdir, cp or redirect would let
# `install` report a file it did not write.
ci_review_write() {
    mkdir -p .github/workflows || return 1
    if [ "$1" -eq 1 ]; then
        sed 's/anthropic_api_key: .*/claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}/' \
            "$HERE/templates/ci-review.yml" > "$CI_REVIEW_FILE" || return 1
    else
        cp "$HERE/templates/ci-review.yml" "$CI_REVIEW_FILE" || return 1
    fi
}

# Review in CI is opt-in and the workflow file is the switch (docs/ideas/
# harness-held-dispatch-guarantees.md item 4), so there is nothing to read, validate or sync. A
# workflow that is not keel's is never overwritten or removed. GitHub reads workflows only from the
# repository root, so the command works there from any directory and refuses a bare repository.
cmd_ci_review() {
    local top sub
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git work tree."
    cd "$top" || die "cannot enter $top."
    sub="${1:-status}"; [ $# -gt 0 ] && shift
    case "$sub" in
        install)
            local oauth=0 a rewrote=0 reason
            for a in "$@"; do
                case "$a" in
                    --oauth) oauth=1 ;;
                    *) die "unknown option '$a'. Usage: keel ci-review install [--oauth]" ;;
                esac
            done
            if reason="$(ci_review_elsewhere)"; then
                case "$reason" in
                    1\|*) die "${reason#*|}. keel does not add a second CI system, so it wrote nothing." ;;
                    *) die "review in CI runs only on GitHub Actions, and ${reason#*|}, where its workflow would never run. keel wrote nothing." ;;
                esac
            fi
            if [ -e "$CI_REVIEW_FILE" ] && ! ci_review_is_keels; then
                die "$CI_REVIEW_FILE exists and keel did not write it. Rename it or merge by hand; keel will not overwrite it."
            fi
            [ -f "$HERE/templates/ci-review.yml" ] || die "templates/ci-review.yml is missing from this keel install."
            ci_review_is_keels && rewrote=1
            ci_review_write "$oauth" || die "could not write $CI_REVIEW_FILE"
            if [ "$rewrote" -eq 1 ]; then
                say "rewrote $CI_REVIEW_FILE. Local edits to it are replaced."
            else
                say "wrote $CI_REVIEW_FILE. Review in CI is on for this repository once the file is merged."
            fi
            if [ "$oauth" -eq 1 ]; then
                say "it reads the repository secret CLAUDE_CODE_OAUTH_TOKEN (claude setup-token). keel does not set it."
            else
                say "it reads the repository secret ANTHROPIC_API_KEY. keel does not set it."
            fi
            say "it also needs the Claude GitHub App (https://github.com/apps/claude) and a project that has run 'keel init'"
            say "each pull request opened, made ready or reopened costs one Claude session"
            say "the file is not committed: read it, commit it and push it"
            say "turn it off with 'keel ci-review remove', or delete the file"
            ;;
        remove)
            if [ ! -e "$CI_REVIEW_FILE" ]; then
                say "review in CI: already off, no $CI_REVIEW_FILE"
            elif ci_review_is_keels; then
                rm -f "$CI_REVIEW_FILE"
                say "removed $CI_REVIEW_FILE. Commit the deletion to turn review in CI off."
            else
                say "left $CI_REVIEW_FILE alone: keel did not write it"
            fi
            ;;
        status)
            local reason='' rule='' fact='' cap=''
            if reason="$(ci_review_elsewhere)"; then
                rule="${reason%%|*}"; fact="${reason#*|}"
                # The fact with its first letter capitalised, for a sentence it starts.
                cap="$(printf '%s' "${fact:0:1}" | tr '[:lower:]' '[:upper:]')${fact:1}"
            fi
            if [ ! -e "$CI_REVIEW_FILE" ] && [ "$rule" = 1 ]; then
                say "review in CI: not available here. $cap, and keel does not add a second CI system."
            elif [ ! -e "$CI_REVIEW_FILE" ] && [ "$rule" = 2 ]; then
                say "review in CI: not available here. It runs only on GitHub Actions, and $fact."
            elif [ ! -e "$CI_REVIEW_FILE" ]; then
                say "review in CI: off. 'keel ci-review install' turns it on"
            elif ci_review_is_keels && [ "$rule" = 1 ]; then
                say "review in CI: $CI_REVIEW_FILE is keel's, and $fact, so it is a second CI system. 'keel ci-review remove' deletes it."
            elif ci_review_is_keels && [ "$rule" = 2 ]; then
                say "review in CI: $CI_REVIEW_FILE is keel's, but $fact, where it would never run. 'keel ci-review remove' deletes it."
            elif ci_review_is_keels; then
                say "review in CI: on, $CI_REVIEW_FILE"
            else
                say "review in CI: $CI_REVIEW_FILE exists and is not keel's"
            fi
            ;;
        *) die "unknown ci-review command '$sub'. Usage: keel ci-review install [--oauth]|remove|status" ;;
    esac
}

case "${1:-}" in
    init)        shift; cmd_init "$@" ;;
    new)         shift; cmd_new "$@" ;;
    doctor)      shift; cmd_doctor "$@" ;;
    profile)     shift; cmd_profile "$@" ;;
    apex-export) shift; cmd_apex_export "$@" ;;
    scan)        shift; cmd_scan "$@" ;;
    guard)       shift; cmd_guard "$@" ;;
    ci-review)   shift; cmd_ci_review "$@" ;;
    plan)        shift; cmd_plan "$@" ;;
    version)     cat "$HERE/VERSION" 2>/dev/null || echo unknown ;;
    ""|-h|--help)
        say "keel <command>"; say ""
        say "  init [-y] [--team]   configure an existing project for keel"
        say "  new <name> [--stack node|python|go|minimal]   create a new project"
        say "  doctor [--fast] [--json]      check this project; non-zero on any problem. --fast checks that the verify commands are set without running them, or --json for one parseable document instead of the printed lines"
        say "  profile get|set <dotted.path> [value]   read or correct one profile field"
        say "  profile sync         record where this project's documents already are"
        say "  apex-export --app <id>   export an Oracle APEX application for porting"
        say "  scan                 supply chain scan of this tree; non-zero on any finding"
        # The pre-push hook `keel guard install` writes reads this help for the words "scan --push"
        # to tell a keel that has it from an older one. Keep them, or every hook installed since reads
        # this keel as too old and scans the working tree.
        say "  scan --push <remote> <commit>   the same scan of a commit being pushed, and of its history's key files"
        say "  scan --leaks <remote> [<object>:<ref>]...   check what a push carries against the deny list"
        say "  scan --leaks-message <file>   check a message or any text file against the deny list"
        say "  guard install [--leak-guard|--no-leak-guard]|status|uninstall   pre-push hook: the scan, and no pushes to the default branch, plus a pre-commit hook that stays off until gates.commit_guard turns it on"
        say "  ci-review install|remove|status   opt in to keel's review on pull requests in GitHub Actions: writes one workflow file, off until you run it"
        say "  plan status <plan>   an implementation plan's steps by state, per task, and the next open step's id"
        say "  plan tick <plan> <id> [--note <text> | --defer <reason> | --not-applicable <reason>]   set one step's state"
        say "  plan report <plan> [--json]   when a plan was planned and delivered, its lead time, and the commits that reworked it, from git"
        say "  plan risk [--staged | --range <a>..<b> | <path>...]   which review loop a change gets, from hard_block_paths: light only when the last line is 'loop: light' and the exit is 0"
        say "  plan batches <plan> [--json]   which of a plan's tasks may run at the same time, from their Depends on and Files lines, and why the rest may not"
        say "  version" ;;
    *) die "unknown command '$1'. Try 'keel --help'." ;;
esac
