# macOS
.DS_Store

# Editor and local agent state
.vscode/
.idea/
.claude/settings.local.json

# Session state written by the context watchdog. It is stale the moment work resumes, and inside a
# committed tree the next `git add -A` sweeps it into a commit. Anything durable in it is promoted to
# an ADR or docs/07-open-decisions.md before it is discarded. `git add -f` covers sharing one.
.keel/handoff.*

# Per-file durations tests/run-tests.sh records to start the longest file first. They describe this
# checkout's machine, so each checkout learns its own.
.keel/test-durations

# Node, once bin/ and tests/ arrive
node_modules/
*.log
# Eval fixtures are synthetic and committed on purpose, the same carve-out tests/fixtures/apex has.
# An incident fixture's log IS the evidence the scenario is scored on, and `*.log` swallowed one
# silently: the working tree had it, every clone did not, and the export gate caught it.
!tests/evals/fixtures/**/*.log

# Build output
dist/
build/

# Python bytecode. lib/ gained two python modules with apex-export.
__pycache__/
*.pyc

# Never commit these. keel handles secrets for other repos; it must not leak its own.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks

# apex-export inputs and intermediates. The targets file holds database passwords; a capture
# directory holds an application's SQL and PL/SQL verbatim, before redaction. tests/fixtures/apex
# is deliberately not covered: it is synthetic and committed on purpose.
.keel/apex-targets.json
apex-capture/
scratchpad/

# NOTE: do not add `docs/` here. The artifact chain reads from the docs root, and a
# gitignored docs root silently breaks every skill downstream of repo-snapshot.
# See docs/03-install-and-distribution.md, "The gitignored-docs trap".

# claude plugin eval writes its reports here
tests/plugin-evals/results/

# docs/audits is a clone of a private repository holding the audits. It is never part of this tree.
docs/audits/

# The mockup engine (lib/mockup-engine). Its checks write their reports into .mockup-engine/ next
# to what they check, and an install may put a browser beside it: neither is source. The app
# scaffold's .env.mocked files are: they hold the mocked build's preview settings, never a secret,
# and every app the scaffold seeds starts from them, so `.env.*` above must not swallow them.
.mockup-engine/
lib/mockup-engine/browsers/
!lib/mockup-engine/templates/app-scaffold/*/.env.mocked
# A mockup engine test fixture: a library's build output, which vendor-library.mjs must be able to
# copy when asked (dist/ above would drop it from every clone).
!lib/mockup-engine/scripts/test/fixtures/vendor-library/lib/dist/
