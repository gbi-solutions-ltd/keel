@@@KEEL-SECTION:processes
{"results": [{"columns": [{"name": "APPLICATION_ID", "type": "VARCHAR2"}, {"name": "PAGE_ID", "type": "VARCHAR2"}, {"name": "PROCESS_ID", "type": "VARCHAR2"}, {"name": "PROCESS_NAME", "type": "VARCHAR2"}, {"name": "PROCESS_TYPE", "type": "VARCHAR2"}, {"name": "PROCESS_POINT", "type": "VARCHAR2"}, {"name": "PROCESS_SOURCE", "type": "VARCHAR2"}], "items": [{"application_id": 100, "page_id": 20, "process_id": 7001, "process_name": "Save Merchant", "process_type": "PL/SQL", "process_point": "After Submit", "process_source": "begin\n  merchant_pkg.save_merchant(\n    p_merchant_id => :P20_MERCHANT_ID,\n    p_legal_name  => :P20_LEGAL_NAME,\n    p_status      => :P20_STATUS,\n    p_iban        => :P20_IBAN);\n\n  update merchants\n     set updated_on = sysdate,\n         updated_by = :APP_USER\n   where merchant_id = :P20_MERCHANT_ID;\n\n  audit_pkg.log_change('MERCHANT', :P20_MERCHANT_ID, :APP_USER);\nexception\n  when others then\n    apex_error.add_error(p_message => sqlerrm, p_display_location => apex_error.c_inline_in_notification);\nend;"}, {"application_id": 100, "page_id": 20, "process_id": 7002, "process_name": "Notify Partner", "process_type": "PL/SQL", "process_point": "After Submit", "process_source": "declare\n  l_response clob;\nbegin\n  apex_web_service.g_request_headers(1).name  := 'Authorization';\n  apex_web_service.g_request_headers(1).value := 'Bearer EXAMPLE-NOT-A-REAL-TOKEN-0123456789abcdef';\n  l_response := apex_web_service.make_rest_request(\n    p_url => 'https://api.partner.example/v1/merchants',\n    p_http_method => 'POST',\n    p_body => merchant_pkg.as_json(:P20_MERCHANT_ID));\n  insert into partner_sync_log(merchant_id, response, created_on)\n  values (:P20_MERCHANT_ID, l_response, systimestamp);\nend;"}, {"application_id": 100, "page_id": 30, "process_id": 7003, "process_name": "Settle Batch", "process_type": "PL/SQL", "process_point": "After Submit", "process_source": "declare\n  l_password varchar2(100) := 'S3ttl3M3nt!2024';\n  cursor c is select settlement_id from settlements where status = 'PENDING' and settled_on >= :P30_FROM;\nbegin\n  for r in c loop\n    settlement_pkg.settle(r.settlement_id, l_password);\n  end loop;\n  commit;\nend;"}]}]}

