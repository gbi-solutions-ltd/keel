unt, p.created_on\n  from payouts p\n where p.merchant_id = :P20_MERCHANT_ID\n order by p.created_on desc\n fetch first 20 rows only", "query_type": null, "is_editable": null, "edit_operations": null, "lost_update_check_type": null}, {"application_id": 100, "page_id": 30, "region_id": 8830, "region_name": "Settlement Grid", "source_type": "Interactive Grid", "display_position": "BODY", "region_source": "select settlement_id, merchant_id, amount, settled_on, status\n  from settlements\n where settled_on >= :P30_FROM", "query_type": null, "is_editable": "Yes", "edit_operations": "i:u:d", "lost_update_check_type": "Values"}]}]}

