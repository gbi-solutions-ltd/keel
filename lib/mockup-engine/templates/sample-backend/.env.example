# Copy to .env (never committed). Ports are published on 127.0.0.1 only.
COMPOSE_PROJECT_NAME=sample-backend
# Three passwords: the superuser (tests and the roles script only), the schema owner, the application.
# Generate each (openssl rand -base64 24); the examples' values are for a laptop, never a server.
POSTGRES_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
DB_PORT=56432
SMTP_PORT=56025
MAIL_UI_PORT=56825
API_PORT=4300
# The app this backend serves (its production build and security headers), relative to here.
APP_DIR=../<app>
# The mockup's pins.clock, so date rules answer as at sign-off; empty for the real time.
CLOCK=
# For npm test from this machine (the db service above):
TEST_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:56432/postgres
# An app with no sign-in screen, over OpenID Connect (skills/convert-mockup/references/sample-backend.md, "Sign-in
# through an identity provider"): set these for the api service (the secret in .env.api), and
# userFromClaims in backend.config.mjs. Unset, dev uses the stand-in sign-in page.
# OIDC_ISSUER=https://idp.example.com/realms/<realm>
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URI=https://<this backend>/auth/callback
