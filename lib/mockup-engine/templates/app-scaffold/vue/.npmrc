# Exact pins, only versions published 14 or more days ago, an LTS Node from the tested lines, and
# no install script that allowScripts in package.json does not name (denied with false, or
# approved pinned to a version). Not ignore-scripts: that would also skip this app's own
# pre-scripts (prebuild generates the API client).
save-exact=true
engine-strict=true
min-release-age=14
strict-allow-scripts=true
