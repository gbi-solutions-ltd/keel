# Server-only settings, read by `next start` (never compiled into the browser bundle).
# The backend for frontend, which this server proxies on the same origin (/api/*).
BACKEND_URL=http://127.0.0.1:4300
# Required. Where a page load without a session is sent; return_to is added. Unset: our error page.
# The stand-in sign-in locally; the identity provider's sign-in anywhere else.
SIGN_IN_URL=/__sample/sign-in
# Local runs against the sample backend only: also proxy its dev routes (/__sample/*). Never set it
# where the server is reachable from another machine (stacks/nextjs.md, Serving and the backend).
PROXY_SAMPLE_ROUTES=1
